#!/usr/bin/env bash
# The gate on what leaves this machine for the public repository
# (github.com/Cluas/moshpit; other remotes pass), installed
# by scripts/setup-hooks.sh (every team member's checkout has it):
#
# - only main goes out (and tags): branches stay local, integrated work
#   reaches main and main is pushed;
# - only as a fast-forward: no force push, ever;
# - only once scripts/oss-scan.py passes on every commit it would publish,
#   with the private lists of the ops checkout (`git config moshpit.opsDir`,
#   else MOSHPIT_OPS, else ../moshpit-ops). The read-only clone
#   setup-hooks.sh makes is fast-forwarded first; if that fails, nothing
#   goes out. MOSHPIT_SCAN_PUBLIC_ONLY=1 runs the public rules alone, for a
#   contributor outside the team; the team never sets it.
#
# git gives the hook its remote and URL as arguments, and one line per ref
# on stdin: <local ref> <local sha> <remote ref> <remote sha>.
set -uo pipefail

remote="${1:-origin}"
url="${2:-}"
# The public repository's gate: a push anywhere else (a fork, an archived
# remote) isn't this gate's to judge.
# GitHub's owner names ignore case, so the match does too.
case "$(printf '%s' "$url" | tr '[:upper:]' '[:lower:]')" in
    *github.com[:/]cluas/moshpit | *github.com[:/]cluas/moshpit.git | *github.com[:/]cluas/moshpit/) ;;
    *) exit 0 ;;
esac
zero=0000000000000000000000000000000000000000
root="$(git rev-parse --show-toplevel)"
scan=(python3 -I "$root/scripts/oss-scan.py")
if [ "${MOSHPIT_SCAN_PUBLIC_ONLY:-}" = 1 ]; then
    scan+=(--public)
else
    # The gate's own copy of the private lists, brought up to date; a
    # person's ops checkout (MOSHPIT_OPS, ../moshpit-ops) is read as it is.
    ops="$(git config --get moshpit.opsDir || true)"
    ops="${ops:-${MOSHPIT_OPS:-$(dirname "$root")/moshpit-ops}}"
    if [ "$(git -C "$ops" config --get moshpit.gateClone 2>/dev/null)" = true ]; then
        # shellcheck disable=SC2046 # one name per word, as unset wants them
        if ! (unset $(git rev-parse --local-env-vars)
            git -C "$ops" fetch -q origin main && git -C "$ops" merge -q --ff-only origin/main) > /dev/null 2>&1; then
            echo "pre-push: couldn't bring the private lists in $ops up to date: nothing goes out" >&2
            exit 1
        fi
    fi
fi
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: not deleting $remote_ref from $remote here" >&2
        status=1
        continue
    fi
    case "$remote_ref" in
        refs/heads/main | refs/tags/*) ;;
        *)
            echo "pre-push: only main goes to $remote, not $remote_ref: branches stay local" >&2
            status=1
            continue
            ;;
    esac
    base=""
    if [ "$remote_sha" != "$zero" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo "pre-push: $remote_ref on $remote isn't an ancestor of what you push: no force push" >&2
            status=1
            continue
        fi
        base="$remote_sha"
    else
        # A new ref (a tag): what it adds to the public main. In a team
        # checkout `origin` is the private repository, so ask the public one.
        public_main="$(git ls-remote "$url" refs/heads/main 2>/dev/null | cut -f1)"
        if [ -n "$public_main" ] && git cat-file -e "$public_main^{commit}" 2>/dev/null; then
            base="$(git merge-base "$public_main" "$local_sha" 2>/dev/null || true)"
        fi
    fi
    if ! "${scan[@]}" ${base:+--base "$base"} --head "$local_sha"; then
        echo "pre-push: $remote_ref refused by the leak scan (above)" >&2
        status=1
    fi
done

exit "$status"
