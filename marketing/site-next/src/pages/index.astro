---
import Marketing from '@layouts/Marketing.astro';
import { ctaPrimary, ctaNote, hasPrimaryCta, RELEASE } from '../release.mjs';

// Raw markup, ported from the redesign mockup (home.linked.html) section by
// section: hero, works, steps, voice, ledger, price. Copy and structure are
// lifted verbatim from the mock EXCEPT where this page has to stay honest
// about things the static mock couldn't know:
//   - the hero's CTA row and price note stay driven by release.mjs, not the
//     mock's href="#" buttons and hard-coded "$6.99 ... beta in review" text
//   - every anchor points at a real site path, never "#"
//   - the price card reads RELEASE.price rather than repeating the literal
//     figure a second time in this file
const body = `<!-- ══ HERO ══ -->
<header class="hero" id="s-home">
  <div class="wrap">
    <div>
      <div class="kicker">ANSWER AGENTS FROM LOCK SCREEN</div>
      <h1>Your agents<br>can <span class="reach">reach you</span><span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">Claude Code hits a permission prompt on your server. Your phone
      lights up. You tap <b>Allow</b> from the lock screen — and it keeps going.
      No unlocking, no SSH, no walking back to your desk.</p>
      <div class="cta-row">
        ${ctaPrimary('en')}
        <a class="cta ${hasPrimaryCta ? 'ghost' : ''}" href="/guide/claude-code">See it end to end</a>
        <a class="ghost" href="/compare">How it compares</a>
      </div>
      <p class="pricenote">${ctaNote('en')}</p>
    </div>

    <div class="lockmock" role="img" aria-label="iPhone lock screen: one agent needs you; Allow and Deny buttons available without unlocking">
      <div class="needs"><span class="dot"></span> 1 NEEDS YOU</div>
      <div class="lockdate" id="lockdate">Sat Jan 1</div>
      <div class="locktime" id="locktime">9:41</div>
      <div class="agentcard">
        <div class="row">
          <span class="who">Claude Code <span class="st">· waiting</span></span>
          <span class="for">6h 50m</span>
        </div>
        <div class="where">mac-studio · 1:claude</div>
        <div class="pills">
          <span class="pill allow">✓ Allow</span>
          <span class="pill deny">✕ Deny</span>
        </div>
        <div class="replies"><span class="reply">yes</span><span class="reply">continue</span></div>
        <div class="second">
          <span class="who">codex <span class="ok">· working</span></span>
          <span class="for">2h 04m</span>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ══ WORKS WITH ══ -->
<section class="works" id="s-agents">
  <div class="wrap">
    <div class="k">WORKS WITH</div>
    <div class="chips">
      <span class="chip"><i></i>Claude Code</span>
      <span class="chip"><i></i>Codex</span>
      <span class="chip"><i></i>opencode</span>
      <span class="chip"><i></i>aider</span>
      <span class="chip"><i></i>Gemini CLI</span>
      <span class="chip any">…anything that runs in a terminal</span>
    </div>
    <p>There is no integration list to be on. Moshpit drives a real shell,
    so an agent it has never heard of works the same day it ships.</p>
  </div>
</section>

<!-- ══ THREE STEPS ══ -->
<section class="steps" id="s-flow">
  <div class="wrap">
    <h2>Three steps, then it's just your terminal.</h2>
    <div class="panes">
      <article class="pane">
        <div class="title"><b>1</b> add-host</div>
        <div class="body">SSH details and a key — or generate one on the phone.
        Pick tmux, herdr, or neither. First connect shows the host fingerprint
        for you to check.</div>
      </article>
      <article class="pane">
        <div class="title"><b>2</b> run-agents</div>
        <div class="body">Start <code>claude</code> in a pane, or let Moshpit open an
        isolated <code>git worktree</code> and hand it the first prompt. Nothing new
        to learn on the host.</div>
      </article>
      <article class="pane">
        <div class="title"><b>3</b> put-the-phone-down</div>
        <div class="body">When an agent needs a human, your lock screen says so —
        with the buttons to answer right there.</div>
      </article>
    </div>
  </div>
</section>

<!-- ══ VOICE ══ -->
<section class="voice" id="s-voice">
  <div class="wrap">
    <div>
      <div class="k">VOICE · ON THIS DEVICE</div>
      <h2>Dictate the prompt, read it, then send it.</h2>
      <p>A mic chip sits on the terminal bar. Speech becomes text in a preview —
      <b>nothing is typed until you tap Insert</b> — and transcription runs
      entirely on the phone. The audio never leaves it. Switch on a local
      Whisper model for ~100 languages, and <b>sentences that don't stay in
      one of them</b>.</p>
    </div>
    <div class="overlay" role="img" aria-label="Dictation overlay: listening, live transcript, Cancel and Insert">
      <div class="head">
        <span class="rec"></span><span class="st">LISTENING</span>
        <span class="bars"><i></i><i></i><i></i><i></i><i></i></span>
      </div>
      <p class="txt">tail the deploy logs and<span class="ghosttxt"> show me only the failures</span></p>
      <div class="acts"><span class="cancel">Cancel</span><span class="insert">⇥ Insert</span></div>
    </div>
  </div>
</section>

<!-- ══ HONEST LEDGER ══ -->
<section class="ledger" id="s-honest">
  <div class="wrap">
    <div class="k">HONEST BY DESIGN</div>
    <div class="tbl-wrap">
      <table class="ledger">
        <thead><tr><th>What</th><th class="us">Answer</th><th>Why</th></tr></thead>
        <tbody>
          <tr><td class="cap-col">Account required</td><td class="us yes">none</td>
              <td>There is nothing to sign up for, so there is nothing to leak.</td></tr>
          <tr><td class="cap-col">Analytics &amp; tracking</td><td class="us yes">zero</td>
              <td>The privacy label reads “Data Not Collected” because none is.</td></tr>
          <tr><td class="cap-col">Your traffic</td><td class="us yes">your servers only</td>
              <td>No relay, no cloud middleman — we don't operate servers at all.</td></tr>
          <tr><td class="cap-col">Dictation audio</td><td class="us yes">never leaves the phone</td>
              <td>Apple's on-device models or a local Whisper one; server recognition is not in the app.</td></tr>
          <tr><td class="cap-col">SSH keys</td><td class="us yes">Secure Enclave</td>
              <td>Generated and stored in the iOS Keychain, Face ID gated.</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ══ PRICE ══ -->
<section class="price" id="s-price">
  <div class="wrap">
    <div class="pricecard" style="margin:0 auto;text-align:left">
      <div><span class="amount">${RELEASE.price}</span><span class="once">ONCE</span></div>
      <p class="pricefine" style="margin-top:14px">No subscription, no in-app purchases.
      The price goes up as the app matures — buying early is the discount.</p>
    </div>
  </div>
</section>`;
---

<Marketing
  title="Moshpit — your agents can reach you"
  description="The iOS terminal for AI coding agents. Approve Claude Code from the lock screen, watch every agent's line status, start isolated tasks from your phone. SSH · Mosh · tmux · herdr. One-time purchase, nothing collected."
  path=""
  lang="en"
  scrollspy={[
    { id: 's-home', label: 'home' },
    { id: 's-agents', label: 'agents' },
    { id: 's-flow', label: 'flow' },
    { id: 's-voice', label: 'voice' },
    { id: 's-honest', label: 'honest' },
    { id: 's-price', label: 'price' },
  ]}
>
  <Fragment set:html={body} />

  <script>
    // The lock screen keeps real time — the one ambient detail that makes the
    // hero mock feel alive. Frozen under prefers-reduced-motion, same as every
    // other animation on this page (see moshpit.css's own blanket rule).
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const t = document.getElementById('locktime');
      const d = document.getElementById('lockdate');
      const tick = () => {
        const now = new Date();
        if (t) {
          t.textContent = now
            .toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
            .replace(/\s?[AP]M/i, '');
        }
        if (d) {
          d.textContent = now.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
        }
      };
      tick();
      setInterval(tick, 15000);
    }
  </script>
</Marketing>
