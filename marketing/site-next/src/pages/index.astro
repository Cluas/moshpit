---
import Marketing from '@layouts/Marketing.astro';
import { ctaPrimary, ctaNote, hasPrimaryCta, RELEASE } from '../release.mjs';

// Raw markup, ported from the redesign mockup (home.linked.html) section by
// section: hero, works, steps, voice, ledger, price. Copy and structure are
// lifted verbatim from the mock EXCEPT where this page has to stay honest
// about things the static mock couldn't know:
//   - the hero's CTA row and price note stay driven by release.mjs, not the
//     mock's href="#" buttons and hard-coded "$6.99 ... beta in review" text
//   - every anchor points at a real site path, never "#"
//   - the price card reads RELEASE.price rather than repeating the literal
//     figure a second time in this file
const body = `<!-- ══ HERO ══ -->
<header class="hero" id="s-home">
  <div class="wrap">
    <div>
      <div class="kicker">ANSWER AGENTS FROM LOCK SCREEN</div>
      <h1>Your agents<br>can <span class="reach">reach you</span></h1>
      <p class="lede">Claude Code hits a permission prompt on your server. Your locked
      phone says so — <b>even with Moshpit closed</b>. The alert travels sealed; only
      your device can read it. One tap lands in the exact pane that asked.
      No walking back to your desk.</p>
      <div class="cta-row">
        ${ctaPrimary('en')}
        <a class="cta ${hasPrimaryCta ? 'ghost' : ''}" href="/guide/claude-code">See it end to end</a>
        <a class="ghost" href="/compare">How it compares</a>
      </div>
      <p class="pricenote">${ctaNote('en')}</p>
    </div>

    <img class="phone lift herolock" src="/20-lockscreen.jpg" width="440" height="956" loading="eager"
         alt="iPhone lock screen: a time-sensitive Moshpit notification — claude needs your permission to use Bash on m1-pro">
  </div>
</header>

<!-- ══ WORKS WITH ══ -->
<section class="works" id="s-agents">
  <div class="wrap">
    <div class="k">WORKS WITH</div>
    <div class="chips">
      <span class="chip"><i></i>Claude Code</span>
      <span class="chip"><i></i>Codex</span>
      <span class="chip"><i></i>opencode</span>
      <span class="chip"><i></i>aider</span>
      <span class="chip"><i></i>Gemini CLI</span>
      <span class="chip any">…anything that runs in a terminal</span>
    </div>
    <p>There is no integration list to be on. Moshpit drives a real shell,
    so an agent it has never heard of works the same day it ships.</p>
  </div>
</section>

<!-- ══ THREE STEPS ══ -->
<section class="steps" id="s-flow">
  <div class="wrap">
    <h2>Three steps, then it's just your terminal.</h2>
    <div class="panes">
      <article class="pane">
        <div class="title"><b>1</b> add-host</div>
        <div class="body">SSH details and a key — or generate one on the phone.
        Pick tmux, herdr, or neither. First connect shows the host fingerprint
        for you to check.</div>
      </article>
      <article class="pane">
        <div class="title"><b>2</b> run-agents</div>
        <div class="body">Start <code>claude</code> in a pane, or let Moshpit open an
        isolated <code>git worktree</code> and hand it the first prompt. Nothing new
        to learn on the host.</div>
      </article>
      <article class="pane">
        <div class="title"><b>3</b> put-the-phone-down</div>
        <div class="body">When an agent needs a human, your lock screen says which
        one wants what — even with the app closed. The tap drops you in the pane
        that asked.</div>
      </article>
    </div>
  </div>
</section>

<!-- ══ PUSH ══ -->
<section class="push" id="s-push">
  <div class="wrap">
    <div>
      <div class="k">PUSH · SEALED ON YOUR HOST</div>
      <h2>The app can be closed. Your phone still knows.</h2>
      <p>The part a suspended iPhone can't do for itself, your dev host does: it
      seals the alert with a key <b>only your device holds</b> and hands the
      ciphertext to Moshpit's push relay. Neither the relay nor Apple can read a
      byte — agent names, commands, the question itself decrypt on your phone,
      on the lock screen. Pairing happens by itself the first time you enable
      notifications on a host. Nothing to configure.</p>
      <p>And no Allow button to press blind, <b>on purpose</b>: approving a
      prompt you haven't read defeats the point of carrying a real terminal.
      The tap lands you in the pane — you read, then you answer.</p>
    </div>
    <div class="quiet" role="list" aria-label="The four rules that keep notifications quiet">
      <div class="qhead">QUIET BY DESIGN</div>
      <div class="qrule" role="listitem"><b>Stands 30 seconds first</b>
        <span>before any phone hears about a question. Answered at your desk means never announced.</span></div>
      <div class="qrule" role="listitem"><b>One card per host</b>
        <span>“claude +2”. Only the moment <i>nobody was waiting → someone is</i> rings; the rest updates silently.</span></div>
      <div class="qrule" role="listitem"><b>Done chimes at 3 min +</b>
        <span>a finished long run earns a sound; a twenty-second answer files into the list without lighting the screen.</span></div>
      <div class="qrule" role="listitem"><b>Parked agents stay silent</b>
        <span>an agent idling at its prompt because you left it there is not asking you anything.</span></div>
    </div>
  </div>
</section>

<!-- ══ SCREENSHOTS ══ -->
<section class="shots" id="s-shots">
  <div class="wrap">
    <div class="k">SEE IT FOR YOURSELF</div>
    <h2>A real terminal, not a demo.</h2>
    <div class="gal">
      <div class="galframes">
        <img class="on" src="/02-agent-terminal.jpg" width="1320" height="2763" loading="lazy" alt="Terminal session with an agent status breadcrumb">
        <img src="/07-tmux-terminal.jpg" width="1320" height="2815" loading="lazy" alt="tmux session rendered natively, with window and pane switching">
        <img src="/06-new-task.jpg" width="1320" height="1466" loading="lazy" alt="New Agent Task sheet: repo, branch, agent and a first message">
        <img src="/20-lockscreen.jpg" width="440" height="956" loading="lazy" alt="iPhone lock screen: a sealed push notification — claude needs your permission, tap to land in the pane">
        <img src="/10-themes.jpg" width="1320" height="2868" loading="lazy" alt="Theme picker: four app themes and several built-in terminal color schemes">
      </div>
      <div class="galtabs" role="tablist">
        <button type="button" aria-selected="true">terminal</button>
        <button type="button" aria-selected="false">tmux</button>
        <button type="button" aria-selected="false">new task</button>
        <button type="button" aria-selected="false">lock screen</button>
        <button type="button" aria-selected="false">themes</button>
      </div>
    </div>
  </div>
</section>

<!-- ══ VOICE ══ -->
<section class="voice" id="s-voice">
  <div class="wrap">
    <div>
      <div class="k">VOICE · ON THIS DEVICE</div>
      <h2>Dictate the prompt, read it, then send it.</h2>
      <p>A mic chip sits on the terminal bar. Speech becomes text in a preview —
      <b>nothing is typed until you tap Insert</b> — and transcription runs
      entirely on the phone. The audio never leaves it. Switch on a local
      Whisper model for ~100 languages, and <b>sentences that don't stay in
      one of them</b>.</p>
    </div>
    <div class="overlay" role="img" aria-label="Dictation overlay: listening, live transcript, Cancel and Insert">
      <div class="head">
        <span class="rec"></span><span class="st">LISTENING</span>
        <span class="bars"><i></i><i></i><i></i><i></i><i></i></span>
      </div>
      <p class="txt">tail the deploy logs and<span class="ghosttxt"> show me only the failures</span></p>
      <div class="acts"><span class="cancel">Cancel</span><span class="insert">⇥ Insert</span></div>
    </div>
  </div>
</section>

<!-- ══ HONEST LEDGER ══ -->
<section class="ledger" id="s-honest">
  <div class="wrap">
    <div class="k">HONEST BY DESIGN</div>
    <div class="tbl-wrap">
      <table class="ledger">
        <thead><tr><th>What</th><th class="us">Answer</th><th>Why</th></tr></thead>
        <tbody>
          <tr><td class="cap-col">Account required</td><td class="us yes">none</td>
              <td>There is nothing to sign up for, so there is nothing to leak.</td></tr>
          <tr><td class="cap-col">Analytics &amp; tracking</td><td class="us yes">zero</td>
              <td>The privacy label reads “Data Not Collected” because none is.</td></tr>
          <tr><td class="cap-col">Terminal traffic</td><td class="us yes">your servers only</td>
              <td>SSH and Mosh connect straight to machines you added. No middlebox.</td></tr>
          <tr><td class="cap-col">Agent alerts</td><td class="us yes">sealed end-to-end</td>
              <td>Pushed as ciphertext only your phone can open — the relay and Apple read none of it.</td></tr>
          <tr><td class="cap-col">Dictation audio</td><td class="us yes">never leaves the phone</td>
              <td>Apple's on-device models or a local Whisper one; server recognition is not in the app.</td></tr>
          <tr><td class="cap-col">SSH keys</td><td class="us yes">Secure Enclave</td>
              <td>Generated and stored in the iOS Keychain, Face ID gated.</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ══ PRICE ══ -->
<section class="price" id="s-price">
  <div class="wrap">
    <div class="pricecard" style="margin:0 auto;text-align:left">
      <div><span class="amount">${RELEASE.price}</span><span class="once">ONCE</span></div>
      <p class="pricefine" style="margin-top:14px">No subscription, no in-app purchases.
      The price goes up as the app matures — buying early is the discount.</p>
      <p class="pricefine" style="margin-top:8px">Available in most regions at launch.
      Mainland China and France aren't included yet, for local policy reasons —
      support for them is planned for later. <a href="/pricing#s-faq">Details</a>.</p>
    </div>
  </div>
</section>`;
---

<Marketing
  title="Moshpit — your agents can reach you"
  description="The iOS terminal for AI coding agents. A sealed push says which agent needs you — even with the app closed — and the tap lands in the pane that asked. SSH · Mosh · tmux · herdr. One-time purchase, nothing collected."
  path=""
  lang="en"
  scrollspy={[
    { id: 's-home', label: 'home' },
    { id: 's-agents', label: 'agents' },
    { id: 's-flow', label: 'flow' },
    { id: 's-push', label: 'push' },
    { id: 's-shots', label: 'shots' },
    { id: 's-voice', label: 'voice' },
    { id: 's-honest', label: 'honest' },
    { id: 's-price', label: 'price' },
  ]}
>
  <Fragment set:html={body} />
</Marketing>
