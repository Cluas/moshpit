---
/**
 * The chrome every marketing page used to carry its own copy of.
 *
 * On the old site the <head>, the nav and the footer were pasted into all 48
 * HTML files. That is what made the rename a 51-file edit and what let the
 * footer keep an Offhook pun ("Off the hook, still on the line.") for two days
 * after the app stopped being called that. One file now owns all of it.
 *
 * Page bodies are still hand-written HTML, deliberately: the hero, the phone
 * galleries and the comparison tables are bespoke design, and re-expressing
 * them as components during a migration would mean changing the markup and the
 * plumbing in one step with no way to tell which broke the layout.
 */
import { RELEASE } from '../release.mjs';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  /** Page path without locale or extension: '' for home, 'compare', 'guide/claude-code'. */
  path?: string;
  lang?: 'en' | 'zh';
  /**
   * Whether a counterpart exists in the other language. Privacy and Support are
   * English-only, and offering the toggle there would link to a 404 and tell
   * search engines about a Chinese page that was never written.
   */
  translated?: boolean;
  /**
   * The bottom scroll-spy status line — a second tmux status line tracking
   * scroll position on a long single page the way the top one tracks which
   * page you're on. Omitted (the default) renders no bar at all and leaves
   * `body` without the reserved bottom padding a fixed bar would need.
   * Index is the "N:" prefix — callers pass id/label only.
   */
  scrollspy?: { id: string; label: string }[];
  /** Overrides the trailing tagline; every sampled mock used the same one. */
  scrollspyTail?: string;
}
const {
  title,
  description,
  path = '',
  lang = 'en',
  translated = true,
  scrollspy,
  scrollspyTail,
} = Astro.props;

const SITE = 'https://moshpit.cluas.eu.org';
const enHref = `/${path}`.replace(/\/$/, '') || '/';
const zhHref = `/zh/${path}`.replace(/\/$/, '');
/** This page's own href in its own language — what a nav entry has to equal to be "current". */
const currentHref = lang === 'zh' ? zhHref : enHref;

// "0:home" leads the list now — see the status-bar block below. Labels are
// lowercase ASCII on the English side to read as real tmux window names; the
// Chinese side keeps the same Chinese labels the old nav and footer already
// used (the ASCII-slug idea is for the scroll-spy's own labels, which mimic a
// literal tmux status line — this row is closer to ordinary site nav).
const nav =
  lang === 'zh'
    ? [
        { href: '/zh', label: '首页' },
        { href: '/zh/docs', label: '文档' },
        { href: '/zh/guides', label: '指南' },
        { href: '/zh/compare', label: '对比' },
        { href: '/zh/pricing', label: '定价' },
      ]
    : [
        { href: '/', label: 'home' },
        { href: '/docs', label: 'docs' },
        { href: '/guides', label: 'guides' },
        { href: '/compare', label: 'compare' },
        { href: '/pricing', label: 'pricing' },
      ];

// The old footer repeated the whole top nav because .top was not
// position:sticky, so it was the only way back to it on a long page. The new
// .status bar IS sticky (top:0) and stays reachable the entire scroll, which
// makes repeating Home/Docs/Guides/Compare/Pricing down here redundant.
const footerNav =
  lang === 'zh'
    ? [
        { href: '/privacy', label: '隐私' },
        { href: '/support', label: '支持' },
      ]
    : [
        { href: '/privacy', label: 'Privacy' },
        { href: '/support', label: 'Support' },
        { href: '/press', label: 'Press' },
      ];

// mosh/tmux/herdr are href="#" placeholders in every mock. Pointing them at
// our own docs (which already cover exactly these three topics) is a working,
// reviewable default; swap for upstream project homepages if that turns out
// to be the intent instead.
const docsRoot = lang === 'zh' ? '/zh/docs' : '/docs';
const toolLinks = [
  { href: `${docsRoot}/mosh`, label: 'mosh' },
  { href: `${docsRoot}/tmux`, label: 'tmux' },
  { href: `${docsRoot}/herdr`, label: 'herdr' },
];

/**
 * The status bar's beta chip. release.mjs's COPY table only serves the hero
 * today, and every mock I have only ever shows the 'review'-stage text
 * ("beta in review" / short "beta") — what this should say once the beta is
 * open or the app is on sale is genuinely undefined upstream. This is a
 * provisional default kept local to this file rather than a change to
 * release.mjs: 'sale' hides the chip outright, since once the app is just
 * live there is nothing left to flag.
 */
function betaCopy(stage: string) {
  if (stage === 'sale') return null;
  if (stage === 'beta') {
    return { full: lang === 'zh' ? '外测开放中' : 'beta open', short: lang === 'zh' ? '外测' : 'beta' };
  }
  // Matches release.mjs's own zh review-stage wording ("外测审核中") verbatim.
  return { full: lang === 'zh' ? '外测审核中' : 'beta in review', short: lang === 'zh' ? '外测' : 'beta' };
}
const beta = betaCopy(RELEASE.stage);

const hasScrollspy = Boolean(scrollspy && scrollspy.length > 0);
const scrollspyTailDefault = lang === 'zh' ? '你的 agent，随时找得到你。' : 'Your agents, reachable.';

// Tokens first, then the component/layout styles that read them — mirrors
// the order astro.config.mjs already uses for the docs side (tokens.css,
// then starlight-bridge.css). Imported, not linked: Astro then hashes and
// minifies it, and — the part that matters — it lands ONLY on pages using
// this layout. The docs deliberately do not get it, because its
// `body`/`.shell`/`.dwrap` layout rules fight Starlight's grid (they put the
// sidebar on top of the prose the first time).
//
// moshpit.css also `@import`s tokens.css itself, which looks redundant with
// the line below — it isn't. See the comment at the top of moshpit.css: with
// only this top-level import, Vite ships marketing pages a stylesheet with
// zero token definitions, because tokens.css is also wired into Starlight's
// customCss and its compiled output gets claimed by the docs-side chunk.
// Keep both.
import '../styles/tokens.css';
import '../styles/moshpit.css';

const legal = '© 2026 Moshpit · SSH · Mosh · tmux · herdr · iPhone';
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/21-lockscreen-card.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#040507" />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="alternate" hreflang="en" href={`${SITE}${enHref}`} />
    {translated && <link rel="alternate" hreflang="zh-Hans" href={`${SITE}${zhHref}`} />}
    <link rel="alternate" hreflang="x-default" href={`${SITE}${enHref}`} />
  </head>
  <body class={hasScrollspy ? 'has-scrollspy' : undefined}>
    <nav class="status" aria-label="Site">
      <div class="wrap">
        <a class="sess" href={lang === 'zh' ? '/zh' : '/'}><Logo />moshpit</a>
        <div class="win">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={n.href === currentHref ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </div>
        <div class="right">
          {beta && (
            <span class="beta">
              <span class="dot" aria-hidden="true"></span>
              <span class="full">{beta.full}</span><span class="short">{beta.short}</span>
            </span>
          )}
          {
            translated &&
              (lang === 'zh' ? (
                <a class="zh" href={enHref} hreflang="en" lang="en">EN</a>
              ) : (
                <a class="zh" href={zhHref} hreflang="zh-Hans" lang="zh-Hans">中文</a>
              ))
          }
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap">
        <span>{legal}</span>
        {footerNav.map((n) => <a href={n.href}>{n.label}</a>)}
        <div class="right">
          {toolLinks.map((t) => <a href={t.href}>{t.label}</a>)}
          <a href="https://github.com/Cluas/moshpit">GitHub</a>
        </div>
      </div>
    </footer>

    {
      hasScrollspy && (
        <nav class="scrollspy" aria-label="Section">
          <div class="wrap">
            {scrollspy!.map((s) => (
              <a href={`#${s.id}`}>{s.label}</a>
            ))}
            <span class="tail">{scrollspyTail ?? scrollspyTailDefault}</span>
          </div>
        </nav>
      )
    }

    <script>
      // Gallery tabs. Deliberately tiny and progressive: the first frame is a
      // plain <img> that shows without any of this, so a failed script costs a
      // tab strip, not the screenshots.
      document.querySelectorAll<HTMLElement>('.gal').forEach((gal) => {
        const frames = gal.querySelectorAll<HTMLElement>('.galframes img');
        const tabs = gal.querySelectorAll<HTMLElement>('.galtabs button');
        tabs.forEach((tab, i) =>
          tab.addEventListener('click', () => {
            frames.forEach((f, j) => f.classList.toggle('on', i === j));
            tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
          }),
        );
      });
    </script>

    <script>
      // Bottom status line tracks which section is on screen — the scroll-axis
      // twin of the top bar's page-axis "which window". Whichever section's
      // TOP has most recently crossed a line just under the top status bar is
      // "current". A no-op on every page without a scroll-spy bar: all three
      // querySelectorAll calls below just return empty lists.
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.scrollspy a'));
      const sections = links.map((a) => document.querySelector(a.getAttribute('href')!));
      function update() {
        const line = 82; // just under the sticky top bar (now 72px + border)
        let active = 0;
        for (let i = 0; i < sections.length; i++) {
          const el = sections[i];
          if (el && el.getBoundingClientRect().top <= line) active = i;
        }
        links.forEach((a, i) => {
          if (i === active) a.setAttribute('data-current', '');
          else a.removeAttribute('data-current');
        });
      }
      if (links.length) {
        document.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
    </script>
  </body>
</html>
