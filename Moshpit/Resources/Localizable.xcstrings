    "Live preview of your input below. Saved shortcuts land in the Custom group of the Shortcuts toolbar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du live, was du unten eingibst. Gesicherte Kurzbefehle landen in der Gruppe „Eigene“ der Kurzbefehl-Leiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa en directo de lo que escribes abajo. Los atajos guardados van al grupo Personalizados de la barra de atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu en direct de ce que vous saisissez ci-dessous. Les raccourcis enregistrés rejoignent le groupe Personnalisés de la barre de raccourcis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の入力をリアルタイムでプレビューします。保存するとショートカットツールバーのカスタムグループに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 입력하는 내용이 바로 여기 표시됩니다. 저장한 단축키는 단축키 도구 막대의 사용자 설정 그룹에 들어갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia ao vivo do que você digita abaixo. Os atalhos salvos vão para o grupo Personalizados da barra de atalhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面怎么填，这里就怎么显示。保存后会出现在快捷键栏的「自定义」分组里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下面怎麼填，這裡就怎麼顯示。儲存後會出現在快速鍵列的「自訂」群組。"
          }
        }
      }
    },
