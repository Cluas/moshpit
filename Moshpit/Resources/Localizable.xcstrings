            "state": "translated",
            "value": "字号"
          }
        }
      }
    },
    "From": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起始"
          }
        }
      }
    },
    "From must be ≤ To.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始は終了以下にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起始值必须 ≤ 结束值。"
          }
        }
      }
    },
    "Generate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成"
          }
        }
      }
    },
    "Generates the key pair on device. The private key can optionally be held in the Secure Enclave — used only for signing, never leaving the chip.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上で鍵ペアを生成します。秘密鍵は Secure Enclave に保管でき、署名時のみ使用され、チップの外には出ません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地生成密钥对。私钥可选 Secure Enclave 托管，仅签名时调用，不出芯片。"
          }
        }
      }
    },
    "HARDWARE KEY": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェアキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件密钥"
          }
        }
      }
    },
    "Hardware": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェア"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件"
          }
        }
      }
    },
    "Hardware-backed keys cannot be exported; every signature triggers Face ID.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェア保護されたキーは書き出せません。署名のたびに Face ID が起動します。"
