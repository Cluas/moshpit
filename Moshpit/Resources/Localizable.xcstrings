    "Automatically appends ⏎ to submit": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信時に自動で ⏎ を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下后自动追加 ⏎ 提交"
          }
        }
      }
    },
    "Available everywhere when nothing is selected. When bound, it appears only in the toolbar of the selected hosts, saving slots in the 12-slot budget.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未選択ならどこでも使えます。バインドすると選択ホストのツールバーにのみ表示され、12 スロットの枠を節約できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不选时全局可用。绑定后仅在所选主机的会话工具条出现，节省 12 个槽位预算。"
          }
        }
      }
    },
    "BEHAVIOR": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行为"
          }
        }
      }
