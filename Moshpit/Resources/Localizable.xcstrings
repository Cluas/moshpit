{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" has uncommitted changes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat nicht committete Änderungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tiene cambios sin confirmar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » contient des modifications non commitées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に未コミットの変更があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"에 커밋하지 않은 변경 사항이 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tem alterações sem commit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 有未提交的改动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」有尚未提交的更動"
          }
        }
      }
    },
