    "Show only while the session runs tmux or herdr": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur anzeigen, solange in der Sitzung tmux oder herdr läuft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solo mientras la sesión ejecuta tmux o herdr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’afficher que lorsque la session exécute tmux ou herdr"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが tmux または herdr を実行中のときのみ表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 tmux나 herdr를 실행 중일 때만 표시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar só enquanto a sessão estiver rodando tmux ou herdr"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当会话在跑 tmux 或 herdr 时显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在工作階段跑著 tmux 或 herdr 時顯示"
          }
        }
      }
    },
    "Showing the latest 500 of %lld. Copy takes them all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuesten 500 von %lld. „Kopieren“ nimmt alle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran las 500 más recientes de %lld. Copiar las incluye todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 500 plus récentes sur %lld. Copier les prend toutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の500件を表示しています（全%lld件）。コピーではすべてを含めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 %lld개 중 최근 500개만 표시합니다. 복사하면 모두 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando as 500 mais recentes de %lld. Copiar leva todas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示最近 500 条，共 %lld 条；复制会带上全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示最近 500 筆，共 %lld 筆；拷貝會帶上全部。"
          }
        }
      }
    },
    "Shows on the host's mark in place of its key's pattern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint im Symbol des Hosts anstelle des Musters aus seinem Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en el icono del host en lugar del patrón de su clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’affiche sur l’icône de l’hôte à la place du motif de sa clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストのアイコンに、ホスト鍵から作った模様の代わりに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 아이콘에 키로 만든 패턴 대신 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no ícone do host no lugar do padrão da chave dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机头像上显示这个表情，不再用主机密钥生成的图案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機頭像上顯示這個表情符號，不再用主機金鑰產生的圖案。"
