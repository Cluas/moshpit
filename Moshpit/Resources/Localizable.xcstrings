    },
    "herdr on the host's PATH is %@, its server %@ — update that copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr im PATH des Hosts ist %1$@, sein Server %2$@ – aktualisiere diese Kopie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El herdr del PATH del host es %1$@ y su servidor, %2$@: actualiza esa copia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le herdr du PATH de l’hôte est en %1$@, son serveur en %2$@ : mettez cette copie à jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストの PATH 上の herdr は %1$@、サーバーは %2$@ です。PATH 上の herdr を更新してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 PATH의 herdr는 %1$@, 서버는 %2$@입니다. PATH의 herdr를 업데이트하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O herdr no PATH do host é %1$@ e o servidor, %2$@ — atualize essa cópia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机 PATH 里的 herdr 是 %1$@，服务是 %2$@，升级 PATH 里那份就好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機 PATH 裡的 herdr 是 %1$@，伺服器是 %2$@，更新 PATH 裡那份就好"
          }
        }
      }
    },
