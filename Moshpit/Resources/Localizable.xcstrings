    "Something broke over there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da drüben ist was kaputt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo falló por allá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a cassé là-bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こうで何か起きたみたい。"
          }
        },
        "ko": {
