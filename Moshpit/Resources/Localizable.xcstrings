          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Vorlage, um den Auslöser zu füllen: tmux-Präfixe, Control-Kombinationen, Sonder- und Navigationstasten, F-Tasten. Passe danach unten Beschriftung und Farbe an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un preajuste para rellenar el disparador: prefijos de tmux, combinaciones con Control, teclas especiales y de navegación, teclas F. Después ajusta abajo la etiqueta y el color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un préréglage pour remplir le déclencheur : préfixes tmux, combinaisons Contrôle, touches spéciales et de navigation, touches F. Ajustez ensuite l’étiquette et la couleur ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットをタップするとトリガーが入力されます——tmux プレフィックス、Control コード、特殊キーと移動キー、F キー。その後、下でチップのラベルと色を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋을 탭하면 트리거가 채워집니다. tmux 접두 키, Control 조합, 특수 키와 방향 키, F 키가 있습니다. 그런 다음 아래에서 칩 레이블과 색상을 다듬으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um preset para preencher o gatilho: prefixos do tmux, combinações com Control, teclas especiais e de navegação, teclas F. Depois ajuste o rótulo e a cor abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一个预设就填好触发键：tmux 前缀、Control 组合、特殊键和方向键、F 键。然后在下面改标签文字和颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一個預設就填好觸發鍵：tmux 前綴、Control 組合、特殊鍵和方向鍵、F 鍵。然後在下面改標籤文字和顏色。"
          }
        }
      }
    },
    "Tap arrows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfeiltasten zum Tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flechas para tocar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flèches à toucher"
          }
        },
        "ja": {
