    "Moshpit": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit"
          }
        }
      }
    },
    "Moshpit needs tmux for session navigation.\nInstall it, then reconnect.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit はセッションナビゲーションに tmux を必要とします。\nインストールしてから再接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit 需要 tmux 来进行会话导航。\n请先安装，然后重新连接。"
          }
        }
      }
    },
    "Moshpit never installs anything silently. Run the command below in your shell — sudo and its output stay fully visible.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit が黙ってインストールすることはありません。以下のコマンドをシェルで実行してください — sudo とその出力はすべて表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit 绝不会静默安装任何内容。请在你的 shell 中运行下面的命令 —— sudo 及其输出全程可见。"
          }
        }
      }
    },
    "Bell = attention": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベル = 要注意"
          }
        },
        "zh-Hans": {
