        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza el script de marcado y lee el panel. No hace falta ejecutar un turno de agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclenche le script de marquage et relit le panneau. Pas besoin de lancer un tour d’agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンプスクリプトを実行してペインを読み戻します。エージェントのターンを実行する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 스크립트를 실행하고 패널을 읽어 옵니다. 에이전트를 직접 돌릴 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispara o script de marcação e lê o painel de volta. Não precisa rodar um turno de agente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接触发标记脚本再读回窗格，不用真跑一轮智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接觸發標記腳本再讀回窗格，不用真的讓智能體跑一輪。"
          }
        }
      }
    },
    "First connection to %@:%@. Verify this fingerprint matches the server before you trust it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Verbindung zu %@:%@. Prüfe, ob dieser Fingerabdruck zum Server passt, bevor du ihm vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera conexión a %@:%@. Comprueba que esta huella coincide con la del servidor antes de confiar en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première connexion à %@:%@. Vérifiez que cette empreinte correspond à celle du serveur avant de lui faire confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ への初回接続です。信頼する前に、このフィンガープリントがサーバーと一致することを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@에 처음 연결합니다. 신뢰하기 전에 이 지문이 서버의 것과 같은지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeira conexão com %@:%@. Confira se esta impressão digital bate com a do servidor antes de confiar nela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次连接 %@:%@。先到服务器上核对指纹，确认一致再信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次連線到 %@:%@。先到伺服器上核對指紋，確認一致再信任。"
          }
        }
      }
    },
    "First connection to %@:%lld.\n\nKey fingerprint:\n%@\n\nVerify it matches the server (e.g. `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Verbindung zu %1$@:%2$lld.\n\nFingerabdruck des Schlüssels:\n%3$@\n\nPrüfe, ob er zum Server passt (z. B. mit `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera conexión a %1$@:%2$lld.\n\nHuella de la clave:\n%3$@\n\nComprueba que coincide con la del servidor (p. ej., `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première connexion à %1$@:%2$lld.\n\nEmpreinte de la clé :\n%3$@\n\nVérifiez qu’elle correspond à celle du serveur (par ex. `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld への初回接続です。\n\nキーのフィンガープリント：\n%3$@\n\nサーバー側と一致するか確認してください（例: `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld에 처음 연결합니다.\n\n키 지문:\n%3$@\n\n서버의 것과 같은지 확인하세요(예: `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeira conexão com %1$@:%2$lld.\n\nImpressão digital da chave:\n%3$@\n\nConfira se ela bate com a do servidor (por exemplo, `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次连接 %1$@:%2$lld。\n\n密钥指纹：\n%3$@\n\n请到服务器上核对一下是否一致（例如 `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次連線到 %1$@:%2$lld。\n\n金鑰指紋：\n%3$@\n\n請到伺服器上核對是否一致（例如 `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        }
      }
    },
