    "Keys in the Android Keystore cannot be exported; every signature is made inside it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel im Android Keystore lassen sich nicht exportieren; jede Signatur entsteht darin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves del Android Keystore no se pueden exportar; cada firma se hace dentro de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés de l’Android Keystore ne peuvent pas être exportées ; chaque signature y est faite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Keystore のキーは書き出せません。署名はすべて Keystore の中で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Keystore에 보관된 키는 내보낼 수 없으며, 모든 서명은 Keystore 안에서 이루어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves no Android Keystore não podem ser exportadas; cada assinatura é feita dentro dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在 Android 密钥库里的密钥导不出来，每次签名都在密钥库里完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存在 Android Keystore 裡的金鑰拿不出來，每次簽章都在 Keystore 裡完成。"
          }
        }
      }
    },
    "Keys stay on the device they were imported on. Import it again or delete this entry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel bleiben auf dem Gerät, auf dem sie importiert wurden. Importiere ihn erneut oder lösche diesen Eintrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves se quedan en el dispositivo donde se importaron. Vuelve a importarla o elimina esta entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés restent sur l'appareil où elles ont été importées. Importez-la de nouveau ou supprimez cette entrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはインポートしたデバイスにだけ残ります。もう一度インポートするか、この項目を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 가져온 기기에만 남아 있습니다. 다시 가져오거나 이 항목을 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves ficam no dispositivo em que foram importadas. Importe-a de novo ou apague este item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥只留在导入它的那台设备上。可以重新导入，或删掉这条记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰只留在匯入它的那台裝置上。可以重新匯入，或刪掉這筆記錄。"
          }
        }
      }
    },
