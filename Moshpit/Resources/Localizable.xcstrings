    "Both run on this device. Your voice is never uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide laufen auf diesem Gerät. Deine Stimme wird nie hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos funcionan en este dispositivo. Tu voz nunca se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux fonctionnent sur cet appareil. Ta voix n’est jamais envoyée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらもこの端末で動作し、音声がアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 이 기기에서 작동하며, 음성은 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois funcionam neste dispositivo. Sua voz nunca é enviada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种都在这台设备上运行，声音不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種都在這部裝置上執行，聲音不會上傳。"
          }
        }
      }
    },
