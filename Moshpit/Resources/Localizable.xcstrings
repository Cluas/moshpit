      }
    },
    "This server has no running %@.\nMoshpit only attaches — create the first one to start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Server laufen keine %@.\nMoshpit hängt sich nur an Bestehendes. Leg zum Start etwas Neues an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no tiene %@ en ejecución.\nMoshpit solo se conecta a lo que ya existe: empieza creando uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’a pas de %@ en cours.\nMoshpit ne fait que se rattacher : commencez par en créer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーで実行中の %@ はありません。\nMoshpit はアタッチのみ行います——まず 1 つ作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에 실행 중인 %@이(가) 없습니다.\nMoshpit은 기존 것에 붙기만 하니, 먼저 하나를 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não tem %@ em execução.\nO Moshpit só se conecta ao que já existe: comece criando um."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器上没有在跑的 %@。\nMoshpit 只连已有的，先新建一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器上沒有執行中的 %@。\nMoshpit 只接已有的，先新建一個。"
          }
        }
      }
    },
    "This server has no running sessions.\nMoshpit only attaches — create the first one to start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Server läuft keine Sitzung.\nMoshpit hängt sich nur an bestehende. Erstelle die erste, um loszulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no tiene sesiones en ejecución.\nMoshpit solo se conecta a las existentes: crea la primera para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’a aucune session en cours.\nMoshpit ne fait que se rattacher : créez la première pour commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーには実行中のセッションがありません。\nMoshpit はアタッチのみ行います — 最初のセッションを作成して始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에 실행 중인 세션이 없습니다.\nMoshpit은 기존 세션에 붙기만 하니, 먼저 하나를 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não tem sessões em execução.\nO Moshpit só se conecta às existentes: crie a primeira para começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器上没有在跑的会话。\nMoshpit 只连已有的会话，先新建一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器上沒有執行中的工作階段。\nMoshpit 只接已有的，先新建一個。"
          }
        }
      }
    },
    "This theme will be removed. Built-in themes are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Farbschema wird entfernt. Integrierte Farbschemata bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema se quitará. Los temas integrados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème sera retiré. Les thèmes intégrés ne sont pas concernés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマを削除します。内蔵テーマには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마가 제거됩니다. 내장 테마는 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema será removido. Os temas integrados não mudam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个主题会被删除。内置主题不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個主題會被移除。內建主題不受影響。"
          }
        }
      }
    },
    "Those changes exist nowhere else. Removing the worktree throws them away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderungen gibt es sonst nirgends. Wird der Worktree entfernt, sind sie weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esos cambios no existen en ningún otro sitio. Si quitas el worktree, se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces modifications n’existent nulle part ailleurs. Retirer le worktree les efface."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの変更は他のどこにも存在しません。ワークツリーを削除すると失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경 사항은 다른 곳에 없습니다. 워크트리를 제거하면 모두 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas alterações não existem em nenhum outro lugar. Remover o worktree joga tudo fora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些改动只存在这里。删掉工作树，它们就没了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些更動只存在這裡。刪掉工作樹，它們就沒了。"
          }
        }
      }
    },
