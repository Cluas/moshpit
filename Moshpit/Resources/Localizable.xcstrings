    "tmux": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux"
          }
        }
