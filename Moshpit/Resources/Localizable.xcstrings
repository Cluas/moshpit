    "ED25519 recommended: 32-byte keys, fast signatures, no practical break to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ED25519 empfohlen: 32-Byte-Schlüssel, schnelle Signaturen, bis heute kein praktischer Angriff bekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda ED25519: claves de 32 bytes, firmas rápidas y sin ataques prácticos conocidos hasta la fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ED25519 recommandé : clés de 32 octets, signatures rapides, aucune attaque pratique connue à ce jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ED25519 推奨：32 バイト鍵で署名が高速、現時点で実用的な攻撃は知られていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ED25519 권장: 32바이트 키, 빠른 서명, 지금까지 실질적인 공격 사례 없음."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ED25519 recomendado: chaves de 32 bytes, assinaturas rápidas, nenhum ataque prático conhecido até hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐 ED25519：32 字节密钥，签名快，目前未被实战攻破。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議用 ED25519：32 位元組的金鑰，簽章快，至今沒有實際可行的破解。"
          }
        }
      }
    },
