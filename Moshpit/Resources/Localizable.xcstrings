    "%@ %@ \"%@\"?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ \"%@\"?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ \"%@\"?"
          }
        }
      }
    },
    "%@ %@ %@? Every pane in it dies.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？その中のすべてのペインが終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？其中每个窗格都会终止。"
          }
        }
      }
    },
    "%@ %@ %@? Everything in it dies.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？その中のすべてが終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？其中的一切都会终止。"
          }
        }
      }
    },
    "%@ frees %@. You can download it again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を削除すると %2$@ を解放できます。後で再ダウンロードできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %1$@ 可释放 %2$@。以后可以重新下载。"
          }
        }
      }
    },
    "%@ not installed on this host": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストに %@ がインストールされていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机上没装 %@"
          }
        }
      }
    },
    "%@ of ≈%@ — paused": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / 約 %2$@ — 一時停止中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载 %1$@ / 约 %2$@ — 已暂停"
          }
        }
      }
    },
