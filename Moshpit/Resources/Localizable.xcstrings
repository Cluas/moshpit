    "Connections using it: %@. Choose another key for them first, then delete this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindungen nutzen ihn: %@. Wähle dort zuerst einen anderen Schlüssel und lösche diesen dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiones que la usan: %@. Elige primero otra clave para ellas y luego elimina esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexions qui l’utilisent : %@. Choisissez d’abord une autre clé pour elles, puis supprimez celle-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを使っている接続：%@。先にそれらの接続で別のキーを選んでから削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 쓰는 연결: %@. 먼저 해당 연결에서 다른 키를 고른 뒤 이 키를 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexões que a usam: %@. Escolha outra chave para elas primeiro e depois apague esta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还在用它的连接：%@。先给它们换一把密钥，再删这把。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在用它的連線：%@。先幫它們換一把金鑰，再刪除這把。"
          }
        }
      }
    },
