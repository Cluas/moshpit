          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かしこまり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분부대로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Às ordens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
