        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 —— 重新连接以启用。"
          }
        }
      }
    },
    "Installs to ~/.local/bin. Moshpit looks there when probing and launching, so you don't need to change PATH.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin にインストールされます。Moshpit は検出時も起動時もそこを参照するため、PATH を変更する必要はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装到 ~/.local/bin。Moshpit 探测和启动时都会去那里找，所以你不用改 PATH。"
          }
        }
      }
    },
