    "%@ isn't installed here, so this is a plain shell.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist hier nicht installiert, das ist eine einfache Shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está instalado aquí, así que esto es una shell normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas installé ici : c’est un shell simple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストには %@ がないため、通常のシェルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에 %@이(가) 없어 일반 셸로 열었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ não está instalado aqui, então este é um shell comum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机没装 %@，现在是普通 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台主機沒裝 %@，現在是一般 shell。"
          }
        }
      }
    },
