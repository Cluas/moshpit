    "“%@” and everything in it will be deleted from the host.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und alles darin wird vom Host gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán del host «%@» y todo lo que contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et tout son contenu seront supprimés de l’hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストから %@ とその中身がすべて削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에서 %@ 폴더와 그 안의 모든 항목이 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e tudo o que há dentro serão apagados do host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从主机上删除 %@ 和里面的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會從主機上刪除 %@ 和裡面的所有內容。"
          }
        }
      }
    },
    "“%@” is already another connection's name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits der Name einer anderen Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya es el nombre de otra conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà le nom d’une autre connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」という名前の接続がすでにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’라는 이름의 연결이 이미 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já é o nome de outra conexão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经有别的连接叫「%@」了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經有別的連線叫「%@」了。"
          }
        }
      }
    },
    "“%@” will be deleted from the host.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird vom Host gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará «%@» del host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé de l’hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストから %@ が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에서 %@ 항목이 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será apagado do host."
