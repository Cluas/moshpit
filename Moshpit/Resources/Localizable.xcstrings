    },
    "Dictate commands and prompts from the mic key on the terminal bar. Speech is transcribed entirely on-device — your voice never leaves this device, and nothing is typed until you tap Insert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiere Befehle und Prompts über die Mikrofontaste in der Terminalleiste. Die Sprache wird vollständig auf dem Gerät in Text umgewandelt. Deine Stimme verlässt dieses Gerät nie, und getippt wird erst, wenn du auf „Einfügen“ tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta comandos y prompts con la tecla de micrófono de la barra del terminal. La voz se transcribe por completo en el dispositivo: nunca sale de él, y no se escribe nada hasta que tocas Insertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictez commandes et prompts depuis la touche micro de la barre du terminal. La parole est transcrite entièrement sur l’appareil : votre voix ne le quitte jamais, et rien n’est saisi avant que vous touchiez Insérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットバーのマイクキーからコマンドやプロンプトを音声入力できます。書き起こしは完全に端末内で行われ、音声がこの端末を離れることはなく、「挿入」をタップするまで何も入力されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 막대의 마이크 키로 명령과 프롬프트를 말로 입력하세요. 음성은 전부 기기 안에서 텍스트로 바뀌며 이 기기를 벗어나지 않습니다. 삽입을 탭하기 전까지는 아무것도 입력되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dite comandos e prompts pela tecla de microfone na barra do terminal. A fala é transcrita inteiramente no aparelho: sua voz nunca sai dele, e nada é digitado até você tocar em Inserir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按快捷键栏上的麦克风键，把命令和提示词说出来。转写全部在本机完成，语音不会离开这台手机。不点「插入」，什么都不会输进终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按快速鍵列上的麥克風鍵，把指令和提示詞說出來。轉寫全部在裝置上完成，語音不會離開這部裝置。不點「插入」，什麼都不會輸入到終端機。"
          }
        }
      }
    },
    "Dictate commands instead of typing. Planned for a future update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle diktieren statt tippen. Kommt mit einem späteren Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta comandos en vez de escribirlos. Llegará en una actualización futura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictez vos commandes au lieu de les taper. Prévu dans une prochaine mise à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイプの代わりに音声でコマンドを入力。今後のアップデートで提供予定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑 대신 말로 명령을 입력합니다. 향후 업데이트에서 제공됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dite comandos em vez de digitar. Previsto para uma atualização futura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话代替打字。后续版本提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用說的代替打字。之後的版本會提供。"
          }
        }
      }
    },
    "Dictation isn't available for %@ on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren auf %@ ist auf diesem Gerät nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado en %@ no está disponible en este dispositivo."
          }
