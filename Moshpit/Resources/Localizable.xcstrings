    "Send keepalive pings so the server does not drop idle connections": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Keepalive-Pings, damit der Server inaktive Verbindungen nicht trennt"
          }
        },
