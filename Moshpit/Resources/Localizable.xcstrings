    "Idempotent: re-running de-dupes Moshpit's hooks instead of stacking them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冪等です。再実行すると Moshpit のフックは重複除去され、積み重なりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "幂等：重复运行会去重 Moshpit 的 hook，而不是层层堆叠。"
          }
        }
      }
    },
    "Import": {
      "localizations": {
