    "Update the hooks for %@ first: the test runs what this version of Moshpit installs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere zuerst die Hooks für %@: Der Test führt aus, was diese Moshpit-Version installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza primero los hooks de %@: la prueba ejecuta lo que instala esta versión de Moshpit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez d’abord à jour les hooks de %@ : le test exécute ce qu’installe cette version de Moshpit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に %@ のフックを更新してください。テストはこのバージョンの Moshpit がインストールするものを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 %@ 훅을 업데이트하세요. 테스트는 이 버전의 Moshpit이 설치하는 것을 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize primeiro os hooks de %@: o teste executa o que esta versão do Moshpit instala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先更新 %@ 的状态脚本：测试运行的是这个版本的 Moshpit 装的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先更新 %@ 的狀態腳本：測試執行的是這個版本的 Moshpit 裝的內容。"
          }
        }
      }
    },
    "Uploads images to the agent's server and hands it the file paths.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Bilder auf den Server des Agents und übergibt ihm die Dateipfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las imágenes al servidor del agente y le pasa las rutas de los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les images sur le serveur de l’agent et lui transmet les chemins des fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をエージェントのサーバーにアップロードし、ファイルパスを渡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 에이전트의 서버에 올리고 파일 경로를 에이전트에 넘깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia as imagens ao servidor do agente e passa os caminhos dos arquivos para ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把图片上传到智能体所在的服务器，再把文件路径交给它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把圖片上傳到智能體所在的伺服器，再把檔案路徑交給它。"
          }
        }
      }
    },
