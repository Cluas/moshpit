    "Authentication failed — the server rejected your username and password / key. Double-check your credentials.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Der Server hat Benutzername und Passwort bzw. Schlüssel abgelehnt. Prüfe deine Zugangsdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la autenticación: el servidor rechazó tu nombre de usuario y tu contraseña o clave. Revisa tus credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’authentification : le serveur a refusé votre nom d’utilisateur et votre mot de passe ou votre clé. Vérifiez vos identifiants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました — ユーザー名とパスワード / 鍵がサーバーに拒否されました。認証情報を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 실패했습니다. 서버가 사용자 이름과 암호 또는 키를 거부했습니다. 입력한 정보를 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação: o servidor rejeitou seu nome de usuário e sua senha ou chave. Confira suas credenciais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败，服务器不接受这个用户名和密码或密钥。检查一下填的对不对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入失敗，伺服器不接受這個使用者名稱和密碼或金鑰。檢查一下填的對不對。"
          }
        }
      }
    },
