    "Leave blank for an automatic name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen für einen automatischen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para un nombre automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour un nom automatique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にすると自動で名前が付きます。"
          }
        },
        "ko": {
