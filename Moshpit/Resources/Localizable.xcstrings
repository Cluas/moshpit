    "Fast and light. Noticeably weaker outside English.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und leicht. Außerhalb von Englisch deutlich schwächer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido y ligero. Bastante más flojo fuera del inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide et léger. Nettement moins bon hors de l’anglais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速・軽量。英語以外は精度が明らかに落ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르고 가볍습니다. 영어 외 언어에서는 눈에 띄게 약합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido e leve. Bem mais fraco fora do inglês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快、占用小。英语以外的语言明显差一些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快、占用小。英語以外的語言明顯差一些。"
          }
        }
      }
    },
    "Fastest, lowest accuracy. For older devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am schnellsten, am ungenauesten. Für ältere Geräte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El más rápido y el menos preciso. Para dispositivos antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus rapide, le moins précis. Pour les appareils anciens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最速・最低精度。古い端末向け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 빠르지만 정확도가 가장 낮습니다. 오래된 기기용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mais rápido e o menos preciso. Para aparelhos antigos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最快，准确度最低。适合较旧的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最快，準確度最低。適合較舊的裝置。"
          }
        }
      }
    },
