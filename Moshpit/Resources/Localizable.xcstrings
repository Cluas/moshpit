            "state": "translated",
            "value": "只显示最近 500 条，共 %lld 条；复制会带上全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示最近 500 筆，共 %lld 筆；拷貝會帶上全部。"
          }
        }
      }
    },
    "Shows on the host's mark in place of its key's pattern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint im Symbol des Hosts anstelle des Musters aus seinem Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en el icono del host en lugar del patrón de su clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
