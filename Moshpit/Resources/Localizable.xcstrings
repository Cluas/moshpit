        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝某个方向拖动以发送方向键"
          }
        }
      }
    },
    "Drag up or down to scroll the terminal scrollback": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグしてターミナルの履歴をスクロールします"
