    "A bug, an idea, a screen that reads wrong": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler, eine Idee, eine Ansicht, die sich falsch liest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un error, una idea, una pantalla que no se lee bien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bug, une idée, un écran qui se lit mal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バグ、アイデア、読みにくい画面"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그, 아이디어, 어색하게 읽히는 화면"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bug, uma ideia, uma tela que não soa bem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个 bug、一个想法，或者哪个界面看着不对"
          }
