          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O script de marcação rodou, mas o painel voltou vazio.%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
