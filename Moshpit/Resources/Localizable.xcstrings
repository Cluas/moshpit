    "Close pane “%1$@” in %2$@? What runs in it stops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel „%1$@“ in %2$@ schließen? Was darin läuft, wird gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar el panel «%1$@» de %2$@? Lo que se ejecuta en él se detendrá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer le panneau « %1$@ » de %2$@ ? Ce qui y tourne s’arrêtera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ のペイン「%1$@」を閉じますか？中で動いているものは止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 패널 ‘%1$@’을(를) 닫을까요? 그 안에서 실행 중인 것이 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar o painel “%1$@” em %2$@? O que roda nele vai parar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 %2$@ 里的窗格「%1$@」？里面正在跑的程序会停掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 %2$@ 裡的窗格「%1$@」？裡面正在跑的程式會停掉。"
          }
        }
      }
    },
