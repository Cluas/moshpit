    "From must be ≤ To.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Von“ darf nicht größer als „Bis“ sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Desde» no puede ser mayor que «Hasta»."
          }
        },
