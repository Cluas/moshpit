            "value": "Ainda não dá para entrar com chaves %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时还不能用 %@ 密钥登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還不能用 %@ 金鑰登入"
          }
        }
      }
    },
    "Can't start with “-” or “/”, or end with “/”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf nicht mit „-“ oder „/“ beginnen und nicht mit „/“ enden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede empezar por «-» ni «/», ni terminar en «/»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne peut pas commencer par « - » ou « / », ni finir par « / »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「-」「/」で始めたり、「/」で終わることはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“-”나 “/”로 시작하거나 “/”로 끝날 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode começar com “-” ou “/”, nem terminar com “/”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能以 “-” 或 “/” 开头，也不能以 “/” 结尾"
