          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 预测领先于服务器时，光标后面留一道青色尾迹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 的預測領先伺服器時，游標後面會留一道青色尾跡"
          }
        }
      }
    },
    "Let remote programs read your clipboard text (OSC 52) — off answers with an empty clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt entfernten Programmen, den Text deiner Zwischenablage zu lesen (OSC 52). Ausgeschaltet bekommen sie eine leere Zwischenablage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los programas remotos lean el texto de tu portapapeles (OSC 52). Desactivado, reciben un portapapeles vacío"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les programmes distants à lire le texte de votre presse-papiers (OSC 52). Désactivé, ils reçoivent un presse-papiers vide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートのプログラムにクリップボードのテキスト読み取り（OSC 52）を許可します。オフにすると空のクリップボードを返します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 프로그램이 클립보드 텍스트를 읽도록 허용합니다(OSC 52). 끄면 빈 클립보드로 응답합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que programas remotos leiam o texto da sua área de transferência (OSC 52). Desativado, eles recebem uma área de transferência vazia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许远程程序读取你的剪贴板文字（OSC 52）。关掉后它们只会读到空剪贴板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許遠端程式讀取你的剪貼板文字（OSC 52）。關掉後它們只會讀到空的剪貼板"
          }
        }
      }
    },
