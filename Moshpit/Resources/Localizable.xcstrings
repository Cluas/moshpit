    "Leaves a signal trail behind the cursor while mosh predicts ahead of the server": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh がサーバーより先に予測している間、カーソルの後ろに軌跡を残します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 抢先于服务器预测时，在光标后留下一道轨迹"
          }
        }
      }
    },
    "Leaves a teal trail behind the cursor while mosh predicts ahead of the server": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh がサーバーより先行して予測する間、カーソルの後ろにティールのトレイルを残します"
