    "%@ %@ \"%@\"?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ „%3$@“ %1$@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿%1$@ %2$@ «%3$@»?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ « %3$@ » ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ \"%@\"?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%3$@\" %2$@ %1$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ “%3$@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ \"%@\"?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@「%3$@」？"
          }
        }
      }
    },
    "%@ %@ %@? Every pane in it dies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %3$@ %1$@? Jedes Panel darin wird beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿%1$@ %2$@ %3$@? Se cierran todos sus paneles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@ ? Tous ses panneaux seront fermés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？その中のすべてのペインが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ %2$@ %1$@? 안에 있는 패널이 모두 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@? Todos os painéis dentro serão encerrados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？其中每个窗格都会终止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？裡面的每個窗格都會終止。"
          }
        }
      }
    },
    "%@ %@ %@? Everything in it dies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %3$@ %1$@? Alles darin wird beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿%1$@ %2$@ %3$@? Se cierra todo lo que contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@ ? Tout son contenu sera fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？その中のすべてが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ %2$@ %1$@? 안에 있는 것이 모두 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@? Tudo dentro será encerrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？其中的一切都会终止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？裡面的一切都會終止。"
          }
        }
      }
    },
    "%@ arrived damaged. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kam beschädigt an. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ llegó dañado. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est arrivé endommagé. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が壊れた状態で届きました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 파일이 손상된 채로 받아졌습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chegou corrompido. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 下载下来是坏的，再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 下載下來是壞的，再試一次。"
          }
        }
      }
    },
    "%@ asks a question before you can sign in. Open Moshpit to answer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stellt vor der Anmeldung eine Frage. Öffne Moshpit, um sie zu beantworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hace una pregunta antes de iniciar sesión. Abre Moshpit para responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pose une question avant la connexion. Ouvre Moshpit pour y répondre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ へのサインインの前に質問があります。Moshpit を開いて答えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 로그인하기 전에 답할 질문이 있습니다. Moshpit을 열어 답하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ faz uma pergunta antes de você entrar. Abra o Moshpit para responder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 %@ 前要回答一个问题，打开 Moshpit 回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 %@ 前要回答一個問題，打開 Moshpit 回答。"
          }
        }
      }
    },
    "%@ didn't answer. Check the address, that the host is on, and your VPN if it sits behind one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet nicht. Prüfe die Adresse, ob der Host eingeschaltet ist und – falls er hinter einem VPN liegt – das VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió. Comprueba la dirección, que el host esté encendido y, si está detrás de una VPN, la VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas. Vérifiez l’adresse, que l’hôte est allumé et, s’il est derrière un VPN, le VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から応答がありません。アドレスとホストの電源を確認してください。VPN の内側にあるなら VPN の接続も確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 호스트가 응답하지 않습니다. 주소와 호스트 전원을 확인하고, VPN 뒤에 있다면 VPN 연결도 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu. Confira o endereço, se o host está ligado e, se ele estiver atrás de uma VPN, a VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有响应。检查一下地址、主机有没有开机；如果它在 VPN 后面，再看看 VPN 连上没有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有回應。檢查一下位址、主機有沒有開機；如果它在 VPN 後面，再看看 VPN 有沒有連上。"
          }
        }
      }
    },
    "%@ doesn't register Moshpit for %@. Reinstall to put it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trägt Moshpit nicht für %@ ein. Installiere neu, um es wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no registra Moshpit para %@. Reinstala para restaurarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’enregistre pas Moshpit pour %@. Réinstallez pour le rétablir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に %@ 用の Moshpit が登録されていません。再インストールすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 %@용 Moshpit이 등록되어 있지 않습니다. 다시 설치하면 복구됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não registra o Moshpit para %@. Reinstale para restaurá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 里没有为 %@ 登记 Moshpit。重新安装就能补上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 裡沒有為 %@ 登記 Moshpit。重新安裝就能補上。"
          }
        }
      }
    },
    "%@ finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が終わったよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 끝났어."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 干完了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 做完了。"
          }
        }
      }
    },
    "%@ frees %@. You can download it again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gibt %2$@ frei. Du kannst es später wieder laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar %1$@ libera %2$@. Puedes volver a descargarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %1$@ libère %2$@. Vous pourrez le retélécharger plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を削除すると %2$@ を解放できます。後で再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 제거하면 %2$@이(가) 비워집니다. 나중에 다시 받을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ libera %2$@. Você pode baixá-lo de novo depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %1$@ 可释放 %2$@。以后可以重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %1$@ 可釋出 %2$@。之後可以再下載。"
          }
        }
      }
    },
    "%@ is on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ legt los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se pone a ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’y met."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が動きはじめた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 작업 시작."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ começou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 开工了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 開工了。"
          }
        }
      }
    },
    "%@ isn't answering.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から返事がない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 응답이 없어."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não responde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒回應。"
          }
        }
      }
    },
    "%@ isn't connected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht verbunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas connecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결되어 있지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está conectado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还没连上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 還沒連上"
          }
        }
      }
    },
    "%@ isn't installed here, so this is a plain shell.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist hier nicht installiert, das ist eine einfache Shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está instalado aquí, así que esto es una shell normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas installé ici : c’est un shell simple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストには %@ がないため、通常のシェルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에 %@이(가) 없어 일반 셸로 열었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ não está instalado aqui, então este é um shell comum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机没装 %@，现在是普通 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台主機沒裝 %@，現在是一般 shell。"
          }
        }
      }
    },
    "%@ isn't installed on this host": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf diesem Host nicht installiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está instalado en este host"
          }
