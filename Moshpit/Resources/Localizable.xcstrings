    "Leaves a signal trail behind the cursor while mosh predicts ahead of the server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht eine Spur hinter dem Cursor, solange mosh dem Server vorausgreift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja un rastro tras el cursor mientras mosh va por delante del servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse une traînée derrière le curseur tant que mosh devance le serveur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh がサーバーより先に予測している間、カーソルの後ろに軌跡を残します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 예측이 서버보다 앞서 있을 때 커서 뒤에 잔상을 남깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa um rastro atrás do cursor enquanto o mosh está à frente do servidor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 预测领先于服务器时，光标后面留一道尾迹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 的預測領先伺服器時，游標後面會留一道尾跡"
          }
        }
      }
    },
    "Leaves a teal trail behind the cursor while mosh predicts ahead of the server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht eine türkise Spur hinter dem Cursor, solange mosh dem Server vorausgreift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja un rastro turquesa tras el cursor mientras mosh va por delante del servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse une traînée turquoise derrière le curseur tant que mosh devance le serveur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh がサーバーより先行して予測する間、カーソルの後ろにティールのトレイルを残します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 예측이 서버보다 앞서 있을 때 커서 뒤에 청록색 잔상을 남깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
