    "Installs to ~/.local/bin. Moshpit looks there when probing and launching, so you don't need to change PATH.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert nach ~/.local/bin. Moshpit sucht dort beim Prüfen und Starten, du musst PATH also nicht ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se instala en ~/.local/bin. Moshpit busca ahí al comprobar y al lanzar, así que no hace falta cambiar el PATH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’installe dans ~/.local/bin. Moshpit y regarde lors de la détection et du lancement : pas besoin de modifier le PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin にインストールされます。Moshpit は検出時も起動時もそこを参照するため、PATH を変更する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin에 설치합니다. Moshpit이 탐지와 실행 때 그곳을 확인하므로 PATH를 바꿀 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala em ~/.local/bin. O Moshpit procura lá ao detectar e ao iniciar, então você não precisa mudar o PATH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装到 ~/.local/bin。Moshpit 探测和启动时都会去那里找，所以你不用改 PATH。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝到 ~/.local/bin。Moshpit 偵測和啟動時都會去那裡找，所以你不用改 PATH。"
          }
        }
      }
    },
