    "Send keepalive pings so the server does not drop idle connections": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Keepalive-Pings, damit der Server inaktive Verbindungen nicht trennt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía pings de keepalive para que el servidor no cierre las conexiones inactivas"
