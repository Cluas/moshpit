            "value": "形状"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状"
          }
        }
      }
    },
    "Shape and color apply to all SSH / mosh sessions. With trail on, characters that mosh's predictive echo shows ahead of the server are marked with a translucent trail until confirmed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形状と色はすべての SSH / mosh セッションに適用されます。trail をオンにすると、mosh の予測エコーがサーバーより先に表示した文字は、確定するまで半透明のトレイルで示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状与颜色对所有 SSH / mosh 会话生效。开启 trail 时，mosh 预测回显领先服务端的字符会用半透明拖尾标出未被确认的范围。"
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键"
          }
        }
      }
    },
    "Show agent session status in the Dynamic Island": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island にエージェントの状態を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在灵动岛显示智能体会话状态"
          }
        }
      }
    },
    "Show keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示键盘"
          }
        }
      }
    },
    "Show only while the current session runs tmux": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のセッションで tmux 実行中のみ表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当当前会话有 tmux 进程时显示"
          }
        }
      }
    },
    "Show typed characters locally before server confirms": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー確認前に入力文字をローカルで表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务器确认前先在本地显示输入的字符"
          }
        }
      }
    },
    "Still not detected. Run the command, wait for it to finish, then re-check.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ検出されません。コマンドを実行し、完了を待ってから再チェックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍未检测到。请运行命令并等待其完成，然后重新检测。"
          }
        }
      }
    },
    "Store in Secure Enclave": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave に保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存入 Secure Enclave"
          }
        }
      }
    },
    "Swipe to switch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプで切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动切换"
          }
        }
      }
    },
    "THIS DEVICE · SECURE ENCLAVE": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス · SECURE ENCLAVE"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 · SECURE ENCLAVE"
          }
        }
      }
    },
    "TRIGGER": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发"
          }
        }
      }
    },
    "TYPE": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        }
      }
    },
    "Tap modifiers to toggle them and enter a single character as the main key; the mobile keyboard triggers the raw scancode automatically.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーをタップして切り替え、メインキーは 1 文字で入力します。モバイルキーボードは生のスキャンコードを自動送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击修饰键开关，单字符键输入主键；移动键盘会自动触发原始 scancode。"
          }
        }
      }
    },
    "Tap to focus pane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでペインにフォーカス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按聚焦窗格"
          }
        }
      }
    },
    "Tap ＋ in the top right to create a custom shortcut — key combos, text snippets, and command chains.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋でカスタムショートカットを作成 — キーコンボ、テキストスニペット、コマンドチェーンに対応。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右上 ＋ 新建自定义快捷键 — 支持按键组合、文本片段、命令链。"
          }
        }
      }
    },
    "Tap ＋ to add your first server. Moshpit keeps your sessions alive across Wi-Fi / 5G handoff.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして最初のサーバーを追加。Moshpit は Wi-Fi / 5G の切り替えをまたいでセッションを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 添加第一台服务器。Moshpit 会在 Wi-Fi / 5G 切换时保持会话不断线。"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本"
          }
        }
      }
    },
    "The hooks only stamp the tmux pane and exit 0 — Claude is never slowed, prompted, or interrupted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは tmux ペインに印を付けて exit 0 で終了するだけで、Claude を遅延・中断・プロンプト表示することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钩子只会给 tmux 窗格打标记并以 exit 0 退出——绝不会拖慢、打断 Claude 或弹出提示。"
          }
        }
      }
    },
    "The key for %@:%lld does NOT match the one stored on this device. This can mean the server was reinstalled — or that the connection is being intercepted.\n\nStored: %@\nNew: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld のキーがこのデバイスに保存されたものと一致しません。サーバーが再インストールされたか、接続が傍受されている可能性があります。\n\n保存済み：%3$@\n新規：%4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld 的密钥与本设备存储的不一致。这可能意味着服务器被重装——也可能是连接正被拦截。\n\n已存储：%3$@\n新密钥：%4$@"
          }
        }
      }
    },
    "The mosh-server executable on the remote host. Override if it isn't on PATH (e.g. /opt/homebrew/bin/mosh-server).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートホスト上の mosh-server 実行ファイル。PATH にない場合はここで上書きします（例: /opt/homebrew/bin/mosh-server）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机上的 mosh-server 可执行文件。若不在 PATH 中可在此覆盖（如 /opt/homebrew/bin/mosh-server）。"
          }
        }
      }
    },
    "The server rejected this sign-in method. Try a different one (e.g. a key instead of a password).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこのサインイン方法を拒否しました。別の方法をお試しください(例:パスワードの代わりに鍵)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这种登录方式。请换一种(例如用密钥代替密码)。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "This server has no running sessions.\nMoshpit only attaches — create the first one to start.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーには実行中のセッションがありません。\nMoshpit はアタッチのみ行います — 最初のセッションを作成して始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务器上没有正在运行的会话。\nMoshpit 只做附加 — 创建第一个会话以开始。"
          }
        }
      }
    },
    "To": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
