    "Face ID confirmation before every signature": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名のたびに Face ID で確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次签名前需 Face ID 确认"
          }
        }
      }
    },
    "First connection to %@:%lld.\n\nKey fingerprint:\n%@\n\nVerify it matches the server (e.g. `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld への初回接続です。\n\nキーのフィンガープリント：\n%3$@\n\nサーバー側と一致するか確認してください（例: `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接 %1$@:%2$lld。\n\n密钥指纹：\n%3$@\n\n请核对其与服务器一致（如 `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        }
      }
    },
    "Font": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォント"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体"
          }
        }
      }
