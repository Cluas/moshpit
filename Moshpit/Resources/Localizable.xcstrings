    "There's no route to %@ from this network. Check your connection, and your VPN if the host sits behind one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus diesem Netzwerk führt keine Route zu %@. Prüfe deine Verbindung und – falls der Host hinter einem VPN liegt – das VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ruta hacia %@ desde esta red. Comprueba tu conexión y, si el host está detrás de una VPN, la VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune route vers %@ depuis ce réseau. Vérifiez votre connexion et, si l’hôte est derrière un VPN, le VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークから %@ への経路がありません。接続状況を確認してください。VPN の内側にあるホストなら VPN の接続も確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 네트워크에서 %@ 호스트로 가는 경로가 없습니다. 네트워크 연결을 확인하고, 호스트가 VPN 뒤에 있다면 VPN 연결도 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há rota até %@ a partir desta rede. Confira sua conexão e, se o host estiver atrás de uma VPN, a VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前网络没有通往 %@ 的路由。检查一下网络连接；如果主机在 VPN 后面，再看看 VPN 连上没有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的網路沒有通往 %@ 的路由。檢查一下網路連線；如果主機在 VPN 後面，再看看 VPN 有沒有連上。"
          }
        }
      }
    },
    "These eight are what shells, diffs and TUIs paint with.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesen acht Farben zeichnen Shells, Diffs und TUIs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estos ocho colores pintan las shells, los diffs y las TUI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces huit couleurs sont celles qu’utilisent les shells, les diffs et les TUI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェル・diff・TUI が使うのはこの 8 色です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸, diff, TUI가 이 여덟 가지 색으로 화면을 그립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São com estas oito cores que shells, diffs e TUIs pintam a tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "shell、diff 和 TUI 用的就是这八种颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "shell、diff 和 TUI 用的就是這八種顏色。"
          }
        }
      }
    },
    "This accent will be removed. Built-in accents are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Akzentfarbe wird entfernt. Integrierte Akzentfarben bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este acento se quitará. Los acentos integrados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette couleur d’accentuation sera retirée. Les couleurs intégrées ne sont pas concernées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクセントを削除します。内蔵アクセントには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 강조 색상이 제거됩니다. 내장 강조 색상은 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cor de destaque será removida. As cores integradas não mudam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个强调色会被删除。内置强调色不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個強調色會被移除。內建強調色不受影響。"
          }
        }
      }
    },
    "This connection was deleted while you were editing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung wurde gelöscht, während du sie bearbeitet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión se eliminó mientras la editabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion a été supprimée pendant que vous la modifiiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にこの接続は削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집하는 동안 이 연결이 삭제되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão foi excluída enquanto você a editava."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间这个连接已经被删除了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯期間這個連線已經被刪除了。"
          }
        }
      }
    },
    "This device is locked, so Moshpit can't read the saved password or key yet. It connects again once you unlock it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist gesperrt, deshalb kann Moshpit das gesicherte Passwort oder den Schlüssel noch nicht lesen. Nach dem Entsperren verbindet es sich von selbst neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está bloqueado, así que Moshpit aún no puede leer la contraseña o la clave guardadas. Se volverá a conectar en cuanto lo desbloquees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est verrouillé : Moshpit ne peut pas encore lire le mot de passe ou la clé enregistrés. Il se reconnectera dès que vous le déverrouillerez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスがロックされているため、保存したパスワードやキーをまだ読み出せません。ロックを解除すると自動で接続し直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 잠겨 있어 Moshpit이 저장된 암호나 키를 아직 읽을 수 없습니다. 잠금을 해제하면 다시 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está bloqueado, então o Moshpit ainda não consegue ler a senha ou a chave salvas. Ele se reconecta assim que você desbloquear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备还锁着，Moshpit 暂时读不到保存的密码或密钥。解锁后会自己重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置還鎖著，Moshpit 暫時讀不到儲存的密碼或金鑰。解鎖後會自己重新連線。"
          }
        }
      }
    },
    "This file is %@. Download it to preview?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist %@ groß. Für die Vorschau laden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ocupa %@. ¿Descargarlo para verlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier fait %@. Le télécharger pour l’aperçu ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは %@ です。ダウンロードしてプレビューしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 %@입니다. 다운로드해서 미리 볼까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo tem %@. Baixar para visualizar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件有 %@，要下载下来预览吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案有 %@，要下載下來預覽嗎？"
          }
        }
      }
    },
    "This file is no longer on the host.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei liegt nicht mehr auf dem Host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ya no está en el host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est plus sur l’hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはもうホストにありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 더 이상 호스트에 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não está mais no host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件已经不在主机上了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案已經不在主機上了。"
          }
        }
      }
    },
    "This folder is empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist leer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está vacía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est vide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは空です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 비어 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta está vazia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件夹是空的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個資料夾是空的"
          }
        }
      }
    },
    "This host has SFTP turned off, and the file is too large to send without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Host ist SFTP ausgeschaltet, und ohne SFTP ist die Datei zu groß zum Übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este host tiene SFTP desactivado y el archivo es demasiado grande para enviarlo sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP est désactivé sur cet hôte, et le fichier est trop volumineux pour être transféré sans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストは SFTP がオフで、SFTP なしで送るにはファイルが大きすぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트는 SFTP가 꺼져 있고, SFTP 없이 보내기에는 파일이 너무 큽니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SFTP está desativado neste host, e o arquivo é grande demais para ser enviado sem ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机关了 SFTP，文件又太大，没法用别的办法传过来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台主機關閉了 SFTP，檔案又太大，沒辦法用其他方式傳過來。"
          }
        }
      }
    },
    "This host is missing %@ — install those and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Host fehlt %@. Installiere es und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A este host le falta %@. Instálalo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque %@ sur cet hôte. Installez-le et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストには %@ がありません。インストールしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에 %@이(가) 없습니다. 설치한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta %@ neste host. Instale e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机缺少 %@。装好再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台主機缺少 %@。裝好再試。"
          }
        }
      }
    },
    "This host's tmux isn't on the default socket, so Moshpit can't run the test. The hooks themselves are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das tmux dieses Hosts läuft nicht auf dem Standard-Socket, deshalb kann Moshpit den Test nicht ausführen. Die Hooks selbst sind davon nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tmux de este host no usa el socket por omisión, así que Moshpit no puede ejecutar la prueba. Los hooks en sí no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tmux de cet hôte n’utilise pas le socket par défaut : Moshpit ne peut pas lancer le test. Les hooks eux-mêmes ne sont pas concernés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストの tmux はデフォルトのソケットを使っていないため、Moshpit はテストを実行できません。フック自体には影響ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트의 tmux가 기본 소켓을 쓰지 않아 Moshpit이 테스트를 실행할 수 없습니다. 훅 자체는 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tmux deste host não usa o socket padrão, então o Moshpit não consegue rodar o teste. Os hooks em si não são afetados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机的 tmux 没用默认 socket，Moshpit 跑不了这个测试。状态脚本本身不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台主機的 tmux 沒用預設 socket，Moshpit 跑不了這個測試。狀態腳本本身不受影響。"
          }
        }
      }
    },
    "This isn't a private key Moshpit can read. Paste an OpenSSH or PEM private key, from its BEGIN line to its END line.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein privater Schlüssel, den Moshpit lesen kann. Setze einen privaten Schlüssel im OpenSSH- oder PEM-Format ein, von der BEGIN-Zeile bis zur END-Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una clave privada que Moshpit pueda leer. Pega una clave privada en formato OpenSSH o PEM, desde la línea BEGIN hasta la línea END."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une clé privée que Moshpit sait lire. Collez une clé privée au format OpenSSH ou PEM, de la ligne BEGIN à la ligne END."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit が読める秘密鍵ではありません。OpenSSH または PEM 形式の秘密鍵を、BEGIN の行から END の行まで貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit이 읽을 수 있는 개인 키가 아닙니다. OpenSSH 또는 PEM 형식의 개인 키를 BEGIN 줄부터 END 줄까지 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é uma chave privada que o Moshpit consiga ler. Cole uma chave privada no formato OpenSSH ou PEM, da linha BEGIN até a linha END."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit 认不出这是私钥。请粘贴 OpenSSH 或 PEM 格式的私钥，从 BEGIN 那一行一直到 END 那一行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit 認不出這是私密金鑰。請貼上 OpenSSH 或 PEM 格式的私密金鑰，從 BEGIN 那一行一直到 END 那一行。"
          }
        }
      }
    },
    "This key is encrypted with %@, which Moshpit can't unlock. Re-encrypt it with “ssh-keygen -p” and import it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist mit %@ verschlüsselt, was Moshpit nicht entsperren kann. Verschlüssele ihn mit „ssh-keygen -p“ neu und importiere ihn noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave está cifrada con %@, que Moshpit no puede desbloquear. Vuelve a cifrarla con «ssh-keygen -p» e impórtala otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est chiffrée avec %@, que Moshpit ne sait pas déverrouiller. Rechiffrez-la avec « ssh-keygen -p » puis importez-la à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この鍵は %@ で暗号化されていて、Moshpit では開けません。「ssh-keygen -p」で暗号化し直してから、もう一度読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 %@(으)로 암호화되어 있어 Moshpit에서 열 수 없습니다. “ssh-keygen -p”로 다시 암호화한 뒤 다시 가져오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave está criptografada com %@, que o Moshpit não consegue desbloquear. Criptografe-a de novo com “ssh-keygen -p” e importe-a outra vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把密钥用 %@ 加密，Moshpit 解不开。用 ssh-keygen -p 重新加密后再导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把金鑰用 %@ 加密，Moshpit 解不開。用 ssh-keygen -p 重新加密後再匯入。"
          }
        }
      }
    },
    "This key is locked with a passphrase. Connect again and enter it — Moshpit asks for it only once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist mit einer Passphrase geschützt. Verbinde dich erneut und gib sie ein – Moshpit fragt nur dieses eine Mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave está protegida con una frase de contraseña. Vuelve a conectarte y escríbela: Moshpit solo la pide una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est protégée par une phrase secrète. Reconnectez-vous et saisissez-la : Moshpit ne la demande qu’une fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この鍵はパスフレーズで保護されています。もう一度接続して入力してください。尋ねるのはこの一度だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 암호 문구로 보호되어 있습니다. 다시 연결해 한 번만 입력하세요. 그다음부터는 묻지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave é protegida por uma frase-senha. Conecte de novo e digite-a — o Moshpit só pede uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把密钥设了口令。重新连接时输入一次就行，之后不会再问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把金鑰設了密碼短語。重新連線時輸入一次就好，之後不會再問。"
          }
        }
      }
    },
    "This key is protected by a passphrase. Enter it to import the key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist mit einer Passphrase geschützt. Gib sie ein, um den Schlüssel zu importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave está protegida con una frase de contraseña. Escríbela para importar la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est protégée par une phrase secrète. Saisissez-la pour importer la clé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この鍵はパスフレーズで保護されています。読み込むにはパスフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 암호 문구로 보호되어 있습니다. 가져오려면 암호 문구를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave é protegida por uma frase-senha. Digite-a para importar a chave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把密钥设了口令，输入口令才能导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把金鑰設了密碼短語，輸入密碼短語才能匯入。"
          }
        }
      }
    },
    "This key is protected by a passphrase. It's used once, to unlock the key here; from then on the Android Keystore protects it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist mit einer Passphrase geschützt. Sie wird hier einmal verwendet, um ihn zu entsperren; danach schützt ihn der Android Keystore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave está protegida con una frase de contraseña. Se usa una sola vez, aquí, para desbloquearla; a partir de entonces la protege el Android Keystore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est protégée par une phrase secrète. Elle ne sert qu’une fois, ici, pour déverrouiller la clé ; ensuite, l’Android Keystore la protège."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この鍵はパスフレーズで保護されています。パスフレーズは読み込み時に一度だけ使い、以降の鍵は Android Keystore が保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 암호 문구로 보호되어 있습니다. 암호 문구는 키를 열 때 여기서 한 번만 쓰이고, 이후에는 Android Keystore가 키를 보호합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave é protegida por uma frase-senha. Ela é usada uma vez, aqui, para desbloquear a chave; depois disso, o Android Keystore a protege."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把密钥设了口令。口令只在导入时用一次，解开后密钥由 Android 密钥库保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把金鑰設了密碼短語。密碼短語只在匯入時用一次，解開後金鑰由 Android Keystore 保護。"
          }
        }
      }
    },
    "This key is protected by a passphrase. It's used once, to unlock the key here; from then on the Keychain protects it, behind Face ID when required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist mit einer Passphrase geschützt. Sie wird hier einmal verwendet, um ihn zu entsperren; danach schützt ihn der Schlüsselbund, auf Wunsch hinter Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave está protegida con una frase de contraseña. Se usa una sola vez, aquí, para desbloquearla; a partir de entonces la protege el llavero, con Face ID si lo pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est protégée par une phrase secrète. Elle ne sert qu’une fois, ici, pour déverrouiller la clé ; ensuite, le trousseau la protège, derrière Face ID si vous l’exigez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この鍵はパスフレーズで保護されています。パスフレーズは読み込み時に一度だけ使い、以降の鍵はキーチェーンが保護します（Face ID を要求している場合は Face ID も）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 암호 문구로 보호되어 있습니다. 암호 문구는 키를 열 때 여기서 한 번만 쓰이고, 이후에는 키체인이 키를 보호합니다. Face ID를 요구하도록 설정했다면 Face ID도 거칩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave é protegida por uma frase-senha. Ela é usada uma vez, aqui, para desbloquear a chave; depois disso, as Chaves a protegem, com Face ID quando exigido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把密钥设了口令。口令只在导入时用一次，解开后密钥存进钥匙串，开了「需要 Face ID」就得先过 Face ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把金鑰設了密碼短語。密碼短語只在匯入時用一次，解開後金鑰存進鑰匙圈，開了「需要 Face ID」就得先過 Face ID。"
          }
        }
      }
    },
    "This key isn't on this iPhone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel ist nicht auf diesem iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave no está en este iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé n'est pas sur cet iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーはこの iPhone にありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 이 iPhone에 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave não está neste iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上没有这把密钥"
          }
