    "Display what the agent is running/asking — off keeps it private": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが実行中の内容や問いかけを表示します——オフにすると非表示のままです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示智能体正在跑什么、在问什么——关掉则保持私密"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Double tap to switch between SSH and Mosh": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで SSH と Mosh を切り替えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击可在 SSH 与 Mosh 之间切换"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "Download a model": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载模型"
          }
        }
      }
    },
    "Downloading %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をダウンロード中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 %@"
          }
        }
      }
    },
    "Downloads a model. Around 100 languages, and copes with a sentence that mixes two.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのダウンロードが必要。約 100 言語に対応し、1 つの文に 2 言語が混在しても処理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需下载模型。覆盖约 100 种语言，一句话里混用两种也能听准。"
          }
        }
      }
    },
    "Drag toward a direction to send an arrow key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方向へドラッグして矢印キーを送信"
          }
