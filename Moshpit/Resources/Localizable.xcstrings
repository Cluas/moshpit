    "herdr on the host's PATH is %@, its server %@ — update that copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr im PATH des Hosts ist %1$@, sein Server %2$@ – aktualisiere diese Kopie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El herdr del PATH del host es %1$@ y su servidor, %2$@: actualiza esa copia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le herdr du PATH de l’hôte est en %1$@, son serveur en %2$@ : mettez cette copie à jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストの PATH 上の herdr は %1$@、サーバーは %2$@ です。PATH 上の herdr を更新してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 PATH의 herdr는 %1$@, 서버는 %2$@입니다. PATH의 herdr를 업데이트하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
