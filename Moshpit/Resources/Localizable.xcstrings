    },
    "Can't re-check over this transport — reconnect to apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diesen Transport ist keine erneute Prüfung möglich. Verbinde dich neu, damit es wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede volver a comprobar por este transporte. Reconecta para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de revérifier via ce transport. Reconnectez-vous pour appliquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトランスポートでは再チェックできません — 再接続して適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전송 방식으로는 다시 확인할 수 없습니다. 다시 연결하면 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não dá para verificar de novo por este transporte. Reconecte para aplicar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前传输方式下没法重新检测。重新连接后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的傳輸方式沒辦法重新偵測。重新連線後生效。"
          }
        }
      }
    },
    "Can't start with “-” or “/”, or end with “/”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf nicht mit „-“ oder „/“ beginnen und nicht mit „/“ enden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede empezar por «-» ni «/», ni terminar en «/»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne peut pas commencer par « - » ou « / », ni finir par « / »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「-」「/」で始めたり、「/」で終わることはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“-”나 “/”로 시작하거나 “/”로 끝날 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode começar com “-” ou “/”, nem terminar com “/”"
