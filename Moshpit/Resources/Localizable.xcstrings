            "state": "translated",
            "value": "下划线"
          }
        }
      }
    },
    "Unsupported SSH key type: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていない SSH 鍵タイプ:%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的 SSH 密钥类型:%@"
          }
        }
      }
    },
    "Use Mosh": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosh を使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mosh"
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名"
          }
        }
      }
    },
    "VOICE INPUT": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入"
          }
        }
      }
    },
    "Vibe Island": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Island"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Island"
          }
        }
      }
    },
    "WEAK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱い"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弱"
          }
        }
      }
    },
    "When a tmux pane rings the terminal bell (BEL) — which Claude Code and most CLIs emit when they finish or need input — Moshpit posts a local notification and flips the Vibe Island to “needs attention.”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux ペインがターミナルベル（BEL）を鳴らすと——Claude Code やほとんどの CLI は完了時や入力待ちで発します——Moshpit はローカル通知を送り、Vibe Island を「要注意」に切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 tmux 窗格触发终端响铃（BEL）——Claude Code 和多数 CLI 在完成或需要输入时都会发出——Moshpit 会发送本地通知，并把 Vibe Island 切换为“需要关注”。"
          }
        }
      }
    },
    "When bound, this key is used only for the selected hosts by default; change it anytime in the SSH Keys detail page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バインドすると、このキーはデフォルトで選択したホストにのみ使われます。SSH キーの詳細ページでいつでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定后此密钥默认仅用于所选主机；可在 SSH Keys 详情页随时改动。"
          }
        }
      }
    },
    "While a session is attached, the Dynamic Island shows whether the agent is working, idle, or waiting on you. Tapping it deep-links straight back to that pane.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションのアタッチ中、Dynamic Island はエージェントが作業中・アイドル・あなた待ちのいずれかを表示します。タップするとそのペインへ直接ジャンプします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话附加期间，灵动岛会显示智能体正在工作、空闲，还是在等你。点按即可直接深链回到该窗格。"
          }
        }
      }
    },
    "Wi-Fi → 5G": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi → 5G"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi → 5G"
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口"
          }
        }
      }
    },
    "Wrap SSH with mosh-server (UDP)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH を mosh-server (UDP) でラップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接时用 mosh-server (UDP) 包装 SSH"
          }
        }
      }
    },
    "Wrap new SSH hosts with mosh-server on connect": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい SSH ホストを接続時に mosh-server でラップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建 SSH 主机连接时自动用 mosh-server 包装"
          }
        }
      }
    },
    "Your servers, on call.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのサーバー、いつでもオンコール。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器，随叫随到。"
          }
        }
      }
    },
    "attached": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アタッチ済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已附加"
          }
        }
      }
    },
    "connection": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "detached": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デタッチ済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分离"
          }
        }
      }
    },
    "done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "idle": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲"
          }
        }
      }
    },
    "mosh binds one UDP port in this range per session. Open it outbound from your iPhone and inbound on the server (default 60000–61000).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh はセッションごとにこの範囲の UDP ポートを 1 つバインドします。iPhone 側は送信方向、サーバー側は受信方向で開放してください（デフォルト 60000–61000）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 每个会话会在此范围内绑定一个 UDP 端口。请在 iPhone 出方向和服务器入方向开放（默认 60000–61000）。"
          }
        }
