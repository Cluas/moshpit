    "In Key Combo mode the payload is the escape sequence sent to the PTY, honoring the mosh / tmux transcription rules.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Modus „Tastenkombination“ ist der Inhalt die Escape-Sequenz, die ans PTY geht, gemäß den Umsetzungsregeln von mosh und tmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo Combinación, el contenido es la secuencia de escape que se envía al PTY, siguiendo las reglas de transcripción de mosh y tmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Combinaison, le contenu est la séquence d’échappement envoyée au PTY, selon les règles de transcription de mosh et tmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Key Combo モードではペイロードは PTY へ送るエスケープシーケンスで、mosh / tmux の転写規則に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 조합 모드에서는 내용이 PTY로 보내는 이스케이프 시퀀스이며, mosh / tmux 변환 규칙을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo Combinação, o conteúdo é a sequência de escape enviada ao PTY, seguindo as regras de transcrição do mosh e do tmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「按键组合」模式下，内容就是发给 PTY 的转义序列，会按 mosh / tmux 的转写规则处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「按鍵組合」模式下，內容就是送給 PTY 的跳脫序列，會按 mosh / tmux 的轉寫規則處理。"
          }
        }
      }
    },
    "In Key Combo mode the payload is the escape sequence sent to the PTY, honoring the transport transcription rules.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Modus „Tastenkombination“ ist der Inhalt die Escape-Sequenz, die ans PTY geht, gemäß den Umsetzungsregeln des Transports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo Combinación, el contenido es la secuencia de escape que se envía al PTY, siguiendo las reglas de transcripción del transporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Combinaison, le contenu est la séquence d’échappement envoyée au PTY, selon les règles de transcription du transport."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーの組み合わせ」モードでは、ペイロードは PTY に送るエスケープシーケンスであり、トランスポートの変換ルールに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 조합 모드에서는 내용이 PTY로 보내는 이스케이프 시퀀스이며, 전송 방식의 변환 규칙을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo Combinação, o conteúdo é a sequência de escape enviada ao PTY, seguindo as regras de transcrição do transporte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「按键组合」模式下，内容就是发给 PTY 的转义序列，会按传输方式的转写规则处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「按鍵組合」模式下，內容就是送給 PTY 的跳脫序列，會按傳輸方式的轉寫規則處理。"
          }
        }
      }
    },
