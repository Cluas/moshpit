    "Hardware-backed keys cannot be exported; every signature triggers Face ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardwaregeschützte Schlüssel lassen sich nicht exportieren; jede Signatur verlangt Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves protegidas por hardware no se pueden exportar; cada firma pide Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés protégées par le matériel ne peuvent pas être exportées ; chaque signature demande Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェア保護されたキーは書き出せません。署名のたびに Face ID が起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어에 보관된 키는 내보낼 수 없으며, 서명할 때마다 Face ID를 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves protegidas por hardware não podem ser exportadas; cada assinatura pede Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥存在安全芯片里，导不出来，每次签名都要过 Face ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰存在安全晶片裡，拿不出來，每次簽章都要過 Face ID。"
          }
        }
      }
    },
