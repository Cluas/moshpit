    "Can't re-check over this transport — reconnect to apply.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトランスポートでは再チェックできません — 再接続して適用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前传输方式无法重新检测 — 请重新连接以生效。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
