    "\"%@\" has uncommitted changes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に未コミットの変更があります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 有未提交的改动"
          }
        }
      }
    },
