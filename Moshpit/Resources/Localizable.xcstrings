    "Duplicate a built-in theme to start from its palette, or import one as JSON. Long-press a theme for more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dupliziere ein integriertes Farbschema, um von seiner Palette auszugehen, oder importiere eins als JSON. Halte ein Farbschema gedrückt für weitere Optionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplica un tema integrado para partir de su paleta, o importa uno en JSON. Mantén pulsado un tema para ver más opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dupliquez un thème intégré pour partir de sa palette, ou importez-en un en JSON. Maintenez un thème appuyé pour plus d’options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵テーマを複製してその配色から始めるか、JSON で読み込みます。テーマを長押しすると他の操作が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 테마를 복제해 그 색상에서 시작하거나, JSON으로 가져오세요. 테마를 길게 누르면 더 많은 동작이 나옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplique um tema integrado para começar pela paleta dele, ou importe um em JSON. Segure um tema para ver mais opções."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制一个内置主题即可基于它的配色开始，也可以导入 JSON。长按主题可看到更多操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製一個內建主題，就能從它的配色開始改，也可以匯入 JSON。長按主題可看到更多操作。"
          }
        }
      }
    },
