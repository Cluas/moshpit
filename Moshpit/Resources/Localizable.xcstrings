    "As text in the light appearance this color is too pale, so the app darkens it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Text im hellen Erscheinungsbild ist diese Farbe zu blass, deshalb dunkelt die App sie dort ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como texto en la apariencia clara este color es demasiado pálido, así que la app lo oscurece ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En texte dans l’apparence claire, cette couleur est trop pâle : l’app la fonce à cet endroit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この色はライトモードの文字には淡すぎるため、アプリが自動で濃くします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상은 라이트 모드의 글자로는 너무 옅어서 앱이 자동으로 진하게 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como texto na aparência clara esta cor fica clara demais, então o app a escurece ali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个颜色在浅色外观下做文字会偏淡，系统会自动调深。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個顏色在淺色外觀下當文字會偏淡，系統會自動調深。"
          }
        }
      }
    },
