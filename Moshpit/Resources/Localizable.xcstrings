    "Couldn't reach the host. Check the connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host nicht erreichbar. Prüfe die Verbindung und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el host. Revisa la conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’hôte. Vérifiez la connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストに接続できません。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o host. Confira a conexão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上主机。检查一下连接再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不到主機。請檢查連線後再試一次。"
          }
        }
      }
    },
    "Couldn't reach the server. Check the host, port, and that it's online.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar. Prüfe Host und Port und ob er online ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el servidor. Comprueba el host, el puerto y que esté en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur. Vérifiez l’hôte, le port et qu’il est en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。ホスト、ポート、サーバーが稼働しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 호스트와 포트, 서버가 켜져 있는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o servidor. Confira o host, a porta e se ele está online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务器。检查一下主机、端口，以及服务器是否在线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上伺服器。檢查一下主機、連接埠，以及伺服器是否上線。"
          }
        }
      }
    },
