    "Update the hooks for %@ first: the test runs what this version of Moshpit installs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere zuerst die Hooks für %@: Der Test führt aus, was diese Moshpit-Version installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza primero los hooks de %@: la prueba ejecuta lo que instala esta versión de Moshpit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez d’abord à jour les hooks de %@ : le test exécute ce qu’installe cette version de Moshpit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に %@ のフックを更新してください。テストはこのバージョンの Moshpit がインストールするものを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 %@ 훅을 업데이트하세요. 테스트는 이 버전의 Moshpit이 설치하는 것을 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize primeiro os hooks de %@: o teste executa o que esta versão do Moshpit instala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先更新 %@ 的状态脚本：测试运行的是这个版本的 Moshpit 装的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先更新 %@ 的狀態腳本：測試執行的是這個版本的 Moshpit 裝的內容。"
          }
        }
      }
    },
