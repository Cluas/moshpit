    "Names can't contain line breaks or other control characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen dürfen keine Zeilenumbrüche oder anderen Steuerzeichen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres no pueden contener saltos de línea ni otros caracteres de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ne peut pas contenir de saut de ligne ni d’autres caractères de contrôle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に改行やその他の制御文字は使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에는 줄바꿈이나 다른 제어 문자를 넣을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes não podem ter quebras de linha nem outros caracteres de controle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称里不能有换行或其他控制字符。"
