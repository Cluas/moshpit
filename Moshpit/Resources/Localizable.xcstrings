        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait passer cette connexion par un proxy SOCKS5 local ou d’entreprise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続をローカルまたは社内の SOCKS5 プロキシ経由にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결을 로컬 또는 회사 SOCKS5 프록시로 보냅니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roteia esta conexão por um proxy SOCKS5 local ou corporativo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让这个连接走本地或公司的 SOCKS5 代理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓這個連線走本機或公司的 SOCKS5 代理伺服器"
          }
        }
      }
    },
    "Run an agent turn in any pane, then re-check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass einen Agent in irgendeinem Panel eine Runde laufen und prüfe dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un turno de agente en cualquier panel y vuelve a comprobarlo."
          }
        },
        "fr": {
