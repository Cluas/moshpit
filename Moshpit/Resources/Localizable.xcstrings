    "Couldn't reach %@ on your local network. Check that it's on, and that Moshpit may use the local network: Settings → Privacy & Security → Local Network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ im lokalen Netzwerk ist nicht erreichbar. Prüfe, ob das Gerät eingeschaltet ist und ob Moshpit das lokale Netzwerk verwenden darf: „Einstellungen“ → „Datenschutz & Sicherheit“ → „Lokales Netzwerk“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con %@ en tu red local. Comprueba que esté encendido y que Moshpit pueda usar la red local: Ajustes → Privacidad y seguridad → Red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@ sur votre réseau local. Vérifiez qu’il est allumé, et que Moshpit peut utiliser le réseau local : Réglages → Confidentialité et sécurité → Réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク上の %@ に接続できません。電源が入っているかと、Moshpit にローカルネットワークの使用を許可しているかを確認してください（「設定 → プライバシーとセキュリティ → ローカルネットワーク」）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크의 %@ 호스트에 연결할 수 없습니다. 기기가 켜져 있는지, Moshpit이 로컬 네트워크를 사용할 수 있는지 확인하세요: 설정 → 개인정보 보호 및 보안 → 로컬 네트워크."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar %@ na sua rede local. Confira se ele está ligado e se o Moshpit pode usar a rede local: Ajustes → Privacidade e Segurança → Rede Local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上本地网络里的 %@。确认它开着机，并确认 Moshpit 可以使用本地网络：「设置 → 隐私与安全性 → 本地网络」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上區域網路裡的 %@。確認它有開機，並確認 Moshpit 可以使用區域網路：「設定 → 隱私權與安全性 → 區域網路」。"
          }
        }
      }
    },
    "Couldn't reach the SOCKS proxy at %@. Check that it's running, and its host and port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SOCKS-Proxy unter %@ ist nicht erreichbar. Prüfe, ob er läuft und ob Host und Port stimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el proxy SOCKS en %@. Comprueba que esté en marcha y que el host y el puerto sean correctos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le proxy SOCKS à l’adresse %@. Vérifiez qu’il est lancé, ainsi que son hôte et son port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の SOCKS プロキシに接続できませんでした。プロキシが動いているか、ホストとポートが正しいか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 SOCKS 프록시에 연결할 수 없습니다. 프록시가 실행 중인지, 호스트와 포트가 맞는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o proxy SOCKS em %@. Confira se ele está rodando e se o host e a porta estão certos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上 %@ 上的 SOCKS 代理。看看代理有没有在运行，主机和端口有没有填错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上 %@ 上的 SOCKS 代理伺服器。看看它有沒有在執行，主機和連接埠有沒有填錯。"
          }
        }
      }
    },
