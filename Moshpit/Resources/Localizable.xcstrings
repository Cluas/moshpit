    "Mail isn’t set up on this device. Copy the address and write from anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist Mail nicht eingerichtet. Kopiere die Adresse und schreib uns von wo du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
