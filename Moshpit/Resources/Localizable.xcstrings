    "iOS hasn't issued a push token to this phone yet — check that notifications are allowed, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat diesem iPhone noch kein Push-Token ausgestellt. Prüfe, ob Mitteilungen erlaubt sind, und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS aún no ha emitido un token push para este teléfono. Comprueba que las notificaciones estén permitidas y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas encore délivré de jeton push à cet iPhone. Vérifiez que les notifications sont autorisées, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がまだこの iPhone にプッシュトークンを発行していません。通知が許可されているか確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 아직 이 휴대폰에 푸시 토큰을 발급하지 않았습니다. 알림이 허용되어 있는지 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS ainda não emitiu um token de push para este celular. Confira se as notificações estão permitidas e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 还没给这台手机发推送令牌。确认已允许通知，再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 還沒發推播權杖給這部手機。確認已允許通知，再試一次。"
          }
        }
      }
    },
