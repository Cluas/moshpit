    "“%@” and everything in it will be deleted from the host.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und alles darin wird vom Host gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán del host «%@» y todo lo que contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et tout son contenu seront supprimés de l’hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストから %@ とその中身がすべて削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에서 %@ 폴더와 그 안의 모든 항목이 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e tudo o que há dentro serão apagados do host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从主机上删除 %@ 和里面的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會從主機上刪除 %@ 和裡面的所有內容。"
          }
        }
      }
    },
    "“%@” will be deleted from the host.": {
