    "mosh-server didn't start within %lld seconds. A startup file on the host may be waiting for input.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server ist nicht innerhalb von %lld Sekunden gestartet. Vielleicht wartet ein Startskript auf dem Host auf eine Eingabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server no se inició en %lld segundos. Puede que un script de inicio del host esté esperando una entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server n’a pas démarré dans les %lld secondes. Un script de démarrage de l’hôte attend peut-être une saisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server が %lld 秒以内に起動しませんでした。ホストの起動スクリプトが入力を待っている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server가 %lld초 안에 시작되지 않았습니다. 호스트의 시작 스크립트가 입력을 기다리고 있을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mosh-server não iniciou em %lld segundos. Talvez um script de inicialização do host esteja esperando uma entrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server 在 %lld 秒内没有启动。主机上的某个启动脚本可能在等输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server 在 %lld 秒內沒有啟動。主機上的某個啟動腳本可能在等輸入。"
          }
        }
      }
    },
    "mosh-server didn't start: it never said where to reach it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server ist nicht gestartet: Er hat nie gesagt, wo er erreichbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server no se inició: nunca indicó dónde conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server n’a pas démarré : il n’a jamais indiqué où le joindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server が起動しませんでした。接続先を知らせてきませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server가 시작되지 않았습니다. 접속할 위치를 알려 주지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mosh-server não iniciou: ele nunca informou onde se conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server 没有启动：它一直没说该从哪里连它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh-server 沒有啟動：它一直沒說該從哪裡連它。"
          }
        }
      }
    },
