    "Copies the agent's config to a timestamped backup before merging Moshpit's hook groups.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert die Konfiguration des Agents in ein Backup mit Zeitstempel, bevor die Hooks von Moshpit eingefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la configuración del agente a un respaldo con marca de tiempo antes de añadir los hooks de Moshpit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie la configuration de l’agent dans une sauvegarde horodatée avant d’y ajouter les hooks de Moshpit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit のフックを統合する前に、エージェントの設定をタイムスタンプ付きでバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit 훅을 합치기 전에 에이전트 설정을 시간 기록이 붙은 백업으로 복사합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia a configuração do agente para um backup com data e hora antes de incluir os hooks do Moshpit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入 Moshpit 的状态脚本前，先把智能体的配置文件备份一份，文件名带时间戳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入 Moshpit 的狀態腳本前，先把智能體的設定檔備份一份，檔名帶時間戳記。"
          }
        }
      }
    },
