    "Deletes the branch checkout under ~/.herdr/worktrees. %@ itself is untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den Branch-Checkout unter ~/.herdr/worktrees. %@ selbst bleibt unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el checkout de la rama en ~/.herdr/worktrees. %@ en sí no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le checkout de la branche dans ~/.herdr/worktrees. %@ lui-même n’est pas touché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.herdr/worktrees 配下のブランチのチェックアウトのみを削除します。%@ 自体はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.herdr/worktrees 아래의 브랜치 체크아웃만 삭제합니다. %@ 자체는 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga o checkout da branch em ~/.herdr/worktrees. %@ em si não é alterado."
