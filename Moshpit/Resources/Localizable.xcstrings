            "state": "translated",
            "value": "No puede terminar en «.lock»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne peut pas finir par « .lock »"
          }
        },
        "ja": {
          "stringUnit": {
