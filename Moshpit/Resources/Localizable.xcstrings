    "Your answer was passed to the host. It takes effect if the agent is still waiting on that question.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antwort wurde an den Host übergeben. Sie wirkt, wenn der Agent noch auf diese Frage wartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta se pasó al host. Surtirá efecto si el agente sigue esperando esa pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse a été transmise à l’hôte. Elle prendra effet si l’agent attend toujours sur cette question."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答をホストに渡しました。エージェントがまだその問いで待っていれば反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변을 호스트에 전달했습니다. 에이전트가 아직 그 질문에서 기다리고 있다면 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua resposta foi passada ao host. Ela vale se o agente ainda estiver esperando essa pergunta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答已交给主机。若智能体仍停在那个提问上，回答就会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答已交給主機。如果 agent 還停在那個提問上，回答就會生效。"
          }
        }
      }
    },
    "Your servers, on call.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Server, immer erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus servidores, siempre a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos serveurs, toujours joignables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのサーバー、いつでもオンコール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 서버, 언제든 호출."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus servidores, sempre à mão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器，随叫随到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器，隨時待命。"
          }
        }
      }
    },
    "Your tap didn't reach the agent — open Moshpit and answer there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tipp hat den Agent nicht erreicht. Öffne Moshpit und antworte dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta no llegó al agente. Abre Moshpit y responde desde allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse n’a pas atteint l’agent. Ouvrez Moshpit et répondez depuis l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップがエージェントに届きませんでした——Moshpit を開いて操作してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭한 내용이 에이전트에 닿지 않았습니다. Moshpit을 열어 거기서 답하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu toque não chegou ao agente. Abra o Moshpit e responda por lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有送达智能体。打开 Moshpit，在里面回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有送到 agent 那邊。打開 Moshpit，在裡面回答。"
          }
        }
      }
    },
