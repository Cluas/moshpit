      }
    },
    "Whisper can't transcribe until one is on the device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Modell auf dem Gerät kann Whisper nichts umwandeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper no puede transcribir hasta que haya uno en el dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper ne peut rien transcrire sans modèle sur l’appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが端末にないと Whisper は書き起こせません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 모델이 있어야 Whisper가 동작합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisper não transcreve até ter um modelo no aparelho"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有模型，Whisper 就没法转写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有模型，Whisper 就無法轉寫"
          }
        }
      }
    },
    "Whisper decides from what it hears": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper entscheidet nach dem, was es hört"
          }
