    "Uploads images to the agent's server and hands it the file paths.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Bilder auf den Server des Agents und übergibt ihm die Dateipfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las imágenes al servidor del agente y le pasa las rutas de los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les images sur le serveur de l’agent et lui transmet les chemins des fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をエージェントのサーバーにアップロードし、ファイルパスを渡します。"
