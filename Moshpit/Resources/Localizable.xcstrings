{
  "sourceLanguage": "en",
  "strings": {
    "%@ · runs %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ を実行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 运行 %2$@"
          }
        }
      }
    },
    "%@ · sends %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ を送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 发送 %2$@"
          }
        }
      }
    },
    "%@ · types \"%@\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · \"%2$@\" を入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 键入 \"%2$@\""
