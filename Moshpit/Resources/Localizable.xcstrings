        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换智能体"
          }
        }
      }
    },
    "Switch to %@?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に切り替えますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到 %@？"
          }
        }
      }
    },
    "Switch to SSH": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH に切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到 SSH"
          }
        }
      }
    },
    "TASK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    },
    "TERMINAL": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        }
      }
    },
    "THE PIT NEVER CLOSES": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピットは閉じない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器不眠"
          }
        }
      }
    },
    "THIS DEVICE · SECURE ENCLAVE": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス · SECURE ENCLAVE"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 · SECURE ENCLAVE"
          }
        }
      }
    },
    "TRIGGER": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发"
          }
        }
      }
    },
    "TYPE": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        }
      }
    },
    "Tab": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页"
          }
        }
      }
    },
    "Tabs": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页"
          }
        }
      }
    },
    "Tap a preset to fill the trigger — tmux prefixes, control chords, special & navigation keys, F-keys. Then tweak the chip label / color below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットをタップするとトリガーが入力されます——tmux プレフィックス、Control コード、特殊キーと移動キー、F キー。その後、下でチップのラベルと色を調整します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一个预设即可填入触发键——tmux 前缀、Control 组合、特殊键与方向键、F 键。之后在下面调整键帽文字和颜色。"
          }
        }
      }
    },
    "Tap modifiers to toggle them and enter a single character as the main key; the mobile keyboard triggers the raw scancode automatically.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーをタップして切り替え、メインキーは 1 文字で入力します。モバイルキーボードは生のスキャンコードを自動送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击修饰键开关，单字符键输入主键；移动键盘会自动触发原始 scancode。"
          }
        }
      }
    },
    "Tap to focus pane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでペインにフォーカス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按聚焦窗格"
          }
        }
      }
    },
    "Tap to focus · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでフォーカス · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按聚焦 · %@"
          }
        }
      }
    },
    "Tap to switch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按切换"
          }
        }
      }
    },
    "Tap ＋ in the top right to create a custom shortcut — key combos, text snippets, and command chains.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋でカスタムショートカットを作成 — キーコンボ、テキストスニペット、コマンドチェーンに対応。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右上 ＋ 新建自定义快捷键 — 支持按键组合、文本片段、命令链。"
          }
        }
      }
    },
    "Tap ＋ to add your first server. Moshpit keeps your sessions alive across Wi-Fi / 5G handoff.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして最初のサーバーを追加。Moshpit は Wi-Fi / 5G の切り替えをまたいでセッションを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 添加第一台服务器。Moshpit 会在 Wi-Fi / 5G 切换时保持会话不断线。"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本"
          }
        }
      }
    },
    "That doesn't look like theme JSON. Paste an exported theme, or an object with \"background\", \"foreground\" and the eight ANSI color names.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの JSON ではないようです。書き出したテーマ、または \"background\"・\"foreground\" と 8 つの ANSI カラー名を持つオブジェクトを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不是主题 JSON。请粘贴导出的主题，或一个带 “background”、“foreground” 和八个 ANSI 颜色名的对象。"
          }
        }
      }
    },
    "That request was already answered or has changed — nothing was sent. Open Moshpit to see the current state.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのリクエストは既に回答済みか変化しています——何も送信されていません。Moshpit を開いて現在の状態を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那个请求已经被回应过、或者状态变了——什么都没发出去。打开 Moshpit 看当前状态。"
          }
        }
      }
    },
    "The %@ speech model didn't download completely. Remove it and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の音声モデルを完全にダウンロードできませんでした。削除してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 语音模型没有下载完整。请删除后重试。"
          }
        }
      }
    },
    "The %@ speech model isn't downloaded yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の音声モデルはまだダウンロードされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 语音模型还没有下载。"
          }
        }
      }
    },
    "The accent color tints the app's controls and highlights. The home-screen icon is a separate choice. Both are separate from the terminal color scheme (Display → Theme, below).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセントカラーはアプリのコントロールとハイライトに適用されます。ホーム画面のアイコンは別の設定です。どちらもターミナルの配色（下の「表示 → テーマ」）とは無関係です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调色作用于 App 的控件和高亮。主屏图标是另一项独立选择。两者都与终端配色无关（终端配色在下面的「显示 → 主题」）。"
          }
        }
      }
    },
    "The connection failed for a reason Moshpit didn't recognise. Check the host, port and that the server is reachable, then try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moshpit が識別できない理由で接続に失敗しました。ホスト・ポート・サーバーに到達できるかを確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败，原因 Moshpit 没能识别。请检查主机、端口以及服务器是否可达，然后重试。"
          }
        }
      }
    },
    "The hooks only stamp the tmux pane and exit 0 — Claude is never slowed, prompted, or interrupted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは tmux ペインに印を付けて exit 0 で終了するだけで、Claude を遅延・中断・プロンプト表示することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钩子只会给 tmux 窗格打标记并以 exit 0 退出——绝不会拖慢、打断 Claude 或弹出提示。"
          }
        }
      }
    },
    "The hooks only stamp the tmux pane and exit 0 — the agent is never slowed, prompted, or interrupted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは tmux ペインに印を付けて exit 0 するだけです——エージェントが遅くなったり、確認を求められたり、中断されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 hook 只在 tmux 窗格上打个标记然后 exit 0——不会让智能体变慢、不会弹提示、也不会打断它。"
          }
        }
      }
    },
    "The icon is separate from the accent color, because iOS only allows switching between icons bundled with the app — a custom accent can't have matching artwork generated for it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンとアクセントカラーは別の設定です。iOS はアプリに同梱されたアイコン間の切り替えしか許可しないため、カスタムアクセントに合わせた画像を生成することはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标和强调色是分开的，因为 iOS 只允许在随 App 打包的图标之间切换——自定义强调色没法自动生成配套图稿。"
          }
        }
      }
    },
    "The key for %@:%@ does **not** match what's stored here. The server may have been reinstalled — or the connection is being intercepted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ のキーは、ここに保存されているものと**一致しません**。サーバーが再インストールされた可能性——あるいは接続が傍受されている可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 的密钥与此处存储的**不一致**。可能是服务器重装了——也可能连接正被中间人截获。"
          }
        }
      }
    },
    "The key for %@:%lld does NOT match the one stored on this device. This can mean the server was reinstalled — or that the connection is being intercepted.\n\nStored: %@\nNew: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld のキーがこのデバイスに保存されたものと一致しません。サーバーが再インストールされたか、接続が傍受されている可能性があります。\n\n保存済み：%3$@\n新規：%4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld 的密钥与本设备存储的不一致。这可能意味着服务器被重装——也可能是连接正被拦截。\n\n已存储：%3$@\n新密钥：%4$@"
          }
        }
      }
    },
    "The mosh-server executable on the remote host. Override if it isn't on PATH (e.g. /opt/homebrew/bin/mosh-server).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートホスト上の mosh-server 実行ファイル。PATH にない場合はここで上書きします（例: /opt/homebrew/bin/mosh-server）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机上的 mosh-server 可执行文件。若不在 PATH 中可在此覆盖（如 /opt/homebrew/bin/mosh-server）。"
          }
        }
      }
    },
    "The pressed state and the background wash are derived from this one color.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押下時の状態と背景のごく淡い色は、この 1 色から算出されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下态和背景微光都由这一个颜色推导。"
          }
        }
      }
    },
    "The server closed the connection while setting up SSH. Check that the port really is an SSH server, and that a firewall or proxy isn't cutting the connection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH の確立中にサーバーが接続を閉じました。そのポートが本当に SSH サーバーであること、ファイアウォールやプロキシが接続を切断していないことを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器在建立 SSH 的过程中关闭了连接。请确认该端口确实是 SSH 服务，并且没有防火墙或代理在切断连接。"
          }
        }
      }
    },
    "The server rejected this sign-in method. Try a different one (e.g. a key instead of a password).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこのサインイン方法を拒否しました。別の方法をお試しください(例:パスワードの代わりに鍵)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这种登录方式。请换一种(例如用密钥代替密码)。"
          }
        }
      }
    },
    "The worktree was created but has no pane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーは作成されましたが、ペインがありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树已创建，但没有窗格"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "Theme name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ名"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题名称"
          }
        }
      }
    },
    "Theme preview": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマのプレビュー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题预览"
          }
        }
      }
    },
    "These eight are what shells, diffs and TUIs paint with.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェル・diff・TUI が使うのはこの 8 色です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "shell、diff 和 TUI 用的就是这八种颜色。"
          }
        }
      }
    },
    "This accent will be removed. Built-in accents are unaffected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクセントを削除します。内蔵アクセントには影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该强调色会被移除。内置强调色不受影响。"
          }
        }
      }
    },
    "This server has no running %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーで実行中の %@ はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器上没有正在运行的 %@。"
          }
        }
      }
    },
    "This server has no running %@.\nMoshpit only attaches — create the first one to start.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーで実行中の %@ はありません。\nMoshpit はアタッチのみ行います——まず 1 つ作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器上没有正在运行的 %@。\nMoshpit 只做附加——先创建第一个才能开始。"
          }
        }
      }
    },
    "This server has no running sessions.\nMoshpit only attaches — create the first one to start.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーには実行中のセッションがありません。\nMoshpit はアタッチのみ行います — 最初のセッションを作成して始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务器上没有正在运行的会话。\nMoshpit 只做附加 — 创建第一个会话以开始。"
          }
        }
      }
    },
    "This theme will be removed. Built-in themes are unaffected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマを削除します。内蔵テーマには影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该主题会被移除。内置主题不受影响。"
          }
        }
      }
    },
    "Those changes exist nowhere else. Removing the worktree throws them away.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの変更は他のどこにも存在しません。ワークツリーを削除すると失われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些改动别处没有副本。删掉工作树就等于丢弃它们。"
          }
        }
      }
    },
    "Tiny": {
      "localizations": {
        "ja": {
          "stringUnit": {
