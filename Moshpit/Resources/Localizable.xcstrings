    "mosh binds one UDP port in this range per session. Open it outbound from your iPhone and inbound on the server (default 60000–61000).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh belegt pro Sitzung einen UDP-Port aus diesem Bereich. Gib ihn ausgehend auf dem iPhone und eingehend auf dem Server frei (Standard 60000–61000)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh ocupa un puerto UDP de este rango por sesión. Ábrelo en salida desde tu iPhone y en entrada en el servidor (por omisión 60000–61000)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh occupe un port UDP de cette plage par session. Ouvrez-la en sortie depuis votre iPhone et en entrée sur le serveur (par défaut 60000–61000)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh はセッションごとにこの範囲の UDP ポートを 1 つバインドします。iPhone 側は送信方向、サーバー側は受信方向で開放してください（デフォルト 60000–61000）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh는 세션마다 이 범위에서 UDP 포트 하나를 사용합니다. iPhone에서는 나가는 방향, 서버에서는 들어오는 방향으로 열어 주세요(기본값 60000–61000)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mosh ocupa uma porta UDP desta faixa por sessão. Abra na saída do seu iPhone e na entrada do servidor (padrão 60000–61000)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 mosh 会话会在这段范围里占一个 UDP 端口。服务器要放开入站，iPhone 这边要放开出站（默认 60000–61000）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個 mosh 工作階段會在這段範圍裡占一個 UDP 連接埠。伺服器要開放進站，iPhone 這邊要開放出站（預設 60000–61000）。"
          }
        }
      }
    },
    "mosh isn't installed on this host.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh ist auf diesem Host nicht installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh no está instalado en este host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh n’est pas installé sur cet hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストに mosh がインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에 mosh가 설치되어 있지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mosh não está instalado neste host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机上没装 mosh。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台主機上沒裝 mosh。"
          }
        }
      }
    },
    "mosh keeps the line up · sessions survive the handoff": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh hält die Leitung · Sitzungen überstehen den Wechsel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh mantiene la línea · las sesiones sobreviven al cambio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh garde la ligne · les sessions survivent au changement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh が接続を維持 · セッションはハンドオフを乗り切ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh가 회선을 붙잡습니다 · 세션은 전환을 견딥니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o mosh segura a linha · as sessões sobrevivem à troca"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 保持链路 · 会话扛得住网络切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 撐住線路 · 工作階段扛得住網路切換"
          }
        }
      }
    },
    "mosh only": {
