    "Most accurate, especially on mixed-language speech. Needs a recent chip.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am genauesten, besonders bei gemischten Sprachen. Braucht einen aktuellen Chip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El más preciso, sobre todo con idiomas mezclados. Necesita un chip reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus précis, surtout quand les langues se mélangent. Nécessite une puce récente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も高精度。特に複数言語が混在する音声に強い。新しめのチップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 정확하며 여러 언어가 섞인 말에 특히 강합니다. 최신 칩이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mais preciso, principalmente com idiomas misturados. Precisa de um chip recente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确度最高，尤其是多语种混说。需要较新的芯片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最準確，尤其是多語言混說。需要較新的晶片。"
          }
        }
      }
    },
