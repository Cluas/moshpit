    "FAIR": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中"
          }
        }
      }
    },
    "FINISHING…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕上げ中…"
          }
        },
        "zh-Hans": {
