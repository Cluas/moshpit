    "From must be ≤ To.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Von“ darf nicht größer als „Bis“ sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Desde» no puede ser mayor que «Hasta»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« De » ne peut pas dépasser « À »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始は終了以下にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 값은 끝 값보다 클 수 없습니다."
