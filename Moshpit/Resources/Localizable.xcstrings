          }
        }
      }
    },
    "Enter numeric ports.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値のポートを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入数字端口。"
          }
        }
      }
    },
    "FAIR": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通"
          }
        },
        "zh-Hans": {
