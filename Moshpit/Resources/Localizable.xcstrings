    "Secure Enclave keys are limited to ECDSA-P256; the algorithm adjusts automatically when SE is enabled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Secure Enclave unterstützt nur ECDSA-P256; der Algorithmus wechselt automatisch, wenn du sie aktivierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Secure Enclave solo admite ECDSA-P256; el algoritmo cambia automáticamente al activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Secure Enclave n’accepte que ECDSA-P256 ; l’algorithme change automatiquement quand vous l’activez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave のキーは ECDSA-P256 に限定されます。SE を有効にするとアルゴリズムは自動調整されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave는 ECDSA-P256만 지원하므로, 켜면 알고리즘이 자동으로 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Secure Enclave só aceita ECDSA-P256; o algoritmo muda automaticamente quando você o ativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave 只支持 ECDSA-P256，开启后算法会自动切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全隔離區只支援 ECDSA-P256，開啟後演算法會自動切換。"
          }
        }
      }
    },
