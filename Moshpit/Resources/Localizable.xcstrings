    "Signing in was cancelled, so Moshpit didn't connect. Connect again to try once more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgebrochen, deshalb hat sich Moshpit nicht verbunden. Verbinde dich erneut, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló el inicio de sesión, así que Moshpit no se conectó. Vuelve a conectarte para intentarlo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identification a été annulée : Moshpit ne s’est pas connecté. Reconnectez-vous pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインがキャンセルされたため、接続しませんでした。もう一度接続すれば再試行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 취소되어 연결하지 않았습니다. 다시 연결하면 한 번 더 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login foi cancelado, então o Moshpit não se conectou. Conecte de novo para tentar outra vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已取消，没有连接。再连一次就能重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已取消，沒有連線。再連一次就能重試。"
          }
        }
      }
    },
