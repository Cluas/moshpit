    "This private key is damaged or incomplete. Copy it again, from its BEGIN line to its END line.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser private Schlüssel ist beschädigt oder unvollständig. Kopiere ihn noch einmal, von der BEGIN-Zeile bis zur END-Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave privada está dañada o incompleta. Vuelve a copiarla, desde la línea BEGIN hasta la línea END."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé privée est endommagée ou incomplète. Copiez-la de nouveau, de la ligne BEGIN à la ligne END."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この秘密鍵は壊れているか、途中で切れています。BEGIN の行から END の行までもう一度コピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 개인 키는 손상되었거나 일부가 빠져 있습니다. BEGIN 줄부터 END 줄까지 다시 복사하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave privada está danificada ou incompleta. Copie-a de novo, da linha BEGIN até a linha END."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个私钥不完整或已损坏。从 BEGIN 那一行到 END 那一行重新复制一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個私密金鑰不完整或已損壞。從 BEGIN 那一行到 END 那一行重新拷貝一次。"
          }
        }
      }
    },
    "This server uses an older host-key algorithm (%@, SHA-1).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet einen älteren Algorithmus für seinen Host-Schlüssel (%@, SHA-1)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa un algoritmo antiguo para la clave del host (%@, SHA-1)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise un ancien algorithme de clé d’hôte (%@, SHA-1)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは古いホストキーのアルゴリズム（%@、SHA-1）を使っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 오래된 호스트 키 알고리즘(%@, SHA-1)을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa um algoritmo antigo para a chave do host (%@, SHA-1)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器用的是较旧的主机密钥算法（%@，SHA-1）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器用的是較舊的主機金鑰演算法（%@，SHA-1）。"
          }
        }
      }
    },
    "This session isn't connected to the host. Reconnect, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung ist nicht mit dem Host verbunden. Verbinde sie neu und versuch es dann noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión no está conectada al host. Vuelve a conectarte y luego inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session n’est pas connectée à l’hôte. Reconnectez-la, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションはホストに接続していません。再接続してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션은 호스트에 연결되어 있지 않습니다. 다시 연결한 다음 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão não está conectada ao host. Reconecte e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个会话没有连着主机。先重新连接，再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個工作階段沒有連上主機。請先重新連線，再試一次。"
          }
        }
      }
    },
    "This theme will be removed. Built-in themes are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Farbschema wird entfernt. Integrierte Farbschemata bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema se quitará. Los temas integrados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce thème sera retiré. Les thèmes intégrés ne sont pas concernés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマを削除します。内蔵テーマには影響しません。"
