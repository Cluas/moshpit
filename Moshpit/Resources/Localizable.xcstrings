    "Idempotent: re-running de-dupes Moshpit's hooks instead of stacking them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Idempotent: Beim erneuten Ausführen werden Moshpits Hooks erkannt statt doppelt eingetragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idempotente: si lo vuelves a ejecutar, los hooks de Moshpit se reconocen en vez de duplicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idempotent : relancer l’installation reconnaît les hooks de Moshpit au lieu de les empiler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冪等です。再実行すると Moshpit のフックは重複除去され、積み重なりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 번 실행해도 안전합니다. 이미 있는 Moshpit 훅은 중복 등록되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idempotente: rodar de novo reconhece os hooks do Moshpit em vez de duplicá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以反复运行。已经装过的 hooks 会被识别出来，不会重复叠加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以反覆執行。已經裝過的 hooks 會被認出來，不會重複疊加。"
          }
        }
      }
    },
    "Images": {
      "localizations": {
