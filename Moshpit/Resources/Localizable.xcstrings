    "%@ %@ %@? Every pane in it dies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %3$@ %1$@? Jedes Panel darin wird beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿%1$@ %2$@ %3$@? Se cierran todos sus paneles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@ ? Tous ses panneaux seront fermés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？その中のすべてのペインが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ %2$@ %1$@? 안에 있는 패널이 모두 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@? Todos os painéis dentro serão encerrados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？其中每个窗格都会终止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？裡面的每個窗格都會終止。"
          }
        }
      }
    },
    "%@ %@ %@? Everything in it dies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %3$@ %1$@? Alles darin wird beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿%1$@ %2$@ %3$@? Se cierra todo lo que contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@ ? Tout son contenu sera fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？その中のすべてが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ %2$@ %1$@? 안에 있는 것이 모두 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@? Tudo dentro será encerrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？其中的一切都会终止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@？裡面的一切都會終止。"
          }
        }
      }
    },
    "%@ frees %@. You can download it again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gibt %2$@ frei. Du kannst es später wieder laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar %1$@ libera %2$@. Puedes volver a descargarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %1$@ libère %2$@. Vous pourrez le retélécharger plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を削除すると %2$@ を解放できます。後で再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 제거하면 %2$@이(가) 비워집니다. 나중에 다시 받을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ libera %2$@. Você pode baixá-lo de novo depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %1$@ 可释放 %2$@。以后可以重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %1$@ 可釋出 %2$@。之後可以再下載。"
          }
        }
      }
    },
