          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机头像上显示这个表情，不再用主机密钥生成的图案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機頭像上顯示這個表情符號，不再用主機金鑰產生的圖案。"
          }
        }
      }
    },
