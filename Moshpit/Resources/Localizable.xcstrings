    "%@ keys can't be used to sign in. Pick another key for this connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@-Schlüsseln kannst du dich nicht anmelden. Wähle für diese Verbindung einen anderen Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves %@ no sirven para iniciar sesión. Elige otra clave para esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés %@ ne permettent pas de se connecter. Choisissez une autre clé pour cette connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ キーではサインインできません。この接続には別のキーを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키로는 로그인할 수 없습니다. 이 연결에 다른 키를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves %@ não servem para iniciar sessão. Escolha outra chave para esta conexão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 密钥不能用来登录。给这个连接换一把密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 金鑰不能用來登入。替這個連線換一把金鑰。"
          }
        }
      }
    },
    "%@ needs you": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ braucht dich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te necesita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous attend"
          }
        },
        "ja": {
