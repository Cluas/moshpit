    "Connected, but the server wouldn't open a session channel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber der Server hat keinen Sitzungskanal geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero el servidor no abrió un canal de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais le serveur n’a pas ouvert de canal de session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しましたが、サーバーがセッションチャネルを開きませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결은 됐지만 서버가 세션 채널을 열어 주지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
