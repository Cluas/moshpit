    "%@ refused the connection on port %@. Check the port, and that SSH is running there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat die Verbindung auf Port %2$@ abgelehnt. Prüfe den Port und ob SSH dort läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rechazó la conexión en el puerto %2$@. Comprueba el puerto y que SSH esté en ejecución allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a refusé la connexion sur le port %2$@. Vérifiez le port et que SSH y est bien lancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ がポート %2$@ への接続を拒否しました。ポート番号と、SSH が動いているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 포트 %2$@ 연결을 거부했습니다. 포트 번호와 SSH 서버가 실행 중인지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou a conexão na porta %2$@. Confira a porta e se o SSH está rodando lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒绝了端口 %2$@ 上的连接。检查一下端口，以及那台机器上的 SSH 有没有在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒絕了連接埠 %2$@ 上的連線。檢查一下連接埠，以及那台機器上的 SSH 有沒有在執行。"
          }
        }
      }
    },
