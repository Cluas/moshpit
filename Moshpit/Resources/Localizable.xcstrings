        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にキュー済み。セッションが次にオンラインになったら届けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대기 중입니다. 세션이 다시 온라인이 되면 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila para %@. Será entregue quando a sessão voltar a ficar ativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队，等 %@ 的会话下次在线时送达。"
