    "Drag ≡ to reorder. − takes a shortcut off the toolbar; it stays under AVAILABLE. 12 items max.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe ≡, um die Reihenfolge zu ändern. − nimmt einen Kurzbefehl aus der Symbolleiste; er bleibt unter VERFÜGBAR. Höchstens 12 Einträge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra ≡ para reordenar. − quita un atajo de la barra; sigue en DISPONIBLES. Máximo 12 elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser ≡ pour réordonner. − retire un raccourci de la barre ; il reste dans DISPONIBLES. 12 éléments maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "≡ をドラッグして並べ替え。− でツールバーから外すと「利用可能」に残ります。最大 12 項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "≡를 드래그해 순서를 바꿉니다. −로 도구 막대에서 빼면 사용 가능 목록에 남습니다. 최대 12개."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ≡ para reordenar. − tira um atalho da barra; ele continua em DISPONÍVEIS. Máximo de 12 itens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖 ≡ 调顺序。点 − 把快捷键从栏上拿掉，它会留在「可用」里。最多 12 个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 ≡ 調整順序。點 − 把快速鍵從列上拿掉，它會留在「可用」裡。最多 12 個。"
          }
        }
      }
    },
    "Drag ≡ to reorder; the red − removes it from the toolbar. 12 items max.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe ≡, um die Reihenfolge zu ändern; das rote − entfernt den Eintrag aus der Symbolleiste. Höchstens 12 Einträge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra ≡ para reordenar; el − rojo lo quita de la barra de herramientas. Máximo 12 elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser ≡ pour réordonner ; le − rouge retire l’élément de la barre d’outils. 12 éléments maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "≡ をドラッグして並べ替え、赤い − でツールバーから外します。最大 12 項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "≡를 드래그해 순서를 바꾸고, 빨간 −로 도구 막대에서 뺍니다. 최대 12개."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ≡ para reordenar; o − vermelho tira da barra de ferramentas. Máximo de 12 itens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖 ≡ 调顺序，点红色 − 从快捷键栏移除。最多 12 个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 ≡ 調整順序，點紅色 − 從快速鍵列移除。最多 12 個。"
          }
        }
      }
    },
