        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Delete %@?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@？"
          }
        }
      }
    },
    "Delete Connection": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除连接"
          }
        }
      }
    },
    "Delete Key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除密钥"
          }
        }
      }
    },
    "Delete anyway": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然删除"
          }
        }
      }
    },
    "Deletes the branch checkout under ~/.herdr/worktrees. %@ itself is untouched.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.herdr/worktrees 配下のブランチのチェックアウトのみを削除します。%@ 自体はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除 ~/.herdr/worktrees 下的分支检出，%@ 本身不受影响。"
          }
        }
      }
    },
    "Deny": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "Description": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述"
          }
        }
      }
    },
    "Dictate commands and prompts from the mic key on the terminal bar. Speech is transcribed entirely on-device — your voice never leaves this device, and nothing is typed until you tap Insert.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットバーのマイクキーからコマンドやプロンプトを音声入力できます。書き起こしは完全に端末内で行われ、音声がこの端末を離れることはなく、「挿入」をタップするまで何も入力されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用快捷条上的麦克风键口述命令和 prompt。转写完全在本机完成——你的语音绝不离开这台设备，不点「插入」就不会输入任何内容。"
          }
        }
      }
    },
    "Dictate commands instead of typing. Planned for a future update.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイプの代わりに音声でコマンドを入力。今後のアップデートで提供予定です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用语音口述命令，无需打字。计划在后续版本提供。"
          }
        }
      }
    },
    "Dictation isn't available for %@ on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では %@ の音声入力を利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备不支持 %@ 的听写。"
          }
        }
      }
    },
    "Discard the partial download of %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の途中までのダウンロードを破棄"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃 %@ 已下载的部分"
          }
        }
      }
