    "Best for Chinese with English terms in it. Listens for the file names and branches on screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten für Chinesisch mit englischen Fachbegriffen. Achtet auch auf die Datei- und Branch-Namen auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mejor para chino con términos en inglés. También se fija en los nombres de archivos y ramas que hay en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur pour du chinois mêlé de termes anglais. Tient aussi compte des noms de fichiers et de branches à l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国語に英語の用語が混ざる話し方に最適。画面に出ているファイル名やブランチ名も手がかりにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영어 용어가 섞인 중국어에 가장 정확합니다. 화면에 보이는 파일 이름과 브랜치 이름도 참고합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O melhor para chinês com termos em inglês. Também presta atenção nos nomes de arquivos e branches na tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中英混着说最准，还会留意屏幕上的文件名和分支名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中英混著說最準，還會留意螢幕上的檔名和分支名稱。"
          }
        }
      }
    },
