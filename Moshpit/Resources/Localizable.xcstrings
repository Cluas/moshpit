    "Runs the command %@'s config registers for its hooks, in this tmux pane, and reads the pane back. The agent itself isn't started.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt in diesem tmux-Panel den Befehl aus, den die Konfiguration von %@ für ihre Hooks einträgt, und liest das Panel zurück. Der Agent selbst wird nicht gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta en este panel de tmux el comando que la configuración de %@ registra para sus hooks y lee el panel. El agente en sí no se inicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute dans ce panneau tmux la commande que la configuration de %@ enregistre pour ses hooks, puis relit le panneau. L’agent lui-même n’est pas lancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の設定に登録されたフックのコマンドをこの tmux ペインで実行し、ペインを読み戻します。エージェント自体は起動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 설정에 등록된 훅 명령을 이 tmux 패널에서 실행하고 패널을 읽어 옵니다. 에이전트 자체는 시작하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa neste painel do tmux o comando que a configuração de %@ registra para os hooks e lê o painel de volta. O agente em si não é iniciado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个 tmux 窗格里运行 %@ 配置里登记的状态脚本命令，再读回窗格。不会启动智能体本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個 tmux 窗格裡執行 %@ 設定裡登記的狀態腳本指令，再讀回窗格。不會啟動智能體本身。"
          }
        }
      }
    },
