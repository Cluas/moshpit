          "stringUnit": {
            "state": "translated",
            "value": "接続を編集"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑连接"
          }
        }
      }
    },
    "Edit Shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを編集"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑快捷键"
          }
        }
      }
    },
    "Edits %@ (a timestamped backup is written first).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を編集します（先にタイムスタンプ付きのバックアップを書き出します）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会修改 %@（先写一份带时间戳的备份）。"
          }
        }
      }
    },
    "Edits ~/.claude/settings.json (a timestamped backup is written first).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.claude/settings.json を編集します（先にタイムスタンプ付きのバックアップを書き込みます）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会修改 ~/.claude/settings.json（会先写入带时间戳的备份）。"
          }
        }
      }
    },
    "Enable Voice Input": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力を有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用语音输入"
          }
        }
      }
    },
    "Enter a private key by hand": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵を手入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动输入私钥"
          }
        }
      }
