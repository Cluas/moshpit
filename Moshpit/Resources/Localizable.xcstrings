    "Long-press a theme to duplicate, edit or delete it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Theme gedrückt, um es zu duplizieren, zu bearbeiten oder zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un tema para duplicarlo, editarlo o eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement un thème pour le dupliquer, le modifier ou le supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマを長押しすると、複製・編集・削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마를 길게 눌러 복제, 편집, 삭제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um tema para duplicar, editar ou apagar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主题可以复制、编辑或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按主題可以複製、編輯或刪除。"
          }
        }
      }
    },
    "Long-press an accent to edit or delete it.": {
