    "1.1s cadence, follows the iOS system default": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.1 秒周期、iOS のシステムデフォルトに準拠"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.1s 节奏，遵循 iOS 系统默认"
