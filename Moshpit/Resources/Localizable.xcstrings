    "Chip Label is capped at 6 characters; Description appears in the edit list to keep shortcuts recognizable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beschriftung ist auf 6 Zeichen begrenzt. Die Beschreibung erscheint nur in der Bearbeitungsliste, damit du den Kurzbefehl wiedererkennst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta tiene un máximo de 6 caracteres; la descripción aparece en la lista de edición para que reconozcas el atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étiquette est limitée à 6 caractères ; la description apparaît dans la liste d’édition pour que le raccourci reste reconnaissable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップラベルは最大 6 文字。説明は編集リストに表示され、見分けやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칩 레이블은 6자까지입니다. 설명은 편집 목록에만 표시되어 단축키를 알아보기 쉽게 해 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rótulo tem no máximo 6 caracteres; a descrição aparece na lista de edição para você reconhecer o atalho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签最多 6 个字符。描述只在编辑列表里显示，方便你认出它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤最多 6 個字元。說明只在編輯列表裡顯示，方便你認出它。"
          }
        }
      }
    },
