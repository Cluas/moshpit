          }
        }
      }
    },
    "This key was made in another device's Secure Enclave and can't be moved. Delete it and make a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel wurde in der Secure Enclave eines anderen Geräts erstellt und kann nicht übertragen werden. Lösche ihn und erstelle einen neuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave se creó en el Secure Enclave de otro dispositivo y no se puede trasladar. Elimínala y crea una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé a été créée dans la Secure Enclave d'un autre appareil et ne peut pas être déplacée. Supprimez-la et créez-en une nouvelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは別のデバイスの Secure Enclave で作られたため、移せません。削除して新しいキーを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 다른 기기의 Secure Enclave에서 만들어져 옮길 수 없습니다. 삭제하고 새로 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave foi criada no Secure Enclave de outro dispositivo e não pode ser transferida. Apague-a e crie uma nova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把密钥生成在另一台设备的安全芯片里，带不过来。删掉它，再新建一把。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把金鑰產生在另一台裝置的安全晶片裡，帶不過來。刪掉它，再新增一把。"
          }
        }
      }
    },
    "This page couldn't open.": {
