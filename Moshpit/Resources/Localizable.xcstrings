            "state": "translated",
            "value": "Ya hay algo con ese nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément porte déjà ce nom."
          }
        },
        "ja": {
          "stringUnit": {
