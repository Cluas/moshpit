    "Display what the agent is running, asking, or was asked — off keeps it private": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, was der Agent ausführt, fragt oder gefragt wurde. Ausgeschaltet bleibt das privat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra qué ejecuta el agente, qué pregunta o qué prompt acaba de responder. Desactivado, se mantiene en privado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ce que l’agent exécute, demande ou vient de traiter. Désactivé, cela reste privé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが実行中の内容、問いかけ、完了したプロンプトを表示します——オフにすると非表示のままです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 실행 중인 것, 묻는 것, 처리한 프롬프트를 표시합니다. 끄면 내용을 숨깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o que o agente está executando, perguntando ou acabou de responder. Desativado, isso fica privado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示智能体在跑什么、在问什么、刚做完哪条提示词。关掉就不显示这些内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 agent 在跑什麼、在問什麼、剛做完哪條提示詞。關掉就不顯示這些內容"
          }
        }
      }
    },
