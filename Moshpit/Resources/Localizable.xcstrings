    "Queued for %@ — delivers when the session is next live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ vorgemerkt. Wird zugestellt, sobald die Sitzung wieder online ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola para %@. Se entregará cuando la sesión vuelva a estar activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente pour %@. Sera transmis dès que la session sera de nouveau active."
          }
