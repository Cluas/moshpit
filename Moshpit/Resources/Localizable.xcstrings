    "Optional. Sent to the agent once it's running — leave blank to type it yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Wird an den Agent geschickt, sobald er läuft. Leer lassen, um es selbst zu tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Se envía al agente cuando arranca; déjalo en blanco para escribirlo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Envoyé à l’agent une fois lancé ; laissez vide pour le saisir vous-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。エージェントの起動後に送信されます——空欄にすると自分で入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 에이전트가 실행되면 전달됩니다. 비워 두면 직접 입력할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Enviado ao agente assim que ele estiver rodando; deixe em branco para digitar você mesmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。智能体启动后会发给它——留空则你自己手输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。智能體啟動後會傳給它，留空就自己手動輸入。"
          }
        }
      }
    },
