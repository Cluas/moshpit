    "Generate SSH Key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH キーを生成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 SSH 密钥"
          }
        }
      }
    },
    "Generates the key pair on device. The private key can optionally be held in the Secure Enclave — used only for signing, never leaving the chip.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上で鍵ペアを生成します。秘密鍵は Secure Enclave に保管でき、署名時のみ使用され、チップの外には出ません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地生成密钥对。私钥可选 Secure Enclave 托管，仅签名时调用，不出芯片。"
          }
        }
      }
    },
    "Good balance of accuracy and speed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精度と速度のバランスが良い。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确度与速度较均衡。"
          }
        }
      }
    },
    "HARDWARE KEY": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェアキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件密钥"
          }
