        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 에이전트의 서버에 올리고 파일 경로를 에이전트에 넘깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia as imagens ao servidor do agente e passa os caminhos dos arquivos para ele."
          }
