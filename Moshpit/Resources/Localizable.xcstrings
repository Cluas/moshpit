            "value": "在主机上安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主機上安裝"
          }
        }
      }
    },
    "Install the hooks for %@ to test them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere zuerst die Hooks für %@, um sie zu testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala los hooks de %@ para probarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez les hooks de %@ pour les tester."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストするには、先に %@ のフックをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트하려면 먼저 %@ 훅을 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
