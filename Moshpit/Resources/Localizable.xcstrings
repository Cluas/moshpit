    "Picking your language keeps the foreign words you say mid-sentence intact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deiner Sprache bleiben fremde Wörter mitten im Satz erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir tu idioma, las palabras extranjeras en medio de la frase se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir ta langue garde intacts les mots étrangers au milieu d’une phrase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を指定すると、文の途中に入る外国語もそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어를 지정하면 문장 중간에 섞인 외국어 단어도 그대로 남습니다."
          }
        },
        "pt-BR": {
