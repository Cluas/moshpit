    "Speak — the text lands here first. Insert types it; Send types it and presses Return.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich, der Text erscheint zuerst hier. „Einfügen“ tippt ihn ein, „Senden“ tippt ihn ein und drückt Return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla: el texto aparece aquí primero. Insertar lo escribe; Enviar lo escribe y pulsa Retorno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez : le texte apparaît d’abord ici. Insérer le saisit ; Envoyer le saisit puis appuie sur Retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話してください——テキストはまずここに表示されます。「挿入」は入力のみ、「送信」は入力して Return を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하면 텍스트가 먼저 여기에 표시됩니다. 삽입은 입력만 하고, 보내기는 입력한 뒤 Return까지 누릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale: o texto aparece aqui primeiro. Inserir digita; Enviar digita e pressiona Return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话吧——文字先落在这里。「插入」只输入，「发送」输入并按回车。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說吧，文字會先出現在這裡。「插入」只輸入，「傳送」輸入後再按 Return。"
          }
        }
      }
    },
    "Speech recognition is off. Enable it in Settings → Privacy → Speech Recognition.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist aus. Aktiviere sie unter „Einstellungen“ → „Datenschutz“ → „Spracherkennung“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado. Actívalo en Ajustes → Privacidad → Reconocimiento de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée. Activez-la dans Réglages → Confidentialité → Reconnaissance vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識がオフです。「設定 → プライバシー → 音声認識」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식이 꺼져 있습니다. 설정 → 개인정보 보호 → 음성 인식에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado. Ative em Ajustes → Privacidade → Reconhecimento de Fala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别权限已关闭。请在「设置 → 隐私 → 语音识别」中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識權限已關閉。請在「設定 → 隱私權 → 語音辨識」開啟。"
          }
        }
      }
    },
