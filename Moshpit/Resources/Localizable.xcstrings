    "Edits ~/.claude/settings.json (a timestamped backup is written first).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.claude/settings.json を編集します（先にタイムスタンプ付きのバックアップを書き込みます）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
