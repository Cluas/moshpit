    "Creates a git worktree on the host, then starts the agent inside it. Your working tree is untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt auf dem Host einen git worktree an und startet den Agent darin. Dein Arbeitsverzeichnis bleibt unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un git worktree en el host y arranca el agente dentro. Tu árbol de trabajo no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un git worktree sur l’hôte, puis y démarre l’agent. Votre arborescence de travail n’est pas touchée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト上に git ワークツリーを作成し、その中でエージェントを起動します。あなたの作業ツリーはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 git worktree를 만들고 그 안에서 에이전트를 시작합니다. 지금 작업 중인 트리는 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um git worktree no host e inicia o agente dentro dele. Sua árvore de trabalho não é alterada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主机上新开一个 git worktree，让智能体在里面干活。你现在的工作树不会被动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主機上新開一個 git worktree，讓 agent 在裡面工作。你現在的工作樹不會被動到。"
          }
        }
      }
    },
