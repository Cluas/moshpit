    "Setup runs on the host over a live session. Connect first, then set it up here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung läuft über eine aktive Sitzung auf dem Host. Verbinde dich zuerst und richte ihn dann hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración se hace en el host a través de una sesión activa. Conéctate primero y luego configúralo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration se fait sur l’hôte, par une session active. Connectez-vous d’abord, puis configurez-le ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は接続中のセッションを通してホスト上で行います。先に接続してから、ここで設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정은 연결된 세션을 통해 호스트에서 진행됩니다. 먼저 연결한 다음 여기에서 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração é feita no host por uma sessão ativa. Conecte-se primeiro e depois configure-o aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置要通过连着的会话在主机上进行。先连上，再回来配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定要透過連線中的工作階段在主機上進行。先連上，再回來設定。"
          }
        }
      }
    },
