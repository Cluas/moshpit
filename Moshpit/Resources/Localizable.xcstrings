    "1.1s cadence, follows the iOS system default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 1,1 s, wie der iOS-Systemstandard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 1,1 s, igual que el valor por omisión de iOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 1,1 s, comme le réglage par défaut d’iOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.1 秒周期、iOS のシステムデフォルトに準拠"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1.1초 간격, iOS 시스템 기본값과 동일"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 1,1 s, igual ao padrão do iOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 1.1 秒一闪，和 iOS 系统默认一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 1.1 秒閃一次，和 iOS 系統預設一致"
          }
        }
      }
    },
