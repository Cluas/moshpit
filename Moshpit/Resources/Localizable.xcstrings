    "FIRST MESSAGE": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のメッセージ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首条消息"
          }
        }
      }
    },
    "Face ID confirmation before every signature": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名のたびに Face ID で確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次签名前需 Face ID 确认"
          }
        }
      }
    },
    "Fast and light. Noticeably weaker outside English.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速・軽量。英語以外は精度が明らかに落ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快且占用小。英语以外明显较弱。"
          }
        }
      }
    },
    "Fastest, lowest accuracy. For older devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最速・最低精度。古い端末向け。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最快，准确度最低。适合较旧的设备。"
          }
        }
      }
    },
    "First connection to %@:%@. Verify this fingerprint matches the server before you trust it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ への初回接続です。信頼する前に、このフィンガープリントがサーバーと一致することを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接 %@:%@。信任之前请先核对这个指纹与服务器一致。"
          }
        }
      }
    },
    "First connection to %@:%lld.\n\nKey fingerprint:\n%@\n\nVerify it matches the server (e.g. `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld への初回接続です。\n\nキーのフィンガープリント：\n%3$@\n\nサーバー側と一致するか確認してください（例: `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接 %1$@:%2$lld。\n\n密钥指纹：\n%3$@\n\n请核对其与服务器一致（如 `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`）。"
          }
        }
      }
    },
    "Font": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォント"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体"
          }
        }
