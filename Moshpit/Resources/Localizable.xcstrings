    "Images upload to the host's ~/.moshpit/uploads; each connect clears expired ones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder landen auf dem Host in ~/.moshpit/uploads; jede Verbindung löscht abgelaufene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes se suben a ~/.moshpit/uploads en el host; cada conexión borra las caducadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images sont envoyées dans ~/.moshpit/uploads sur l’hôte ; chaque connexion efface celles qui ont expiré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像はホストの ~/.moshpit/uploads にアップロードされ、接続のたびに期限切れのものを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 호스트의 ~/.moshpit/uploads에 올라가고, 연결할 때마다 만료된 것을 지웁니다."
          }
        },
