        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动可滚动终端历史"
          }
        }
      }
    },
    "Drag ≡ to reorder; the red − removes it from the toolbar. 12 items max.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "≡ をドラッグして並べ替え、赤い − でツールバーから外します。最大 12 項目。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动 ≡ 排序，红色 − 移出工具条。最多 12 项。"
