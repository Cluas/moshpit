    "Install mosh with your platform's package manager (or build from source), then re-check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere mosh mit dem Paketmanager deiner Plattform (oder baue es aus dem Quellcode) und prüfe dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala mosh con el gestor de paquetes de tu plataforma (o compílalo desde el código fuente) y vuelve a comprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez mosh avec le gestionnaire de paquets de votre plateforme (ou compilez-le depuis les sources), puis revérifiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのプラットフォームのパッケージマネージャで mosh をインストール（またはソースからビルド）してから、再チェックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랫폼의 패키지 관리자로 mosh를 설치하거나 소스에서 빌드한 뒤 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale mosh com o gerenciador de pacotes da sua plataforma (ou compile do código-fonte) e verifique de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你平台的包管理器装上 mosh（或者从源码编译），再重新检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你平台的套件管理器裝好 mosh（或者從原始碼編譯），再重新偵測。"
          }
        }
      }
    },
