    "mosh binds one UDP port in this range per session. Open it outbound from your iPhone and inbound on the server (default 60000–61000).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh はセッションごとにこの範囲の UDP ポートを 1 つバインドします。iPhone 側は送信方向、サーバー側は受信方向で開放してください（デフォルト 60000–61000）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 每个会话会在此范围内绑定一个 UDP 端口。请在 iPhone 出方向和服务器入方向开放（默认 60000–61000）。"
          }
        }
      }
    },
    "mosh isn't installed on this host.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストに mosh がインストールされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台主机上没装 mosh。"
          }
        }
      }
    },
    "mosh keeps the line up · sessions survive the handoff": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh が接続を維持 · セッションはハンドオフを乗り切ります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mosh 保持链路 · 会话扛得住网络切换"
          }
        }
      }
    },
    "mosh-server not found — connected over SSH instead.": {
      "localizations": {
