    "Generates the key pair on device. The private key can optionally be held in the Secure Enclave — used only for signing, never leaving the chip.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt das Schlüsselpaar auf dem Gerät. Der private Schlüssel kann optional in der Secure Enclave liegen. Dort wird er nur zum Signieren benutzt und verlässt den Chip nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera el par de claves en el dispositivo. La clave privada puede guardarse en el Secure Enclave, donde solo se usa para firmar y nunca sale del chip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère la paire de clés sur l’appareil. La clé privée peut être confiée à la Secure Enclave, où elle ne sert qu’à signer et ne quitte jamais la puce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上で鍵ペアを生成します。秘密鍵は Secure Enclave に保管でき、署名時のみ使用され、チップの外には出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 키 쌍을 생성합니다. 개인 키는 Secure Enclave에 보관할 수도 있으며, 이 경우 서명에만 쓰이고 칩을 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera o par de chaves no aparelho. A chave privada pode, opcionalmente, ficar no Secure Enclave, onde só é usada para assinar e nunca sai do chip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地生成密钥对。私钥可选 Secure Enclave 托管，仅签名时调用，不出芯片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上產生金鑰對。私密金鑰可以選擇交給安全隔離區保管，只在簽章時使用，不會離開晶片。"
          }
        }
      }
    },
    "Goes to support@cluas.eu.org through your own Mail app. Nothing is sent until you tap Send there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht über deine eigene Mail-App an support@cluas.eu.org. Gesendet wird erst, wenn du dort auf „Senden“ tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a support@cluas.eu.org a través de tu propia app Mail. No se envía nada hasta que toques Enviar allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part vers support@cluas.eu.org via votre propre app Mail. Rien n’est envoyé avant que vous touchiez Envoyer là-bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのメールアプリから support@cluas.eu.org に送ります。メールで送信するまで、何も送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 Mail 앱을 통해 support@cluas.eu.org로 보냅니다. 거기서 보내기를 탭하기 전까지는 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai para support@cluas.eu.org pelo seu próprio app Mail. Nada é enviado até você tocar em Enviar lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你自己的邮件 app 发到 support@cluas.eu.org。在邮件里点发送之前，什么都不会发出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過你自己的郵件 App 寄到 support@cluas.eu.org。在郵件裡按下傳送之前，什麼都不會送出。"
          }
        }
      }
    },
    "Good balance of accuracy and speed.": {
      "localizations": {
        "de": {
