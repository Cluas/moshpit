    "Stop was passed to the host. It takes effect if the agent is still running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Stoppen“ wurde an den Host übergeben. Es wirkt, wenn der Agent noch läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La orden de detener se pasó al host. Surtirá efecto si el agente sigue en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre d’arrêt a été transmis à l’hôte. Il prendra effet si l’agent est toujours en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止をホストに渡しました。エージェントがまだ実行中であれば反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지 요청을 호스트에 전달했습니다. 에이전트가 아직 실행 중이라면 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de parar foi passado ao host. Ele vale se o agente ainda estiver rodando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止指令已交给主机。若智能体仍在运行，指令就会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止指令已交給主機。如果 agent 還在執行，指令就會生效。"
          }
        }
      }
    },
