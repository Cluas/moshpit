    "Still not detected. Run the command, wait for it to finish, then re-check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer noch nicht gefunden. Führe den Befehl aus, warte, bis er fertig ist, und prüfe dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue sin detectarse. Ejecuta el comando, espera a que termine y vuelve a comprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours pas détecté. Lancez la commande, attendez qu’elle se termine, puis revérifiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ検出されません。コマンドを実行し、完了を待ってから再チェックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 감지되지 않습니다. 명령을 실행하고 끝날 때까지 기다린 뒤 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não detectado. Rode o comando, espere terminar e verifique de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还是没检测到。运行命令，等它跑完，再重新检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還是沒偵測到。執行指令，等它跑完，再重新偵測。"
          }
        }
      }
    },
