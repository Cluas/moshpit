    "iOS has Live Activities off for Moshpit, so the Dynamic Island stays empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS sind Live-Aktivitäten für Moshpit aus, daher bleibt die Dynamic Island leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tiene desactivadas las Actividades en Vivo de Moshpit, así que la Dynamic Island queda vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Activités en direct de Moshpit sont désactivées dans iOS : la Dynamic Island reste vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS で Moshpit のライブアクティビティがオフになっているため、Dynamic Island に何も表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 Moshpit 실시간 현황이 꺼져 있어 Dynamic Island에 아무것도 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS está com as Atividades ao Vivo do Moshpit desativadas, então a Dynamic Island fica vazia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 关掉了 Moshpit 的实时活动，灵动岛上什么也不会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 關掉了 Moshpit 的即時動態，動態島上什麼也不會顯示。"
          }
        }
      }
    },
    "iOS has notifications and Live Activities off for Moshpit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS sind Mitteilungen und Live-Aktivitäten für Moshpit aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tiene desactivadas las notificaciones y las Actividades en Vivo de Moshpit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications et les Activités en direct de Moshpit sont désactivées dans iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS で Moshpit の通知とライブアクティビティがオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 Moshpit의 알림과 실시간 현황이 꺼져 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS está com as notificações e as Atividades ao Vivo do Moshpit desativadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 关掉了 Moshpit 的通知和实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 關掉了 Moshpit 的通知和即時動態。"
          }
        }
      }
    },
    "iOS has notifications off for Moshpit, so no alert reaches you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS sind Mitteilungen für Moshpit aus, daher erreicht dich keine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tiene desactivadas las notificaciones de Moshpit, así que no te llega ningún aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de Moshpit sont désactivées dans iOS : aucune alerte ne vous parvient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS で Moshpit の通知がオフになっているため、お知らせが届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 Moshpit 알림이 꺼져 있어 알림을 받을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS está com as notificações do Moshpit desativadas, então nenhum alerta chega até você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 关掉了 Moshpit 的通知，什么提醒都收不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 關掉了 Moshpit 的通知，什麼提醒都收不到。"
          }
        }
      }
    },
    "iOS hasn't issued a push token to this phone yet — check that notifications are allowed, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat diesem iPhone noch kein Push-Token ausgestellt. Prüfe, ob Mitteilungen erlaubt sind, und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS aún no ha emitido un token push para este teléfono. Comprueba que las notificaciones estén permitidas y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas encore délivré de jeton push à cet iPhone. Vérifiez que les notifications sont autorisées, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がまだこの iPhone にプッシュトークンを発行していません。通知が許可されているか確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 아직 이 휴대폰에 푸시 토큰을 발급하지 않았습니다. 알림이 허용되어 있는지 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS ainda não emitiu um token de push para este celular. Confira se as notificações estão permitidas e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 还没给这台手机发推送令牌。确认已允许通知，再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 還沒發推播權杖給這部手機。確認已允許通知，再試一次。"
          }
        }
      }
    },
