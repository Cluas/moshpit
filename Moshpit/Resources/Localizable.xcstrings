    "Add Connection": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加连接"
          }
        }
      }
    },
    "Add Key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加密钥"
          }
        }
      }
    },
    "Add Shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加快捷键"
          }
        }
      }
    },
    "Agent needs your input — %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが入力を待っています — %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 需要你的输入 — %@"
          }
        }
      }
    },
    "Alert when the agent rings the bell": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがベルを鳴らしたら通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体响铃时提醒"
          }
        }
      }
    },
    "Alerts are generated on-device from the live session — there’s no cloud push server. They fire while Moshpit is in the foreground or recently backgrounded; a fully suspended app won’t poll. iOS will ask for notification permission the first time you connect with Notifications on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はライブセッションからデバイス上で生成されます——クラウドのプッシュサーバーはありません。Moshpit がフォアグラウンドまたは直近バックグラウンドの間に発火し、完全にサスペンドされたアプリはポーリングしません。通知をオンにして初めて接続する際、iOS が通知の許可を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒由设备端的实时会话生成——没有云端推送服务器。它们在 Moshpit 处于前台或刚进入后台时触发；完全挂起的应用不会轮询。首次在开启通知的情况下连接时，iOS 会请求通知权限。"
          }
        }
      }
    },
    "Algorithm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルゴリズム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "算法"
          }
        }
      }
    },
    "Append Return": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Return を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追加 Return"
          }
        }
      }
    },
    "Applies to all sessions": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのセッションに適用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状对所有会话生效"
          }
        }
      }
    },
    "Arrow keys": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键"
          }
        }
      }
    },
    "Attaching session…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションに接続中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加会话中…"
          }
        }
      }
    },
    "Attaching tmux…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux にアタッチ中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在附加 tmux…"
          }
        }
      }
    },
    "Authentication failed — the server rejected your username and password / key. Double-check your credentials.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました — ユーザー名とパスワード / 鍵がサーバーに拒否されました。認証情報を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证失败——服务器拒绝了你的用户名和密码 / 密钥。请检查凭证是否正确。"
          }
        }
      }
    },
    "Automatically appends ⏎ to submit": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信時に自動で ⏎ を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下后自动追加 ⏎ 提交"
          }
        }
      }
    },
    "Available everywhere when nothing is selected. When bound, it appears only in the toolbar of the selected hosts, saving slots in the 12-slot budget.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未選択ならどこでも使えます。バインドすると選択ホストのツールバーにのみ表示され、12 スロットの枠を節約できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不选时全局可用。绑定后仅在所选主机的会话工具条出现，节省 12 个槽位预算。"
          }
        }
      }
    },
    "BEHAVIOR": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作"
          }
