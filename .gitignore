.DS_Store
build/
*.xcuserdata
secret.md
.salvage/
.playwright-mcp/
cookies.json

# Claude Code agent scaffolding (personal paths, vendored third-party skill docs)
.claude/

# Local test credentials (never commit)
.passwd

# Screenshot/IPA scratch space — smoke-localhost.sh and verify-e2e-mosh-tmux.sh
# recreate design-audit/{smoke,e2e} on each run; none of it belongs in the repo.
design-audit/

# Xcode per-user state (generated, never shared)
xcuserdata/
*.xcuserdatad/

# xcodebuild -exportArchive without -exportPath drops the .ipa, its logs and
# the signing summary into a directory named "<scheme> <date> <time>" at
# whatever the working directory was. Anchored and dated so it only catches
# those, not a real directory that happens to start with the app's name.
# Unquoted: .gitignore has no quoting, and a space in a pattern is just a space.
/Moshpit 20*/

# xcodegen writes every target's Info.plist and .entitlements from the `info:`
# and `entitlements:` blocks in project.yml on each `xcodegen generate`. They
# are build outputs, not sources: edit project.yml.
/Moshpit/App/Info.plist
/Moshpit/App/Moshpit.entitlements
/Extensions/MoshpitIsland/Info.plist
/Extensions/MoshpitIsland/MoshpitIsland.entitlements
/Extensions/MoshpitPush/Info.plist
/Extensions/MoshpitPush/MoshpitPush.entitlements
/Extensions/MoshpitShare/Info.plist
/Extensions/MoshpitShare/MoshpitShare.entitlements

# Products of running `swift build` inside a local package.
/Packages/*/.build/
/Packages/*/.swiftpm/

# The Xcode project is a GENERATED artifact — project.yml is the source of
# truth and CI regenerates it from scratch (`xcodegen generate`). Only the
# SwiftPM lockfile inside it is real state worth versioning: it pins the
# TRANSITIVE dependency graph that project.yml's from:-ranges cannot.
# (gitignore can't re-include inside an ignored directory, hence the
# parent-by-parent dance.)
/Moshpit.xcodeproj/*
!/Moshpit.xcodeproj/project.xcworkspace
/Moshpit.xcodeproj/project.xcworkspace/*
!/Moshpit.xcodeproj/project.xcworkspace/xcshareddata
/Moshpit.xcodeproj/project.xcworkspace/xcshareddata/*
!/Moshpit.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
/Moshpit.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Moshpit.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# App Store Connect screenshot uploads — 30MB of regenerable renders
# (scripts produce them, ASC is their home; the repo is not).
/marketing/shots-appstore/

# tmux -CC lab runtime recordings (lab.py writes a dir per run)
/scripts/spikes/tmux-cc-lab/runs/

# APNs signing keys. One .p8 authorises pushes to EVERY device that ever paired
# with this app, cannot be re-downloaded from Apple, and has no expiry to save
# you — so it must never reach a commit, let alone a public mirror. Keep it in
# a secret store and hand it to the relay through MOSHPIT_APNS_KEY_FILE
# (docs/PUSH.md). Same for the certificate-era material, in case anyone reaches
# for the old scheme.
AuthKey_*.p8
*.p8
*.p12

# App-icon drafts: the renders are regenerated by render.mjs / layers.mjs / ictool
marketing/redesign/icon-drafts/out/
marketing/redesign/icon-drafts/glass/out/
marketing/redesign/icon-drafts/glass/layers/

# python bytecode from scripts/*.py importing each other
__pycache__/
