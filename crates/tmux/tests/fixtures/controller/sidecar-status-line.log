@2 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
> list-clients -F '#{client_name}'
> list-sessions -F '#{session_id} owned=#{@moshpit_owned} hidden=#{@moshpit_status_hidden}'
@3 recv %begin 100 0 0\n%end 100 0 0\n\n
@4 rule ok list-sessions => $1 2 work
@5 rule ok list-windows => 
@6 rule ok list-panes -a -F '#{pane_id}| => -
@7 rule ok list-panes -a -F '#{pane_id}\s => 
@8 rule ok list-clients -F '#{client_control_mode} => 1|45613|$1|/dev/ttys030
@9 rule ok new-session => $5
@10 settle
@11 recv %session-changed $1 work\n
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@12 settle
@13 new-session mine
> new-session -d -P -F '#{session_id}' -s "mine"
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
@14 settle
> set-option -t '$5' @moshpit_owned 1
> set-option -t '$5' status off
> set-option -t '$5' -F @moshpit_status_hidden '#{client_name}'
> list-clients -F '#{client_control_mode}|#{client_pid}|#{session_id}|#{client_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
> switch-client -t $5
@15 recv %session-changed $5 mine\n
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@16 settle
@17 select-session $1
> set-option -t '$5' -u status
> set-option -t '$5' -u @moshpit_status_hidden
> list-clients -F '#{client_control_mode}|#{client_pid}|#{session_id}|#{client_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@18 settle
> switch-client -t $1
@19 recv %session-changed $1 work\n
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@20 settle
@21 new-session \s
> new-session -d -P -F '#{session_id}' -s "\\s"
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
@22 settle
> set-option -t '$5' @moshpit_owned 1
> set-option -t '$5' status off
> set-option -t '$5' -F @moshpit_status_hidden '#{client_name}'
> list-clients -F '#{client_control_mode}|#{client_pid}|#{session_id}|#{client_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
> switch-client -t $5
@23 dump
= attached=1 ever=1 session=$5 window=- pane=- fwd=1 swiped=0
= s $1 att=1 name=work
= follow=- notice=- refreshing=0 resized= mouse=0 alt=0 client=- hooks-loaded=0 painted=0 renderer=- renderer-session=- owned=$5
@24 restore-status
> set-option -t '$5' -u status
> set-option -t '$5' -u @moshpit_status_hidden
> display-message -p ok
@25 settle
. note flushed 1
