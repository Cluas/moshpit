@2 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
> list-clients -F '#{client_name}'
> list-sessions -F '#{session_id} owned=#{@moshpit_owned} hidden=#{@moshpit_status_hidden}'
@3 recv %begin 100 0 0\n%end 100 0 0\n\n
@4 rule ok list-sessions => $1 2 work
@5 rule ok list-windows => 
@6 rule ok list-panes -a -F '#{pane_id}| => -
@7 rule ok list-panes -a -F '#{pane_id}\s => 
@8 rule ok list-clients -F '#{client_control_mode} => 1|45613|$1|/dev/ttys030
@9 rule err new-session -t => sessions should be nested with care
@10 rule ok new-session => $5
@11 settle
@12 recv %session-changed $1 work\n
> new-session -t '$1' -s 'work~mp-iPhone-1-1hc' -P -F '#{session_id}'
> set-option -t '=work~mp-iPhone-1-1hc:' destroy-unattached on
> set-option -t '=work~mp-iPhone-1-1hc:' @moshpit_group_of '$1'
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@13 settle
@14 new-session mine
