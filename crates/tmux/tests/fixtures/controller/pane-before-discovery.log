@1 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@2 recv %begin 100 0 0\n%end 100 0 0\n\n
@3 recv %output %5 streaming\n
. note activity %5
. open %5
. pane %5 streaming
@4 select-pane %5
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@5 dump
= attached=1 ever=1 session=- window=- pane=- fwd=1 swiped=0
= p %5 w= idx=0 act=0 80x24 cmd=
= follow=- notice=- refreshing=0 resized= mouse=0 alt=0 client=- hooks-loaded=0 painted=0 renderer=- renderer-session=- owned=
@6 rule ok list-sessions => $0 1 0
@7 rule ok list-windows => $0 @4 5 81x24,0,0,4 1 1 ref\n$0 @5 6 81x24,0,0,5 0 1 islander
@8 rule ok list-panes -a -F '#{pane_id}| => -
@9 rule ok list-panes -a -F '#{pane_id}\s => %4 @4 0 80 24 1 0 0 claude\n%5 @5 0 80 24 1 0 0 claude
@10 settle
. open %4
. view %4 veil
. view %4 extend 2.000
. view %4 release-hold
. view %5 release-hold
. view %5 veil
. view %5 extend 2.000
. view %5 extend 2.000
. pane %4 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[H0 0\x1b[0m\x1b[9999;1H\x0a
. view %4 cover?
. view %4 veil
. view %4 extend 2.000
. pane %5 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[H0 0\x1b[0m\x1b[9999;1H\x0a
. view %5 cover?
. view %5 veil
. view %5 extend 2.000
. pane %4 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H0 0\x1b[0m
. view %4 reveal
. note first-frame
. pane %4 \x1b[1;1H
. pane %5 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H0 0\x1b[0m
. pane %5 \x1b[1;1H
> capture-pane -p -e -S -400 -E -1 -t %4
> list-clients -F '#{client_name}'
> show-options -wqv -t @4 @moshpit_size_owner
> display-message -p -t '@5' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @5 -x 80 -y 24
> select-window -t @5
> capture-pane -p -e -S -400 -E -1 -t %5
> select-pane -Z -t %5
> display-message -p -t '@5' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> display-message -p -t %5 '#{mouse_any_flag} #{alternate_on}'
> capture-pane -p -e -t %4
> display-message -p -t %4 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> display-message -p -t '@4' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @4 -x 80 -y 24
> capture-pane -p -e -t %5
> display-message -p -t %5 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
@11 dump
= attached=1 ever=1 session=$0 window=@5 pane=%5 fwd=1 swiped=0
= s $0 att=1 name=0
= w @4 s=$0 idx=5 act=1 panes=1 zoom=0 name=ref layout=81x24,0,0,4
= w @5 s=$0 idx=6 act=0 panes=1 zoom=0 name=islander layout=81x24,0,0,5
= p %4 w=@4 idx=0 act=1 80x24 cmd=claude
= p %5 w=@5 idx=0 act=1 80x24 cmd=claude
= follow=- notice=- refreshing=0 resized=@4,@5 mouse=0 alt=0 client=- hooks-loaded=0 painted=1 renderer=- renderer-session=- owned=
