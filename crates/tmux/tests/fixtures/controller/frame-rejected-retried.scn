# Generated by harness/controller/scenarios.py.
config label=iPhone quiet=30
init-size 69 60
client-name moshpit-a
attach
recv %begin 100 0 0\n%end 100 0 0\n\n
rule ok display-message -p 'v= => v=3.8
rule ok list-sessions => $0 1 main
rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
rule ok capture-pane -p -e -S => history 1\nhistory 2\n\s\s
rule ok capture-pane -p -e\s\s-t => ALT SCREEN
rule ok capture-pane -p -e -t => $ ls\nREADY\n
rule ok display-message -p -t %0 '#{cursor_x} => 2 1
rule ok display-message -p -t %1 '#{cursor_x} => 0 0
settle
rules-clear
rule ok list-sessions => $0 1 main
rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
rule ok capture-pane -p -e -t => flap-row-0\nflap-row-1\nflap-row-2\nflap-row-3\nflap-row-4\nflap-row-5\nflap-row-6\nflap-row-7\nflap-row-8\nflap-row-9\nflap-row-10\nflap-row-11\nflap-row-12\nflap-row-13\nflap-row-14\nflap-row-15\nflap-row-16\nflap-row-17\nflap-row-18\nflap-row-19\nflap-row-20\nflap-row-21\nflap-row-22\nflap-row-23\nflap-row-24\nflap-row-25\nflap-row-26\nflap-row-27\nflap-row-28\nflap-row-29\nflap-row-30\nflap-row-31\nflap-row-32\nflap-row-33\nflap-row-34\nflap-row-35\nflap-row-36\nflap-row-37\nflap-row-38\nflap-row-39\nflap-row-40\nflap-row-41\nflap-row-42\nflap-row-43\nflap-row-44\nflap-row-45\nflap-row-46\nflap-row-47\nflap-row-48\nflap-row-49\nflap-row-50\nflap-row-51\nflap-row-52\nflap-row-53\nflap-row-54\nflap-row-55\nflap-row-56\nflap-row-57\nflap-row-58\nflap-row-59\nflap-row-60\nflap-row-61\nflap-row-62\nflap-row-63\nflap-row-64\nflap-row-65\nflap-row-66\nflap-row-67\nflap-row-68\nflap-row-69
rule ok display-message => 0 0
recv %layout-change @0 c71d,499x62,0,0,0 c71d,499x62,0,0,0 *\n
recv %layout-change @0 c71d,69x60,0,0,0 c71d,69x60,0,0,0 *\n
settle
wait 350
settle
rules-clear
rule ok list-sessions => $0 1 main
rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
rule ok capture-pane -p -e -t => REPAIRED-AFTER-RETRY
rule ok display-message => 0 0
waitsettle 3000 100
dump
