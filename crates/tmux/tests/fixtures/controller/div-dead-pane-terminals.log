@2 init-size 70 35
@3 client-name moshpit-a
@4 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@5 recv %begin 100 0 0\n%end 100 0 0\n\n
