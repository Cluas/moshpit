@2 init-size 70 35
@3 client-name moshpit-a
@4 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@5 recv %begin 100 0 0\n%end 100 0 0\n\n
@6 rule ok list-sessions => $0 1 main
@7 rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
@8 rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
@9 rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
@10 rule ok capture-pane -p -e -S => history 1\nhistory 2\n\s\s
@11 rule ok capture-pane -p -e\s\s-t => ALT SCREEN
@12 rule ok capture-pane -p -e -t => $ ls\nREADY\n
@13 rule ok display-message -p -t %0 '#{cursor_x} => 2 1
@14 rule ok display-message -p -t %1 '#{cursor_x} => 0 0
@15 rule ok display-message -p -t %0 '#{mouse_any_flag} => 1 0
@16 settle
. open %0
. view %0 veil
. view %0 extend 2.000
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[Hhistory 1\x0d\x0ahistory 2\x1b[0m\x1b[9999;1H\x0a\x0a
. view %0 cover?
. view %0 veil
. view %0 extend 2.000
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. view %0 reveal
. note first-frame
. pane %0 \x1b[2;3H
> capture-pane -p -e -S -400 -E -1 -t %0
> list-clients -F '#{client_name}'
> show-options -wqv -t @0 @moshpit_size_owner
> capture-pane -p -e -t %0
> display-message -p -t %0 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> set-option -w -t @0 @moshpit_size_owner "moshpit-a|iPhone|0"
> display-message -p -t '@0' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @0 -x 70 -y 35
@17 mouse
> display-message -p -t %0 '#{mouse_any_flag} #{alternate_on}'
@18 settle
@19 scroll 3
. view %0 release-hold
> set-option -w -t @0 @moshpit_size_owner "moshpit-a|iPhone|1758000000"
> send-keys -t %0 -H 1b 5b 3c 36 34 3b 33 35 3b 31 37 4d 1b 5b 3c 36 34 3b 33 35 3b 31 37 4d 1b 5b 3c 36 34 3b 33 35 3b 31 37 4d
@20 scroll -9
. view %0 release-hold
> send-keys -t %0 -H 1b 5b 3c 36 35 3b 33 35 3b 31 37 4d 1b 5b 3c 36 35 3b 33 35 3b 31 37 4d 1b 5b 3c 36 35 3b 33 35 3b 31 37 4d 1b 5b 3c 36 35 3b 33 35 3b 31 37 4d 1b 5b 3c 36 35 3b 33 35 3b 31 37 4d 1b 5b 3c 36 35 3b 33 35 3b 31 37 4d
@21 scroll-px 10 16
= px 10.000
@22 scroll-px 10 16
. view %0 release-hold
> send-keys -t %0 -H 1b 5b 3c 36 34 3b 33 35 3b 31 37 4d
= px 10.000
@23 scroll-px 10 16
= px 10.000
@24 scroll-begin
> display-message -p -t %0 '#{mouse_any_flag} #{alternate_on}'
@25 settle
@26 scroll-px 10 16
= px 10.000
@27 click 4 2
. view %0 release-hold
> send-keys -t %0 -H 1b 5b 3c 30 3b 35 3b 33 4d 1b 5b 3c 30 3b 35 3b 33 6d
> display-message -p -t %0 '#{mouse_any_flag} #{alternate_on}'
@28 settle
@29 dump
= attached=1 ever=1 session=$0 window=@0 pane=%0 fwd=1 swiped=0
= s $0 att=1 name=main
= w @0 s=$0 idx=0 act=1 panes=1 zoom=0 name=main layout=b25d,80x24,0,0,0
= p %0 w=@0 idx=0 act=1 80x24 cmd=bash
= follow=- notice=- refreshing=0 resized=@0 mouse=1 alt=0 client=moshpit-a hooks-loaded=0 painted=1 renderer=- renderer-session=- owned=
