@2 init-size 47 40
@3 client-name moshpit-a
@4 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@5 recv %begin 100 0 0\n%end 100 0 0\n\n
@6 rule ok list-sessions => $0 1 main
@7 rule ok list-windows => $0 @0 0 3992,47x40,0,0{45x40,0,0,0,1x40,46,0[1x20,46,0,1,1x19,46,21,2]} 1 3 claude
@8 rule ok list-panes -a -F '#{pane_id}| => -
@9 rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 45 40 0 0 0 claude\n%1 @0 1 1 20 1 0 0 claude\n%2 @0 2 1 19 0 0 0 claude
@10 rule ok display-message -p -t '@0' => 4 0 %1 1c2d,47x40,0,0{45x40,0,0[45x20,0,0,0,45x19,0,21,3],1x40,46,0[1x20,46,0,1,1x19,46,21,2]}
@11 settle
. open %0
. open %1
. open %2
. view %1 veil
. view %1 extend 2.000
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[H0 0\x1b[0m\x1b[9999;1H\x0a
. pane %1 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[H0 0\x1b[0m\x1b[9999;1H\x0a
. view %1 cover?
. view %1 veil
. view %1 extend 2.000
. pane %2 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[H0 0\x1b[0m\x1b[9999;1H\x0a
. pane %1 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H0 0\x1b[0m
. view %1 reveal
. note first-frame
. pane %1 \x1b[1;1H
> capture-pane -p -e -S -400 -E -1 -t %0
> capture-pane -p -e -S -400 -E -1 -t %1
> capture-pane -p -e -S -400 -E -1 -t %2
> list-clients -F '#{client_name}'
> show-options -wqv -t @0 @moshpit_size_owner
> capture-pane -p -e -t %1
> display-message -p -t %1 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> set-option -w -t @0 @moshpit_size_owner "moshpit-a|iPhone|0"
> display-message -p -t '@0' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @0 -x 47 -y 40
@12 recv %layout-change @0 3992,47x40,0,0{45x40,0,0,0,1x40,46,0[1x20,46,0,1,1x19,46,21,2]} 3992,47x40,0,0,1 *Z\n
@13 settle
@14 recv %layout-change @0 1c2d,47x40,0,0{45x40,0,0[45x20,0,0,0,45x19,0,21,3],1x40,46,0[1x20,46,0,1,1x19,46,21,2]} 1c2d,47x40,0,0{45x40,0,0[45x20,0,0,0,45x19,0,21,3],1x40,46,0[1x20,46,0,1,1x19,46,21,2]}\n
> display-message -p -t '@0' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
@15 settle
> resize-pane -Z -t @0
