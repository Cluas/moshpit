@20 dump
= attached=1 ever=1 session=$0 window=@0 pane=%1 fwd=1 swiped=0
= s $0 att=1 name=main
= w @0 s=$0 idx=0 act=1 panes=4 zoom=0 name=claude layout=1c2d,47x40,0,0{45x40,0,0[45x20,0,0,0,45x19,0,21,3],1x40,46,0[1x20,46,0,1,1x19,46,21,2]}
