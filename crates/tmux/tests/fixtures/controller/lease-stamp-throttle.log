@2 init-size 70 35
@3 client-name moshpit-a
@4 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@5 recv %begin 100 0 0\n%end 100 0 0\n\n
@6 rule ok list-clients -F '#{client_name}' => moshpit-a
@7 rule ok show-options -wqv => -
@8 rule ok list-sessions => $0 1 main
@9 rule ok list-windows => $0 @0 0 200x50,0,0,0 1 1 main
@10 rule ok list-panes -a -F '#{pane_id}| => -
@11 rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 200 50 1 0 0 bash
@12 rule ok capture-pane => READY
@13 rule ok display-message => 0 0
@14 settle
. open %0
. view %0 veil
. view %0 extend 2.000
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[HREADY\x1b[0m\x1b[9999;1H\x0a
. view %0 cover?
. view %0 veil
. view %0 extend 2.000
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[HREADY\x1b[0m
. pane %0 \x1b[1;1H
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[HREADY\x1b[0m
. view %0 reveal
. note first-frame
. pane %0 \x1b[1;1H
> capture-pane -p -e -S -400 -E -1 -t %0
> capture-pane -p -e -t %0
> display-message -p -t %0 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> list-clients -F '#{client_name}'
> show-options -wqv -t @0 @moshpit_size_owner
> capture-pane -p -e -t %0
> display-message -p -t %0 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> set-option -w -t @0 @moshpit_size_owner "moshpit-a|iPhone|0"
> display-message -p -t '@0' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @0 -x 70 -y 35
@16 input %0 61
. view %0 release-hold
> set-option -w -t @0 @moshpit_size_owner "moshpit-a|iPhone|1758000000"
> send-keys -t %0 -H 61
@17 input %0 62
. view %0 release-hold
> send-keys -t %0 -H 62
@18 wait 100
@19 input %0 63
. view %0 release-hold
> send-keys -t %0 -H 63
@20 wait 300
@21 input %0 64
. view %0 release-hold
> set-option -w -t @0 @moshpit_size_owner "moshpit-a|iPhone|1758000000"
> send-keys -t %0 -H 64
@22 paste %0 x
> set-buffer -b moshpit-paste -- "x"
> paste-buffer -p -b moshpit-paste -d -t %0
@23 dump
= attached=1 ever=1 session=$0 window=@0 pane=%0 fwd=1 swiped=0
= s $0 att=1 name=main
= w @0 s=$0 idx=0 act=1 panes=1 zoom=0 name=main layout=200x50,0,0,0
= p %0 w=@0 idx=0 act=1 200x50 cmd=bash
= follow=- notice=- refreshing=0 resized=@0 mouse=0 alt=0 client=moshpit-a hooks-loaded=0 painted=1 renderer=- renderer-session=- owned=
