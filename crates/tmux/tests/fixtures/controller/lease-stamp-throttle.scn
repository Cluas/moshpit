# Generated by harness/controller/scenarios.py.
config label=iPhone quiet=30
init-size 70 35
client-name moshpit-a
attach
recv %begin 100 0 0\n%end 100 0 0\n\n
rule ok display-message -p 'v= => v=3.8
rule ok list-clients -F '#{client_name}' => moshpit-a
rule ok show-options -wqv => -
rule ok list-sessions => $0 1 main
rule ok list-windows => $0 @0 0 200x50,0,0,0 1 1 main
rule ok list-panes -a -F '#{pane_id}| => -
rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 200 50 1 0 0 bash
rule ok capture-pane => READY
rule ok display-message => 0 0
settle
config stamp=0.3
input %0 61
input %0 62
wait 100
input %0 63
wait 300
input %0 64
paste %0 x
dump
