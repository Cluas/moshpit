@2 init-size 70 35
@3 client-name moshpit-a
@4 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@5 recv %begin 100 0 0\n%end 100 0 0\n\n
@6 rule ok list-sessions => $0 1 main
@7 rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 0 1 main\n$0 @2 1 b25e,80x24,0,0,2 0 1 logs\n$0 @1 2 b25f,80x24,0,0,1 1 1 vim
@8 rule ok list-panes -a -F '#{pane_id}| => -
@9 rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash\n%2 @2 0 80 24 1 0 0 tail\n%1 @1 0 80 24 1 0 0 vim
@10 rule ok capture-pane -p -e -S => history 1\nhistory 2\n\s\s
@11 rule ok capture-pane -p -e\s\s-t => ALT SCREEN
@12 rule ok capture-pane -p -e -t => $ ls\nREADY\n
@13 rule ok display-message -p -t %0 '#{cursor_x} => 2 1
@14 rule ok display-message -p -t %1 '#{cursor_x} => 0 0
@15 settle
. open %0
. open %1
. open %2
. view %1 veil
. view %1 extend 2.000
. pane %1 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[Hhistory 1\x0d\x0ahistory 2\x1b[0m\x1b[9999;1H\x0a\x0a
. view %1 cover?
. view %1 veil
. view %1 extend 2.000
. pane %1 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. pane %1 \x1b[1;1H
. pane %1 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. view %1 reveal
. note first-frame
. pane %1 \x1b[1;1H
> capture-pane -p -e -S -400 -E -1 -t %1
> capture-pane -p -e -t %1
> display-message -p -t %1 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> list-clients -F '#{client_name}'
> show-options -wqv -t @1 @moshpit_size_owner
> capture-pane -p -e -t %1
> display-message -p -t %1 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> set-option -w -t @1 @moshpit_size_owner "moshpit-a|iPhone|0"
> display-message -p -t '@1' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @1 -x 70 -y 35
@16 recv %session-window-changed $0 @2\n%unlinked-window-close @1\n
. close %1
. view %2 veil
. view %2 extend 2.000
> display-message -p -t '@2' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> capture-pane -p -e -t %2
> display-message -p -t %2 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
@17 settle
. pane %2 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. view %2 reveal
. pane %2 \x1b[1;1H
@18 dump
= attached=1 ever=1 session=$0 window=@2 pane=%2 fwd=1 swiped=0
= s $0 att=1 name=main
= w @0 s=$0 idx=0 act=0 panes=1 zoom=0 name=main layout=b25d,80x24,0,0,0
= w @2 s=$0 idx=1 act=0 panes=1 zoom=0 name=logs layout=b25e,80x24,0,0,2
= p %0 w=@0 idx=0 act=1 80x24 cmd=bash
= p %2 w=@2 idx=0 act=1 80x24 cmd=tail
= follow=- notice=- refreshing=0 resized=@1 mouse=0 alt=0 client=moshpit-a hooks-loaded=0 painted=1 renderer=- renderer-session=- owned=
@19 recv %unlinked-window-close @0\n
. close %0
@20 dump
= attached=1 ever=1 session=$0 window=@2 pane=%2 fwd=1 swiped=0
= s $0 att=1 name=main
= w @2 s=$0 idx=1 act=0 panes=1 zoom=0 name=logs layout=b25e,80x24,0,0,2
= p %2 w=@2 idx=0 act=1 80x24 cmd=tail
= follow=- notice=- refreshing=0 resized=@1 mouse=0 alt=0 client=moshpit-a hooks-loaded=0 painted=1 renderer=- renderer-session=- owned=
