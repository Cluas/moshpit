@2 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
> list-clients -F '#{client_name}'
> list-sessions -F '#{session_id} owned=#{@moshpit_owned} hidden=#{@moshpit_status_hidden}'
@3 recv %begin 100 0 0\n%end 100 0 0\n\n
@4 rule ok display-message -p 'v= => v=3.8
@5 rule ok list-sessions => $0 1 aaa
@6 rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 0 1 zsh\n$0 @2 1 b25e,80x24,0,0,2 0 1 htop\n$0 @1 2 b25f,80x24,0,0,1 1 1 vim
@7 rule ok list-panes -a -F '#{pane_id}| => -
@8 rule ok list-panes -a -F '#{pane_id}\s => 
@9 rule ok list-clients -F '#{client_control_mode} => 1|45613|$0|/dev/ttys030
@10 settle
@11 recv %session-changed $0 aaa\n
> display-message -p 'v=#{version}'
> display-message -p 'self=#{client_name}'
> list-clients -F 'cc=#{client_control_mode} #{session_id} #{client_name}'
> show-options -sqv @moshpit_cc
> set-option -t '$0' status off
> set-option -t '$0' -F @moshpit_status_hidden '#{client_name}'
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@12 settle
> set-option -s -a -F @moshpit_cc ' #{client_name}'
> new-session -t '$0' -s 'aaa~mp-iPhone-0-1hc' -P -F '#{session_id}'
> set-option -t '=aaa~mp-iPhone-0-1hc:' @moshpit_group_of '$0'
> select-window -t @1
> display-message -p -t '@1' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout} #{window-size} #{@moshpit_layout}'
@13 dump
= attached=1 ever=1 session=$0 window=@1 pane=- fwd=1 swiped=0
= s $0 att=1 name=aaa
= w @0 s=$0 idx=0 act=0 panes=1 zoom=0 name=zsh layout=b25d,80x24,0,0,0
= w @1 s=$0 idx=2 act=1 panes=1 zoom=0 name=vim layout=b25f,80x24,0,0,1
= w @2 s=$0 idx=1 act=0 panes=1 zoom=0 name=htop layout=b25e,80x24,0,0,2
= follow=- notice=- refreshing=0 resized= mouse=0 alt=0 client=- hooks-loaded=0 painted=0 renderer=- renderer-session=- owned=
@14 rules-clear
@15 rule ok list-sessions => $0 1 aaa
@16 rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 0 1 zsh\n$0 @2 1 b25e,80x24,0,0,2 1 1 htop
@17 rule ok list-panes -a -F '#{pane_id}| => -
@18 rule ok list-panes -a -F '#{pane_id}\s => 
@19 rule ok list-clients -F '#{client_control_mode} => 1|45613|$0|/dev/ttys030
@20 recv %session-window-changed $0 @2\n%unlinked-window-close @1\n
> display-message -p -t '@2' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout} #{window-size} #{@moshpit_layout}'
@21 settle
@22 dump
= attached=1 ever=1 session=$0 window=@2 pane=- fwd=1 swiped=0
= s $0 att=1 name=aaa
= w @0 s=$0 idx=0 act=0 panes=1 zoom=0 name=zsh layout=b25d,80x24,0,0,0
= w @2 s=$0 idx=1 act=0 panes=1 zoom=0 name=htop layout=b25e,80x24,0,0,2
= follow=- notice=- refreshing=0 resized= mouse=0 alt=0 client=- hooks-loaded=0 painted=0 renderer=- renderer-session=- owned=
