@2 init-size 69 60
@3 begin
@4 recv %begin 100 0 0\n%end 100 0 0\n\n%session-changed $0 main\n
> display-message -p 'self=#{client_name}'
> list-clients -F 'cc=#{client_control_mode} #{session_id} #{client_name}'
> show-options -sqv @moshpit_cc
> list-windows -t '$0' -F '#{window_id} #{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> refresh-client -C 69x60
> list-windows -t '$0' -F '#{window_id} #{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> display-message -p '#{client_name}'
> list-clients -F '#{client_name}'
> show-options -wqv @moshpit_size_owner
> list-windows -a -F '#{window_id} #{window_zoomed_flag} #{pane_id} zoom=#{@moshpit_zoomed} lease=#{@moshpit_size_owner}'
> list-sessions -F '#{session_id} #{session_attached} #{@moshpit_group_of}'
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
> list-panes -a -F '#{pane_id}|#{@moshpit_state}|#{@moshpit_agent}|#{@moshpit_since}|#{pane_current_command}|#{@moshpit_title}'
@5 rule ok display-message -p '#{client_name}' => /dev/ttys003
@6 rule ok list-clients -F '#{client_name}' => /dev/ttys003
@7 rule ok show-options -wqv => -
@8 rule ok list-sessions => $0 1 main
@9 rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
@10 rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
@11 rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
@12 rule ok capture-pane -p -e -S => history 1\nhistory 2\n\s\s
@13 rule ok capture-pane -p -e\s\s-t => ALT SCREEN
@14 rule ok capture-pane -p -e -t => $ ls\nREADY\n
@15 rule ok display-message -p -t %0 '#{cursor_x} => 2 1
@16 rule ok display-message -p -t %1 '#{cursor_x} => 0 0
@17 settle
. open %0
. view %0 veil
. view %0 extend 2.000
. note hooks
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[3J\x1b[Hhistory 1\x0d\x0ahistory 2\x1b[0m\x1b[9999;1H\x0a\x0a
. view %0 cover?
. view %0 veil
. view %0 extend 2.000
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. pane %0 \x1b[2;3H
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. view %0 reveal
. note first-frame
. pane %0 \x1b[2;3H
> set-option -s -a -F @moshpit_cc ' #{client_name}'
> new-session -t '$0' -s 'main~mp-iPhone-0-1hc' -P -F '#{session_id}'
> set-option -t '=main~mp-iPhone-0-1hc:' destroy-unattached on
> set-option -t '=main~mp-iPhone-0-1hc:' @moshpit_group_of '$0'
> display-message -p -t '@0' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> capture-pane -p -e -S -400 -E -1 -t %0
> capture-pane -p -e -t %0
> display-message -p -t %0 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
> set-option -w -t @0 @moshpit_size_owner "/dev/ttys003|iPhone|0"
> display-message -p -t '@0' '#{window_panes} #{window_zoomed_flag} #{pane_id} #{window_layout}'
> resize-window -t @0 -x 69 -y 60
> capture-pane -p -e -t %0
> display-message -p -t %0 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
@18 dump
= attached=1 ever=1 session=$0 window=@0 pane=%0 fwd=1 swiped=0
= s $0 att=1 name=main
= w @0 s=$0 idx=0 act=1 panes=1 zoom=0 name=main layout=b25d,80x24,0,0,0
= p %0 w=@0 idx=0 act=1 80x24 cmd=bash
= follow=- notice=- refreshing=0 resized=@0 mouse=0 alt=0 client=/dev/ttys003 hooks-loaded=1 painted=1 renderer=- renderer-session=- owned=
= h %0 state=working agent=claude since=1758000000.000 cmd=claude title=fixing
@19 wait 800
. view %0 extend 2.000
> capture-pane -p -e -t %0
> display-message -p -t %0 '#{cursor_x} #{cursor_y} #{mouse_any_flag} #{alternate_on}'
@20 settle
. pane %0 \x1b[0m\x1b[H\x1b[K\x1b[2;1H\x1b[J\x1b[H$ ls\x0d\x0aREADY\x1b[0m
. view %0 reveal
. pane %0 \x1b[2;3H
@21 poll
> list-panes -a -F '#{pane_id}|#{@moshpit_state}|#{@moshpit_agent}|#{@moshpit_since}|#{pane_current_command}|#{@moshpit_title}'
@22 settle
. note hooks
@23 dump
= attached=1 ever=1 session=$0 window=@0 pane=%0 fwd=1 swiped=0
= s $0 att=1 name=main
= w @0 s=$0 idx=0 act=1 panes=1 zoom=0 name=main layout=b25d,80x24,0,0,0
= p %0 w=@0 idx=0 act=1 80x24 cmd=bash
= follow=- notice=- refreshing=0 resized=@0 mouse=0 alt=0 client=/dev/ttys003 hooks-loaded=1 painted=1 renderer=- renderer-session=- owned=
= h %0 state=working agent=claude since=1758000000.000 cmd=claude title=fixing
