# Generated by harness/controller/scenarios.py.
config label=iPhone quiet=30
init-size 70 35
client-name moshpit-a
attach
recv %begin 100 0 0\n%end 100 0 0\n\n
rule ok list-sessions => $0 1 main
rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
rule ok capture-pane -p -e -S => history 1\nhistory 2\n\s\s
rule ok capture-pane -p -e\s\s-t => ALT SCREEN
rule ok capture-pane -p -e -t => $ ls\nREADY\n
rule ok display-message -p -t %0 '#{cursor_x} => 2 1
rule ok display-message -p -t %1 '#{cursor_x} => 0 0
settle
resize 70 35
wait 200
settle
recv %layout-change @0 200x24,0,0,2\n%layout-change @0 70x35,0,0,2\n%layout-change @0 200x24,0,0,2\n%layout-change @0 70x35,0,0,2\n%layout-change @0 200x24,0,0,2\n
settle
wait 5100
recv %layout-change @0 201x24,0,0,2\n
settle
