@2 prefix
. note prefix 1 C-b
@3 attach
> list-sessions -F '#{session_id} #{session_attached} #{session_name}'
> list-windows -a -F '#{session_id} #{window_id} #{window_index} #{window_layout} #{window_active} #{window_panes} #{window_name}'
> list-panes -a -F '#{pane_id} #{window_id} #{pane_index} #{pane_width} #{pane_height} #{pane_active} #{alternate_on} #{pane_in_mode} #{pane_current_command} #{pane_current_path}'
@4 recv %begin 100 0 0\n%end 100 0 0\n\n
@5 rule ok list-sessions => $0 1 main
@6 rule ok list-windows => $0 @0 0 b25d,80x24,0,0,0 1 1 main
@7 rule ok list-panes -a -F '#{pane_id}| => %0|working|claude|1758000000|claude|fixing
@8 rule ok list-panes -a -F '#{pane_id}\s => %0 @0 0 80 24 1 0 0 bash
@9 prefix
> show-options -gqv prefix
@10 close
. note prefix 2 C-b
. note dead
